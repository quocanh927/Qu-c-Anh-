local function createESPForPlayer(other)
    if other == player then return end
    if not other.Character then return end
    local char = other.Character
    local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    if not head then return end

    local hl = Instance.new("Highlight")
    hl.Name = "GameOverlay"
    hl.FillTransparency = 0.75
    hl.OutlineTransparency = 0.1
    hl.Parent = char

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "NameESP"
    billboard.Size = UDim2.new(0, 120, 0, 24)
    billboard.Adornee = head
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.MaxDistance = 200
    billboard.AlwaysOnTop = true
    billboard.Parent = head

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 1, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = other.Name
    nameLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
    nameLabel.TextScaled = false
    nameLabel.TextSize = 12
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextStrokeTransparency = 0.2
    nameLabel.TextXAlignment = Enum.TextXAlignment.Center
    nameLabel.Parent = billboard

    table.insert(espLabels, billboard)
    table.insert(espLabels, hl)
end

local function clearESP()
    for _, obj in ipairs(espLabels) do
        pcall(function() obj:Destroy() end)
    end
    espLabels = {}
    for _, conn in ipairs(espConnections) do
        pcall(function() conn:Disconnect() end)
    end
    espConnections = {}
    if espPlayerAddedConn then
        espPlayerAddedConn:Disconnect()
        espPlayerAddedConn = nil
    end
    if espPlayerRemovingConn then
        espPlayerRemovingConn:Disconnect()
        espPlayerRemovingConn = nil
    end
end

makeToggle("👁 ESP", function(on)
    espOn = on
    if on then
        for _, other in ipairs(Players:GetPlayers()) do
            createESPForPlayer(other)
        end
        espPlayerAddedConn = Players.PlayerAdded:Connect(function(other)
            createESPForPlayer(other)
            local conn = other.CharacterAdded:Connect(function()
                wait(0.2)
                createESPForPlayer(other)
            end)
            table.insert(espConnections, conn)
        end)
        espPlayerRemovingConn = Players.PlayerRemoving:Connect(function(other)
            for i, obj in ipairs(espLabels) do
                if obj:IsA("BillboardGui") and obj.Adornee and obj.Adornee:FindFirstAncestor(other.Name) then
                    pcall(function() obj:Destroy() end)
                    table.remove(espLabels, i)
                elseif obj:IsA("Highlight") and obj.Parent and obj.Parent.Name == other.Name then
                    pcall(function() obj:Destroy() end)
                    table.remove(espLabels, i)
                end
            end
        end)
        for _, other in ipairs(Players:GetPlayers()) do
            if other ~= player then
                local conn = other.CharacterAdded:Connect(function()
                    wait(0.2)
                    createESPForPlayer(other)
                end)
                table.insert(espConnections, conn)
            end
        end
    else
        clearESP()
    end
end)

-- HITBOX
local function clearHitboxes()
    for _, part in pairs(hitboxParts) do
        if part and part.Parent then
            pcall(function() part:Destroy() end)
        end
    end
    table.clear(hitboxParts)
end

local function createHitbox(character)
    if not hitboxOn then return end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local old = character:FindFirstChild("HitboxDebug")
    if old then old:Destroy() end

    local hitbox = Instance.new("Part")
    hitbox.Name = "HitboxDebug"
    hitbox.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
    hitbox.Transparency = 0.7
    hitbox.CanCollide = false
    hitbox.CanTouch = false
    hitbox.CanQuery = false
    hitbox.Massless = true
    hitbox.Anchored = false
    hitbox.Parent = character

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = root
    weld.Part1 = hitbox
    weld.Parent = hitbox

    table.insert(hitboxParts, hitbox)
end

local function refreshHitboxes()
    clearHitboxes()
    if not hitboxOn then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then
            createHitbox(plr.Character)
        end
    end
end

makeToggle("📦 Hitbox Debug", function(on)
    hitboxOn = on
    refreshHitboxes()
end)

makeSlider("Hitbox Size", 2, 10, 4, function(value)
    hitboxSize = value
    if hitboxOn then
        refreshHitboxes()
    end
end)

Players.PlayerAdded:Connect(function(plr)
