-- ===================== AIMBOT LOGIC (KHÔNG MẤT DI CHUYỂN TRÊN MOBILE) =====================
local FOVring = Drawing.new("Circle")
FOVring.Visible = false
FOVring.Thickness = 2
FOVring.Color = Color3.fromRGB(255, 0, 127)
FOVring.Filled = false
FOVring.Radius = State.Aimbot.FOVSize
FOVring.Position = camera.ViewportSize / 2

local function updateFOVCircle()
    if State.Aimbot.Enabled and State.Aimbot.FOVCircle then
        FOVring.Visible = true
        FOVring.Radius = State.Aimbot.FOVSize
        FOVring.Position = camera.ViewportSize / 2
        fovRainbowAngle = (fovRainbowAngle + 0.5) % 360
        local hue = fovRainbowAngle / 360
        FOVring.Color = Color3.fromHSV(hue, 1, 1)
    else
        FOVring.Visible = false
    end
end

local function findNearestTarget()
    local nearest = nil
    local nearestDist = math.huge
    local center = camera.ViewportSize / 2
    local char = LocalPlayer.Character
    if not char then return nil end

    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= LocalPlayer then
            local otherChar = other.Character
            if otherChar then
                local hum = otherChar:FindFirstChildOfClass("Humanoid")
                local root = otherChar:FindFirstChild("HumanoidRootPart")
                if hum and hum.Health > 0 and root then
                    local screenPos, onScreen = camera:WorldToViewportPoint(root.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                        if dist < State.Aimbot.FOVSize and dist < nearestDist then
                            nearestDist = dist
                            nearest = other
                        end
                    end
                end
            end
        end
    end
    return nearest
end

local function isTargetAlive(targetPlayer)
    if not targetPlayer then return false end
    local char = targetPlayer.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function shoot()
    local char = LocalPlayer.Character
    if char then
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then
            local remote = tool:FindFirstChild("RemoteEvent")
            if remote then
                remote:FireServer()
            else
                VirtualInput:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                task.wait(0.03)
                VirtualInput:SendMouseButtonEvent(0, 0, 0, false, game, 0)
            end
        else
            VirtualInput:SendMouseButtonEvent(0, 0, 0, true, game, 0)
            task.wait(0.03)
            VirtualInput:SendMouseButtonEvent(0, 0, 0, false, game, 0)
        end
    end
end

RunService.Heartbeat:Connect(function()
    updateFOVCircle()
    
    if not State.Aimbot.Enabled then
        aimbotTarget = nil
        return
    end

    if not isTargetAlive(aimbotTarget) then
        aimbotTarget = findNearestTarget()
    end

    if not aimbotTarget then
        aimbotTarget = findNearestTarget()
        return
    end

    if not isTargetAlive(aimbotTarget) then
        aimbotTarget = findNearestTarget()
        return
    end

    local char = aimbotTarget.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local head = char and char:FindFirstChild("Head")
    local aimPart = head or root
    if not aimPart then
        aimbotTarget = findNearestTarget()
        return
    end

    local pos = aimPart.Position
    local velocity = root and root.Velocity or Vector3.new()
    local predictedPos = pos + velocity * State.Aimbot.Prediction

    -- Kiểm tra touch (chỉ xoay camera khi có touch trên mobile)
    local isTouching = false
    if UserInputService.TouchEnabled then
        for _, touch in ipairs(UserInputService:GetTouchInputs()) do
            if touch.UserInputState == Enum.UserInputState.Begin or touch.UserInputState == Enum.UserInputState.Change then
                isTouching = true
                break
            end
        end
    end

    if isTouching or not UserInputService.TouchEnabled then
        local currentCF = camera.CFrame
        local targetDirection = (predictedPos - currentCF.Position).Unit
        local newLookVector = currentCF.LookVector:Lerp(targetDirection, State.Aimbot.Smoothness)
        camera.CFrame = CFrame.new(currentCF.Position, currentCF.Position + newLookVector)
    end

    local screenPos, onScreen = camera:WorldToViewportPoint(predictedPos)
    if onScreen then
        local center = camera.ViewportSize / 2
        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
        if dist < State.Aimbot.FOVSize * 0.3 then
            shoot()
        end
    end
end)

