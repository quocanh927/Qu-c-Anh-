local function addToggle(parent, text, defaultState, activeColor, callback)
    local row = new("Frame", {
        Parent = parent,
        Size = UDim2.new(1, -8, 0, 28),
        BackgroundTransparency = 1,
    })

    local lbl = new("TextLabel", {
        Parent = row, BackgroundTransparency = 1,
        Position = UDim2.new(0, 4, 0, 0), Size = UDim2.new(0.65, 0, 1, 0),
        Font = Enum.Font.GothamMedium, Text = text, TextSize = 11,
        TextColor3 = THEME.Text, TextXAlignment = Enum.TextXAlignment.Left,
    })

    local btn = new("TextButton", {
        Parent = row, AutoButtonColor = false,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -4, 0.5, 0), Size = UDim2.fromOffset(38, 18),
        BackgroundColor3 = defaultState and activeColor or THEME.Off,
        BorderSizePixel = 0, Text = "",
    })
    corner(btn, 9)

    local knob = new("Frame", {
        Parent = btn, Size = UDim2.fromOffset(14, 14),
        Position = defaultState and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255), BorderSizePixel = 0,
    })
    corner(knob, 7)

    local state = defaultState
    btn.MouseButton1Click:Connect(function()
        state = not state
        local p = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
        local c = state and activeColor or THEME.Off
        tween(knob, 0.12, {Position = p})
        tween(btn, 0.12, {BackgroundColor3 = c})
        if callback then callback(state) end
    end)

    return btn
end

local function addSlider(parent, text, minVal, maxVal, defaultVal, callback)
    local row = new("Frame", {
        Parent = parent,
        Size = UDim2.new(1, -8, 0, 36),
        BackgroundTransparency = 1,
    })

    local lbl = new("TextLabel", {
        Parent = row, BackgroundTransparency = 1,
        Position = UDim2.new(0, 4, 0, 0), Size = UDim2.new(0.5, 0, 0, 14),
        Font = Enum.Font.GothamMedium, Text = text, TextSize = 10,
        TextColor3 = THEME.Dim, TextXAlignment = Enum.TextXAlignment.Left,
    })

    local valLbl = new("TextLabel", {
        Parent = row, BackgroundTransparency = 1,
        Position = UDim2.new(0.5, 0, 0, 0), Size = UDim2.new(0.5, -4, 0, 14),
        Font = Enum.Font.GothamBold, Text = tostring(defaultVal), TextSize = 10,
        TextColor3 = THEME.Accent, TextXAlignment = Enum.TextXAlignment.Right,
    })

    local track = new("Frame", {
        Parent = row, Position = UDim2.new(0, 4, 0, 16), Size = UDim2.new(1, -8, 0, 4),
        BackgroundColor3 = THEME.Off, BorderSizePixel = 0,
    })
    corner(track, 2)

    local fill = new("Frame", {
        Parent = track, Size = UDim2.new((defaultVal - minVal) / (maxVal - minVal), 0, 1, 0),
        BackgroundColor3 = THEME.Accent, BorderSizePixel = 0,
    })
    corner(fill, 2)

    local knob = new("Frame", {
        Parent = track, AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new((defaultVal - minVal) / (maxVal - minVal), 0, 0.5, 0),
        Size = UDim2.fromOffset(14, 14),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255), BorderSizePixel = 0,
    })
    corner(knob, 7)

    local dragging = false
    local currentVal = defaultVal

    local function updateSlider(input)
        local x = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        currentVal = math.floor(minVal + (maxVal - minVal) * x)
        valLbl.Text = tostring(currentVal)
        fill.Size = UDim2.new(x, 0, 1, 0)
        knob.Position = UDim2.new(x, 0, 0.5, 0)
        if callback then callback(currentVal) end
    end

    local hit = new("TextButton", {
        Parent = row, BackgroundTransparency = 1, Text = "",
        Position = UDim2.new(0, 0, 0, 14), Size = UDim2.new(1, 0, 0, 20),
        AutoButtonColor = false,
    })

    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateSlider(input)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateSlider(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    return row
end

