local tabFrames = {}
local tabButtons = {}

local function createTabButton(name, layoutOrder)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 26)
    btn.BackgroundColor3 = Color3.fromRGB(13, 14, 20)
    btn.BackgroundTransparency = (layoutOrder == 1) and 0 or 1
    btn.Text = "  " .. name
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 8
    btn.Font = Enum.Font.GothamBold
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.LayoutOrder = layoutOrder
    btn.Parent = sideList

    local bCorner = Instance.new("UICorner")
    bCorner.CornerRadius = UDim.new(0, 6)
    bCorner.Parent = btn

    local bStroke = Instance.new("UIStroke")
    bStroke.Thickness = 1.5
    bStroke.Enabled = (layoutOrder == 1)
    bStroke.Parent = btn
    createRainbowGradient(bStroke)

    local cFrame = Instance.new("Frame")
    cFrame.Size = UDim2.new(1, 0, 0, 250)
    cFrame.Position = UDim2.new(0, 0, 0, 50)
    cFrame.BackgroundTransparency = 1
    cFrame.Visible = (layoutOrder == 1)
    cFrame.Parent = contentArea

    tabFrames[name] = cFrame
    tabButtons[name] = {Btn = btn, Stroke = bStroke}

    btn.MouseButton1Click:Connect(function()
        for n, f in pairs(tabFrames) do f.Visible = (n == name) end
        for n, b in pairs(tabButtons) do
            b.Btn.BackgroundTransparency = (n == name) and 0 or 1
            b.Stroke.Enabled = (n == name)
        end
    end)

    return cFrame
end

