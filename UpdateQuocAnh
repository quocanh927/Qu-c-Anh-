-- ===================== AIMBOT LOGIC (ĐÃ SỬA) =====================
local aimbotTarget = nil
local fovRainbowAngle = 0

-- FOV Circle (cầu vồng)
local FOVring = Drawing.new("Circle")
FOVring.Visible = false
FOVring.Thickness = 2
FOVring.Color = Color3.fromRGB(255, 0, 127)
FOVring.Filled = false
FOVring.Radius = settings.Aimbot.FOVSize
FOVring.Position = camera.ViewportSize / 2

local function updateFOVCircle()
    if settings.Aimbot.Enabled and settings.Aimbot.FOVCircle then
        FOVring.Visible = true
        FOVring.Radius = settings.Aimbot.FOVSize * (camera.ViewportSize.Y / 1080)
        FOVring.Position = camera.ViewportSize / 2
        -- Cầu vồng cho FOV circle
        fovRainbowAngle = (fovRainbowAngle + 0.5) % 360
        local hue = fovRainbowAngle / 360
        FOVring.Color = Color3.fromHSV(hue, 1, 1)
    else
        FOVring.Visible = false
    end
end

-- Hàm tìm target gần nhất
local function findNearestTarget()
    local nearest = nil
    local nearestDist = math.huge
    local center = camera.ViewportSize / 2
    local character = player.Character
    if not character then return nil end

    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player then
            local char = other.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                local root = char:FindFirstChild("HumanoidRootPart")
                if hum and hum.Health > 0 and root then
                    local screenPos, onScreen = camera:WorldToViewportPoint(root.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                        if dist < settings.Aimbot.FOVSize and dist < nearestDist then
                            nearestDist = dist
                            nearest = other
                        end
                    end
                end
            end
        end
    end
    return nearest
end

-- Hàm kiểm tra target còn sống
local function isTargetAlive(targetPlayer)
    if not targetPlayer then return false end
    local char = targetPlayer.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

-- Hàm bắn
local function shoot()
    local char = player.Character
    if char then
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then
            local remote = tool:FindFirstChild("RemoteEvent")
            if remote then
                remote:FireServer()
            else
                VirtualInput:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                task.wait(0.03)
                VirtualInput:SendMouseButtonEvent(0, 0, 0, false, game, 0)
            end
        else
            VirtualInput:SendMouseButtonEvent(0, 0, 0, true, game, 0)
            task.wait(0.03)
            VirtualInput:SendMouseButtonEvent(0, 0, 0, false, game, 0)
        end
    end
end

-- AIMBOT LOOP
local aimbotConnection = RunService.Heartbeat:Connect(function()
    updateFOVCircle()
    
    if not settings.Aimbot.Enabled then
        aimbotTarget = nil
        return
    end

    -- Nếu target hiện tại đã chết hoặc không còn tồn tại, tìm target mới
    if not isTargetAlive(aimbotTarget) then
        aimbotTarget = findNearestTarget()
    end

    -- Nếu chưa có target, tìm target gần nhất
    if not aimbotTarget then
        aimbotTarget = findNearestTarget()
        return
    end

    -- Kiểm tra lại target vẫn còn sống
    if not isTargetAlive(aimbotTarget) then
        aimbotTarget = findNearestTarget()
        return
    end

    -- Lấy vị trí đầu của target
    local char = aimbotTarget.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local head = char and char:FindFirstChild("Head")
    local aimPart = head or root
    if not aimPart then
        aimbotTarget = findNearestTarget()
        return
    end

    -- Tính toán vị trí dự đoán
    local pos = aimPart.Position
    local velocity = root and root.Velocity or Vector3.new()
    local predictedPos = pos + velocity * settings.Aimbot.Prediction
    
    -- Xoay camera đến target (Silent Aim)
    if settings.Aimbot.Silent then
        local currentCF = camera.CFrame
        local targetDirection = (predictedPos - currentCF.Position).Unit
        local newLookVector = currentCF.LookVector:Lerp(targetDirection, settings.Aimbot.Smoothness)
        camera.CFrame = CFrame.new(currentCF.Position, currentCF.Position + newLookVector)
    else
        camera.CFrame = CFrame.lookAt(camera.CFrame.Position, predictedPos)
    end

    -- Tự động bắn khi target ở trong tâm FOV
    local screenPos, onScreen = camera:WorldToViewportPoint(predictedPos)
    if onScreen then
        local center = camera.ViewportSize / 2
        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
        if dist < settings.Aimbot.FOVSize * 0.3 then
            shoot()
        end
    end
end)

