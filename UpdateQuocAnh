-- ===================== ESP LOGIC =====================
local function updateESP()
    for _, obj in ipairs(espObjects) do
        if obj and obj.Parent then obj:Destroy() end
    end
    espObjects = {}
    
    if not State.ESP then return end

    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= LocalPlayer and other.Character then
            local char = other.Character
            local hum = char:FindFirstChildOfClass("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and root then
                if State.ESP_Box then
                    local box = Instance.new("BoxHandleAdornment")
                    box.Size = Vector3.new(4, 5, 2)
                    box.Adornee = root
                    box.AlwaysOnTop = true
                    box.Color3 = Color3.fromRGB(0, 255, 127)
                    box.Transparency = 0.5
                    box.ZIndex = 5
                    box.Parent = root
                    table.insert(espObjects, box)
                end
                if State.ESP_Name then
                    local billboard = Instance.new("BillboardGui")
                    billboard.Size = UDim2.new(0, 150, 0, 20)
                    billboard.Adornee = root
                    billboard.StudsOffset = Vector3.new(0, 3, 0)
                    billboard.AlwaysOnTop = true
                    billboard.Parent = root
                    local label = Instance.new("TextLabel")
                    label.Size = UDim2.new(1, 0, 1, 0)
                    label.BackgroundTransparency = 1
                    label.Text = other.Name
                    label.TextColor3 = Color3.fromRGB(255, 255, 255)
                    label.TextSize = 10
                    label.Font = Enum.Font.GothamBold
                    label.Parent = billboard
                    table.insert(espObjects, billboard)
                end
                if State.ESP_Health then
                    local hpBar = Instance.new("BillboardGui")
                    hpBar.Size = UDim2.new(0, 50, 0, 4)
                    hpBar.Adornee = root
                    hpBar.StudsOffset = Vector3.new(0, -0.5, 0)
                    hpBar.AlwaysOnTop = true
                    hpBar.Parent = root
                    local bg = Instance.new("Frame")
                    bg.Size = UDim2.new(1, 0, 1, 0)
                    bg.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
                    bg.BorderSizePixel = 0
                    bg.Parent = hpBar
                    local bar = Instance.new("Frame")
                    bar.Size = UDim2.new(1, 0, 1, 0)
                    bar.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
                    bar.BorderSizePixel = 0
                    bar.Parent = hpBar
                    bg.ZIndex = 0
                    bar.ZIndex = 1
                    local healthPercent = hum.Health / hum.MaxHealth
                    bar.Size = UDim2.new(healthPercent, 0, 1, 0)
                    bar.BackgroundColor3 = healthPercent > 0.5 and Color3.fromRGB(0, 255, 0) or (healthPercent > 0.25 and Color3.fromRGB(255, 200, 0) or Color3.fromRGB(255, 0, 0))
                    table.insert(espObjects, hpBar)
                end
                if State.ESP_Tracer then
                    local tracer = Instance.new("LineHandleAdornment")
                    tracer.Length = 10
                    tracer.Thickness = 1
                    tracer.Adornee = root
                    tracer.AlwaysOnTop = true
                    tracer.Color3 = Color3.fromRGB(0, 255, 127)
                    tracer.Transparency = 0.3
                    tracer.Parent = root
                    table.insert(espObjects, tracer)
                end
            end
        end
    end
end

