-- ===================== HELPERS =====================
local function new(class, props)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do
        if k ~= "Parent" then inst[k] = v
    end
    if props and props.Parent then inst.Parent = props.Parent
    return inst
end

local function corner(p, r)
    return new("UICorner", { CornerRadius = UDim.new(0, r), Parent = p })
end

local function stroke(p, c, t)
    return new("UIStroke", { Color = c or THEME.Stroke, Thickness = t or 1, Parent = p })
end

local function tween(inst, time, props)
    local tw = TweenService:Create(inst, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end

local function getHum()
    local c = LocalPlayer.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function getRoot()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function makeDraggable(handle, target)
    local dragging, startPos, startAbs = false
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            startAbs, startPos = input.Position, target.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            local d = input.Position - startAbs
            target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                                        startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

local function createRainbowGradient(parent)
    local grad = new("UIGradient", {
        Parent = parent, Rotation = 0,
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 127)),
            ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 215, 0)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 127)),
            ColorSequenceKeypoint.new(0.75, Color3.fromRGB(0, 191, 255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 127))
        })
    })
    table.insert(rainbowGradients, grad)
    return grad
end

