	end

end

RunService.RenderStepped:Connect(function()

	if States.JumpBoost
		and humanoid
		and humanoid.Health > 0 then

		humanoid.UseJumpPower = true

		humanoid.JumpPower =
			GetJumpPower()

	end

end)

