local function GetSpeed()

	if SliderObjects["Speed Value"] then

		return SliderObjects[
			"Speed Value"
		].Get()

	end

	return 100
end

local function SetSpeed(state)

	States.Speed = state

	if not humanoid then
		return
	end

	if state then

		humanoid.WalkSpeed =
			GetSpeed()

	else

		humanoid.WalkSpeed = 16

	end

end

RunService.RenderStepped:Connect(function()

