-- RESPAWN
--========================================================

LocalPlayer.CharacterAdded:Connect(function(newCharacter)

	character = newCharacter

	task.wait(0.5)

	humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	rootPart =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	if States.Speed then
		SetSpeed(true)
	end

	if States.JumpBoost then
		SetJumpBoost(true)
	end

	if States.Noclip then

		for _, part in ipairs(
			character:GetDescendants()
		) do

			if part:IsA("BasePart") then
				part.CanCollide = false
			end

		end

	end

end)
--========================================================
-- PART 7/7 - FIX LAG + HITBOX + KẾT NỐI TOGGLE
--========================================================

--========================================================
-- FIX LAG MỚI
-- NHẸ / MẠNH
--========================================================

local SavedFixLag = {}
local FixLagApplied = false

local function SaveProperty(obj, property, value)
	if not SavedFixLag[obj] then
		SavedFixLag[obj] = {}
	end

	if SavedFixLag[obj][property] == nil then
		SavedFixLag[obj][property] = value
	end
end

local function SetFixLag(state)

	States.FixLag = state

	if not state then

		-- Khôi phục những thứ có thể khôi phục
		for obj, properties in pairs(SavedFixLag) do

			if obj and obj.Parent then

				for property, oldValue in pairs(properties) do

					pcall(function()
						obj[property] = oldValue
					end)

				end

			end

		end

		SavedFixLag = {}
		FixLagApplied = false

		return
	end

	FixLagApplied = true

	--====================================================
	-- NHẸ:
	-- XÓA/TẮT TOÀN BỘ HIỆU ỨNG NẶNG
	--====================================================

	for _, obj in ipairs(
		workspace:GetDescendants()
	) do

		-- Particle
		if obj:IsA("ParticleEmitter") then

			SaveProperty(
				obj,
				"Enabled",
				obj.Enabled
			)

			obj.Enabled = false

		-- Trail
		elseif obj:IsA("Trail") then

			SaveProperty(
				obj,
				"Enabled",
				obj.Enabled
			)

			obj.Enabled = false

		-- Beam
		elseif obj:IsA("Beam") then

			SaveProperty(
				obj,
				"Enabled",
				obj.Enabled
			)

			obj.Enabled = false

		-- Smoke
		elseif obj:IsA("Smoke") then

			SaveProperty(
				obj,
				"Enabled",
				obj.Enabled
			)

			obj.Enabled = false

		-- Fire
		elseif obj:IsA("Fire") then

			SaveProperty(
				obj,
				"Enabled",
				obj.Enabled
			)

			obj.Enabled = false

		-- Sparkles
		elseif obj:IsA("Sparkles") then

			SaveProperty(
				obj,
				"Enabled",
				obj.Enabled
			)

			obj.Enabled = false

		end

	end

	--====================================================
	-- TẮT BÓNG + HIỆU ỨNG ÁNH SÁNG
	--====================================================

	SaveProperty(
		Lighting,
		"GlobalShadows",
		Lighting.GlobalShadows
	)

	Lighting.GlobalShadows = false

	for _, obj in ipairs(
		Lighting:GetChildren()
	) do

		if obj:IsA("BloomEffect")
			or obj:IsA("BlurEffect")
			or obj:IsA("ColorCorrectionEffect")
			or obj:IsA("DepthOfFieldEffect")
			or obj:IsA("SunRaysEffect") then

			SaveProperty(
				obj,
				"Enabled",
				obj.Enabled
			)

			obj.Enabled = false

		end

	end

	--====================================================
	-- MẠNH
	--====================================================

	if FixLagMode == "Mạnh" then

		for _, obj in ipairs(
			workspace:GetDescendants()
		) do

			-- Làm vật liệu nhẹ hơn
			if obj:IsA("BasePart") then

				SaveProperty(
					obj,
					"Material",
					obj.Material
				)

				obj.Material =
					Enum.Material.SmoothPlastic

				-- Tắt bóng từng part
				SaveProperty(
					obj,
					"CastShadow",
					obj.CastShadow
				)

				obj.CastShadow = false

			-- Xóa texture
			elseif obj:IsA("Decal")
				or obj:IsA("Texture") then

				SaveProperty(
					obj,
					"Transparency",
					obj.Transparency
				)

				obj.Transparency = 1

			end

		end

		-- Xóa hiệu ứng ánh sáng mạnh
		for _, obj in ipairs(
			Lighting:GetChildren()
		) do

			if obj:IsA("Sky")
				or obj:IsA("Atmosphere") then

				SaveProperty(
					obj,
					"Parent",
					obj.Parent
				)

				obj.Parent = nil

			end

		end

		-- Xóa hiệu ứng ánh sáng trong map
		for _, obj in ipairs(
			workspace:GetDescendants()
		) do

			if obj:IsA("PointLight")
				or obj:IsA("SpotLight")
				or obj:IsA("SurfaceLight") then

				SaveProperty(
					obj,
					"Enabled",
					obj.Enabled
				)

				obj.Enabled = false

			end

		end

	end

end
--========================================================
-- HITBOX
--========================================================

local OriginalHitboxes = {}

local function GetHitboxSize()

	if SliderObjects["Size Hitbox"] then
		return SliderObjects[
			"Size Hitbox"
		].Get()
	end

	return 20
end

local function GetHitboxColor()

	if ColorObjects["Màu Hitbox"] then

		if ColorObjects[
			"Màu Hitbox"
		].Rainbow then

			return Color3.fromHSV(
				rainbowOffset,
				0.85,
				1
			)

		end

		return ColorObjects[
			"Màu Hitbox"
		].Color

	end

	return Color3.fromRGB(170, 0, 255)
end

local function RestoreHitbox(player)

	local characterModel =
		player.Character

	if not characterModel then
		return
	end

	local data =
		OriginalHitboxes[player]

	if not data then
		return
	end

	for part, info in pairs(data) do

		if part
			and part.Parent
			and part:IsA("BasePart") then

			part.Size = info.Size
			part.Transparency =
				info.Transparency

			part.CanCollide =
				info.CanCollide

		end

	end

	OriginalHitboxes[player] = nil
end

local function ApplyHitbox(player)

	if player == LocalPlayer then
		return
	end

	local model =
		player.Character

	if not model then
		return
	end

	local root =
		model:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then
		return
	end

	if not OriginalHitboxes[player] then

		OriginalHitboxes[player] = {}

		for _, part in ipairs(
			model:GetChildren()
		) do

			if part:IsA("BasePart") then

				OriginalHitboxes[player][part] = {
					Size = part.Size,
					Transparency =
						part.Transparency,
					CanCollide =
						part.CanCollide
				}

			end

		end

	end

	local size =
		GetHitboxSize()

	local scale =
	math.clamp(
		size / 8,
		1,
		12
	)
	root.Size =
	Vector3.new(
		2.5 * scale,
		3 * scale,
		2.5 * scale
	)

	root.Transparency = 0.5

	root.CanCollide = false
end

local function SetHitbox(state)

	States.Hitbox = state

	if state then

		for _, player in ipairs(
			Players:GetPlayers()
		) do

			if player ~= LocalPlayer then
				ApplyHitbox(player)
			end

		end

	else

		for player in pairs(
			OriginalHitboxes
		) do

			RestoreHitbox(player)

		end

	end

end

Players.PlayerAdded:Connect(function(player)

	player.CharacterAdded:Connect(function()

		task.wait(0.5)

		if States.Hitbox then
			ApplyHitbox(player)
		end

	end)

end)

Players.PlayerRemoving:Connect(function(player)

	OriginalHitboxes[player] = nil

end)

-- cập nhật hitbox + màu theo slider
RunService.RenderStepped:Connect(function()

	if not States.Hitbox then
		return
	end

	for _, player in ipairs(
		Players:GetPlayers()
	) do

		if player ~= LocalPlayer then
			ApplyHitbox(player)
		end

	end

end)

