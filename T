local function applySpeed()
    local hum = getHum()
    if hum then
        hum.WalkSpeed = State.Speed and State.SpeedValue or 16
    end
end

local flyConnection = nil
local function toggleFly(on)
    State.Fly = on
    if on then
        local root = getRoot()
        if root then
            root.Anchored = false
            local bodyVel = Instance.new("BodyVelocity")
            bodyVel.MaxForce = Vector3.new(1e6, 1e6, 1e6)
            bodyVel.Velocity = Vector3.new(0, 0, 0)
            bodyVel.Parent = root
            flyConnection = RunService.Heartbeat:Connect(function()
                if not State.Fly or not root or not root.Parent then
                    if bodyVel then bodyVel:Destroy() end
                    if flyConnection then flyConnection:Disconnect(); flyConnection = nil end
                    return
                end
                local move = Vector3.new()
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + Vector3.new(0, 0, -State.FlySpeed) end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move + Vector3.new(0, 0, State.FlySpeed) end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move + Vector3.new(-State.FlySpeed, 0, 0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + Vector3.new(State.FlySpeed, 0, 0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0, State.FlySpeed, 0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then move = move + Vector3.new(0, -State.FlySpeed, 0) end
                if move.Magnitude > 0 then
                    local cam = workspace.CurrentCamera
                    if cam then
                        local forward = cam.CFrame.LookVector
                        local right = cam.CFrame.RightVector
                        local up = cam.CFrame.UpVector
                        local dir = (right * move.X + up * move.Y + forward * -move.Z)
                        bodyVel.Velocity = dir.Unit * State.FlySpeed
                    else
                        bodyVel.Velocity = move.Unit * State.FlySpeed
                    end
                else
                    bodyVel.Velocity = Vector3.new(0, 0, 0)
                end
            end)
        end
    else
        if flyConnection then flyConnection:Disconnect(); flyConnection = nil end
        local root = getRoot()
        if root then
            local bv = root:FindFirstChildOfClass("BodyVelocity")
            if bv then bv:Destroy() end
        end
    end
end

local function applyJump()
    local hum = getHum()
    if hum then
        hum.JumpPower = State.JumpBoost and State.JumpValue or 50
    end
end

------------------------------------------------------------------
-- CHỨC NĂNG: AUTOFARM
------------------------------------------------------------------
local farmConnection = nil
local farmCooldown = 0

local function startFarm()
    if farmConnection then farmConnection:Disconnect(); farmConnection = nil end
    State.AutoFarm = true
    farmConnection = RunService.Heartbeat:Connect(function()
        if not State.AutoFarm then
            farmConnection:Disconnect(); farmConnection = nil
            return
        end
        local root = getRoot()
        if not root then return end
        local mob = MobUtil.nearest(State.FarmTarget)
        if not mob then return end
        local anchor = MobUtil.anchorOf(mob.model)
        if not anchor then return end
        local dist = (anchor.Position - root.Position).Magnitude
        if dist > 10 then
            LocalPlayer.Character.Humanoid:MoveTo(anchor.Position)
        else
            local targetPos = anchor.Position + Vector3.new(0, State.FarmHeight, 0)
            root.CFrame = CFrame.new(root.Position, targetPos)
            if tick() - farmCooldown > CONFIG.AttackRate then
                farmCooldown = tick()
                if CONFIG.OnAttack then
                    CONFIG.OnAttack(mob.model, mob.hum)
                else
                    VirtualInput:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                    task.wait(0.03)
                    VirtualInput:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                    VirtualInput:SendKeyEvent(true, Enum.KeyCode.Q, false, game)
                    task.wait(0.03)
                    VirtualInput:SendKeyEvent(false, Enum.KeyCode.Q, false, game)
                end
            end
        end
    end)
end

