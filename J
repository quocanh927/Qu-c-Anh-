-- SLIDER
--==================================================

local function makeSlider(text,minValue,maxValue,defaultValue,y,callback)

	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1,-5,0,55)
	frame.Position = UDim2.fromOffset(0,y)
	frame.BackgroundColor3 = Color3.fromRGB(24,24,32)
	frame.BorderSizePixel = 0
	frame.Parent = content

	Instance.new("UICorner",frame).CornerRadius = UDim.new(0,11)

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1,-30,0,22)
	label.Position = UDim2.fromOffset(15,5)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.fromRGB(210,210,220)
	label.TextSize = 12
	label.Font = Enum.Font.GothamBold
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = frame

	local slider = Instance.new("TextButton")
	slider.Size = UDim2.new(1,-30,0,8)
	slider.Position = UDim2.fromOffset(15,35)
	slider.BackgroundColor3 = Color3.fromRGB(45,45,55)
	slider.BorderSizePixel = 0
	slider.Text = ""
	slider.Parent = frame

	Instance.new("UICorner",slider).CornerRadius = UDim.new(1,0)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(0,0,1,0)
	fill.BackgroundColor3 = Color3.fromRGB(255,205,50)
	fill.BorderSizePixel = 0
	fill.Parent = slider

	Instance.new("UICorner",fill).CornerRadius = UDim.new(1,0)

	local draggingSlider = false

	local function update(value)

		value = math.clamp(
			value,
			minValue,
			maxValue
		)

		local alpha =
			(value-minValue) /
			(maxValue-minValue)

		fill.Size =
			UDim2.new(alpha,0,1,0)

		label.Text =
			text.." : "..math.floor(value)

		if callback then
			callback(value)
		end

	end

	local function move(input)

		local x =
			input.Position.X -
			slider.AbsolutePosition.X

		local alpha =
			math.clamp(
				x / slider.AbsoluteSize.X,
				0,
				1
			)

		update(
			minValue +
			(maxValue-minValue)*alpha
		)

	end

	slider.InputBegan:Connect(function(input)

		if input.UserInputType ==
			Enum.UserInputType.MouseButton1
			or input.UserInputType ==
			Enum.UserInputType.Touch then

			draggingSlider = true
			move(input)

		end

	end)

	UIS.InputChanged:Connect(function(input)

		if draggingSlider then

			if input.UserInputType ==
				Enum.UserInputType.MouseMovement
				or input.UserInputType ==
				Enum.UserInputType.Touch then

				move(input)

			end

		end

	end)

	UIS.InputEnded:Connect(function(input)

		if input.UserInputType ==
			Enum.UserInputType.MouseButton1
			or input.UserInputType ==
			Enum.UserInputType.Touch then

			draggingSlider = false

		end

	end)

	update(defaultValue)

end

