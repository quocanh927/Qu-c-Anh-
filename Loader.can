ColorButton.TextColor3 = Color3.new(1,1,1)
ColorButton.TextSize = 13
ColorButton.Font = Enum.Font.GothamBold
ColorButton.Parent = Menu

Instance.new("UICorner",ColorButton).CornerRadius = UDim.new(0,8)

local ColorPanel = Instance.new("Frame")
ColorPanel.Size = UDim2.new(1,-30,0,45)
ColorPanel.Position = UDim2.fromOffset(15,243)
ColorPanel.BackgroundColor3 = Color3.fromRGB(30,30,30)
ColorPanel.BorderSizePixel = 0
ColorPanel.Visible = false
ColorPanel.Parent = Menu

Instance.new("UICorner",ColorPanel).CornerRadius = UDim.new(0,8)

local colors = {
    {"Đỏ",Color3.fromRGB(255,70,70)},
    {"Xanh",Color3.fromRGB(70,140,255)},
    {"Lá",Color3.fromRGB(70,255,120)},
    {"Vàng",Color3.fromRGB(255,210,45)},
    {"🌈",nil}
}

for i,data in ipairs(colors) do

    local b = Instance.new("TextButton")

    b.Size = UDim2.fromOffset(43,28)
    b.Position = UDim2.fromOffset(6+(i-1)*49,8)
    b.BackgroundColor3 =
        data[2] or Color3.fromRGB(255,100,220)

    b.BorderSizePixel = 0
    b.Text = data[1]
    b.TextSize = 9
    b.TextColor3 = Color3.new(1,1,1)
    b.Font = Enum.Font.GothamBold
    b.Parent = ColorPanel

    Instance.new("UICorner",b).CornerRadius = UDim.new(0,6)

    b.Activated:Connect(function()

        if data[1] == "🌈" then

            Settings.Rainbow = true

        else

            Settings.Rainbow = false
            Settings.Color = data[2]
            Fill.BackgroundColor3 = data[2]

        end

    end)
end

local ColorOpen = false

ColorButton.Activated:Connect(function()

    ColorOpen = not ColorOpen

    ColorPanel.Visible = ColorOpen

    if ColorOpen then
        Menu.Size = UDim2.fromOffset(285,300)
    else
        Menu.Size = UDim2.fromOffset(285,250)
    end

end)

local function GetColor()

    if Settings.Rainbow then

        return Color3.fromHSV(
            (os.clock()%5)/5,
            1,
            1
        )

    end

    return Settings.Color
end
--========================================================
-- PART 5/5
-- HITBOX + ESP (GIỮ NGUYÊN CODE CỦA BẠN)
--========================================================

-- Khai báo biến toàn cục cho hitbox
_G.HeadSize = Settings.Size
_G.Disabled = Settings.HitBox
_G.HeadColor = Settings.Color

local espObjects = {}

-- Hàm chuyển Color3 sang BrickColor
local function Color3ToBrickColor(color3)
    return BrickColor.new(Color3.new(color3.R, color3.G, color3.B))
end

-- ====== GIỮ NGUYÊN CODE HITBOX CỦA BẠN ======
game:GetService('RunService').RenderStepped:connect(function()
    if _G.Disabled then
        for i,v in next, game:GetService('Players'):GetPlayers() do
            if v.Name ~= game:GetService('Players').LocalPlayer.Name then
                pcall(function()
                    v.Character.HumanoidRootPart.Size = Vector3.new(_G.HeadSize,_G.HeadSize,_G.HeadSize)
                    v.Character.HumanoidRootPart.Transparency = 0.7
                    v.Character.HumanoidRootPart.BrickColor = BrickColor.new(_G.HeadColor)
                    v.Character.HumanoidRootPart.Material = "Neon"
                    v.Character.HumanoidRootPart.CanCollide = false
                end)
            end
        end
    end
end)

-- ====== ESP ======
local function UpdateESP()
    if not Settings.ESP then return end
    
    local camera = workspace.CurrentCamera
    local espColor = GetColor()
    
    for _, v in ipairs(Players:GetPlayers()) do
        if v ~= Player and v.Character then
            local root = v.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local pos, onScreen = camera:WorldToScreenPoint(root.Position + Vector3.new(0, 2.5, 0))
                
                if onScreen then
                    local esp = espObjects[v]
                    if not esp then
                        esp = Instance.new("TextLabel")
                        esp.BackgroundTransparency = 1
                        esp.Font = Enum.Font.GothamBold
                        esp.TextSize = 14
                        esp.TextStrokeTransparency = 0.5
                        esp.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                        esp.Parent = Gui
                        espObjects[v] = esp
                    end
                    
                    esp.TextColor3 = espColor
                    
                    local dist = 0
                    local playerRoot = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
                    if playerRoot then
                        dist = (root.Position - playerRoot.Position).Magnitude
                    end
                    
                    esp.Text = v.Name .. "  [" .. math.floor(dist) .. "m]"
                    esp.Position = UDim2.new(0, pos.X - esp.TextBounds.X/2, 0, pos.Y - esp.TextBounds.Y/2)
                    esp.Visible = true
                else
                    if espObjects[v] then
                        espObjects[v].Visible = false
                    end
                end
            end
        end
    end
    
    for player, obj in pairs(espObjects) do
        if not Players:FindFirstChild(player.Name) then
            obj:Destroy()
            espObjects[player] = nil
        end
    end
end

game:GetService('RunService').RenderStepped:connect(function()
    UpdateESP()
end)

-- Cập nhật rainbow
game:GetService('RunService').RenderStepped:connect(function()
    if not Settings.Rainbow then
        return
    end

    local color = GetColor()
    Fill.BackgroundColor3 = color
    ColorButton.BackgroundColor3 = color
    _G.HeadColor = color
    
    for _, esp in pairs(espObjects) do
        if esp and esp.Visible then
            esp.TextColor3 = color
        end
    end
end)

print("👑 Quoc Anh Menu loaded!")
