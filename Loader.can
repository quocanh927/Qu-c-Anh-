-- Color Picker cho Hitbox
local hitboxColorPicker = CreateColorPicker("Màu Hitbox", function(color)
	if color == "Rainbow" then
		-- Màu cầu vồng không có BrickColor, ta có thể đặt một màu động, nhưng để đơn giản, đặt "Really blue"
		_G.HitboxColor = "Really blue"
	else
		-- Chuyển Color3 thành tên BrickColor gần nhất? Ta sẽ lưu trực tiếp Color3 và chuyển đổi trong vòng lặp.
		-- Vì BrickColor.new chỉ nhận tên, ta sẽ tạo một bảng ánh xạ hoặc dùng Color3.toHex? Thực tế, vòng lặp dùng BrickColor.new(_G.HitboxColor) nên ta cần tên.
		-- Ta sẽ lưu tên tương ứng, hoặc nếu là Color3, ta có thể tạo BrickColor từ Color3.
		-- Ta sẽ sửa vòng lặp để dùng màu từ Color3 thay vì BrickColor, nhưng để giữ nguyên code của bạn, tôi sẽ chuyển Color3 thành tên gần đúng.
		-- Giải pháp đơn giản: lưu màu dưới dạng Color3 và sử dụng trong highlight? Nhưng vòng lặp dùng BrickColor.
		-- Tôi sẽ điều chỉnh: thay vì BrickColor.new, ta dùng root.Color = color (nếu root là BasePart có Color). Vậy tôi sẽ sửa nhẹ code của bạn:
		-- root.Color = color (Color3)
		-- Nhưng bạn muốn giữ nguyên code? Tôi sẽ thay đổi một chút: trong vòng lặp, thay BrickColor.new(...) bằng root.Color = color
		-- Tôi sẽ làm ở phần sửa sau.
		_G.HitboxColor = color
	end
end)
hitboxColorPicker.Visible = false

-- Fix Lag (sử dụng code bạn đưa)
local fixLagToggle = CreateToggle("Fix Lag", "Giảm lag hiệu quả", function(state)
	if state then
		-- Chạy script fix lag của bạn
		-- Lưu trữ các đối tượng đã thay đổi để khôi phục
		local saved = {}
		local ToDisable = { Textures = true, VisualEffects = true, Parts = true, Particles = true, Sky = true }
		for _, v in next, game:GetDescendants() do
			if ToDisable.Parts and (v:IsA("Part") or v:IsA("Union") or v:IsA("BasePart")) then
				table.insert(saved, {obj = v, prop = "Material", val = v.Material})
				v.Material = Enum.Material.SmoothPlastic
			end
			if ToDisable.Particles and (v:IsA("ParticleEmitter") or v:IsA("Smoke") or v:IsA("Explosion") or v:IsA("Sparkles") or v:IsA("Fire")) then
				table.insert(saved, {obj = v, prop = "Enabled", val = v.Enabled})
				v.Enabled = false
			end
			if ToDisable.VisualEffects and (v:IsA("BloomEffect") or v:IsA("BlurEffect") or v:IsA("DepthOfFieldEffect") or v:IsA("SunRaysEffect")) then
				table.insert(saved, {obj = v, prop = "Enabled", val = v.Enabled})
				v.Enabled = false
			end
			if ToDisable.Textures and (v:IsA("Decal") or v:IsA("Texture")) then
				table.insert(saved, {obj = v, prop = "Texture", val = v.Texture})
				v.Texture = ""
			end
			if ToDisable.Sky and v:IsA("Sky") then
				table.insert(saved, {obj = v, prop = "Parent", val = v.Parent})
				v.Parent = nil
			end
		end
		-- Lưu để khôi phục
		fixLagToggle._saved = saved
	else
		-- Khôi phục
		if fixLagToggle._saved then
			for _, item in ipairs(fixLagToggle._saved) do
				pcall(function()
					if item.prop == "Parent" then
						item.obj.Parent = item.val
					else
						item.obj[item.prop] = item.val
					end
				end)
			end
			fixLagToggle._saved = nil
		end
	end
end)
-- ===== PHẦN 7/7 =====
-- Hàm hỗ trợ tương tác slider (khi bấm vào track)
local function setupSlider(sliderObj, label, fill, min, max, callback)
	local track = sliderObj:FindFirstChildWhichIsA("Frame") -- track là con đầu tiên, nhưng ta có thể lấy bằng cách duyệt
	-- Thực tế, track là con thứ hai (sau label), nhưng để an toàn, tìm bằng tên hoặc kiểu
	for _, child in ipairs(sliderObj:GetChildren()) do
		if child:IsA("Frame") and child ~= label and child ~= fill and child.Parent == sliderObj then
			track = child
			break
		end
	end
	if not track then return end
	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			local function update(input)
				local pos = input.Position.X - track.AbsolutePosition.X
				local width = track.AbsoluteSize.X
				local percent = math.clamp(pos / width, 0, 1)
				local value = math.floor(min + (max - min) * percent)
				fill.Size = UDim2.new(percent, 0, 1, 0)
				label.Text = string.gsub(label.Text, ":%s*%d+", ": " .. value)
				if callback then callback(value) end
			end
			update(input)
			local conn
			conn = RunService.RenderStepped:Connect(function()
				local mouse = game:GetService("UserInputService"):GetMouseLocation()
				local pos = mouse.X - track.AbsolutePosition.X
				local width = track.AbsoluteSize.X
				local percent = math.clamp(pos / width, 0, 1)
				local value = math.floor(min + (max - min) * percent)
				fill.Size = UDim2.new(percent, 0, 1, 0)
				label.Text = string.gsub(label.Text, ":%s*%d+", ": " .. value)
				if callback then callback(value) end
				if not game:GetService("UserInputService"):IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
					conn:Disconnect()
				end
			end)
		end
	end)
end

-- Gắn cho Speed
setupSlider(speedSliderObj, speedLabel, speedFill, speedMin, speedMax, function(value)
	if speedToggle._toggled then
		if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
			LocalPlayer.Character.Humanoid.WalkSpeed = value
		end
	end
end)

-- Gắn cho Jump
setupSlider(jumpSliderObj, jumpLabel, jumpFill, jumpMin, jumpMax, function(value)
	if jumpToggle._toggled then
		if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
			LocalPlayer.Character.Humanoid.JumpPower = value
		end
	end
end)

-- Gắn cho Hitbox Size
setupSlider(hitboxSliderObj, hitboxLabel, hitboxFill, hitboxMin, hitboxMax, function(value)
	_G.HeadSize = value
end)

