-- ============================================
-- PHẦN 1: KHAI BÁO & CẤU HÌNH
-- ============================================
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")

-- ============================================
-- CẤU HÌNH JNKIE (NHẬP THÔNG TIN CỦA BẠN)
-- ============================================
local JNKIE_API_KEY = "6270c691-3559-4023-a0f8-67c1f70d72bf"  -- API Key của bạn
local JNKIE_API_BASE = "https://jnkie.com/flow/8b883d41-e2e5-4a03-97a8-1120beca612d"  -- API Base URL
local JNKIE_GETKEY_URL = "https://jnkie.com/flow/8b883d41-e2e5-4a03-97a8-1120beca612d"  -- Link getkey (dùng cho copy)
local TARGET_SCRIPT_URL = "https://raw.githubusercontent.com/Ryuun0x/Clover/refs/heads/main/main.lua"
-- ============================================
-- PHẦN 2: HÀM GỌI API JNKIE
-- ============================================

local function CallJNKIEAPI(method, params)
    local url = JNKIE_API_BASE .. "/" .. method .. "?apikey=" .. JNKIE_API_KEY
    if params then
        for k, v in pairs(params) do
            url = url .. "&" .. k .. "=" .. v
        end
    end
    
    local success, response = pcall(function()
        return game:HttpGet(url)
    end)
    
    if success and response then
        local decodeSuccess, data = pcall(function()
            return HttpService:JSONDecode(response)
        end)
        if decodeSuccess then
            return data
        else
            return { success = true, data = response }
        end
    end
    return nil
end

-- Hàm lấy link flow từ JNKIE
local function GetFlowLink()
    local result = CallJNKIEAPI("getLink")
    if result and result.link then
        return result.link
    end
    return nil
end

-- Hàm xác thực key qua JNKIE API
local function VerifyKeyViaAPI(key)
    local result = CallJNKIEAPI("verifyKey", { key = key })
    if result then
        return result.valid == true or result.success == true
    end
    return false
end

-- Hàm chạy script chính
local function LaunchCloverHub()
    task.spawn(function()
        local success, result = pcall(function()
            return loadstring(game:HttpGet(TARGET_SCRIPT_URL))()
        end)
        if not success then
            warn("[CloverHub Error]:", result)
        end
    end)
end

-- Hàm copy clipboard
local function SetClipboard(text)
    if setclipboard then
        setclipboard(text)
    elseif toclipboard then
        toclipboard(text)
    end
end
