-- Nút LẤY KEY (copy link getkey)
GetKeyBtn.MouseButton1Click:Connect(function()
    SetClipboard(JNKIE_GETKEY_URL)
    StatusMsg.Text = "📋 Đã copy link! Dán vào trình duyệt để lấy key."
    StatusMsg.TextColor3 = Color3.fromRGB(0, 255, 163)
    GetKeyBtn.Text = "✔ ĐÃ SAO CHÉP"
    task.delay(2, function()
        if GetKeyBtn and GetKeyBtn.Parent then
            GetKeyBtn.Text = "⚡ LẤY KEY NGAY"
        end
    end)
end)

-- Nút KÍCH HOẠT (xác thực key thủ công)
local isChecking = false
CheckBtn.MouseButton1Click:Connect(function()
    if isChecking then return end
    isChecking = true
    
    CheckBtn.Text = "⏳ Đang kiểm tra..."
    StatusMsg.Text = "⏳ Đang xác thực key..."
    StatusMsg.TextColor3 = Color3.fromRGB(220, 255, 240)
    InputStroke.Color = Color3.fromRGB(25, 60, 48)
    
    task.wait(0.5)
    local enteredKey = string.gsub(InputBox.Text, "%s+", "")
    
    -- Kiểm tra key thủ công
    if enteredKey ~= "" then
        -- Giả sử key đúng là key bạn lấy từ link
        -- Bạn có thể cập nhật key đúng vào đây hoặc dùng API
        local isValid = enteredKey == "6b5cdaa6-eb83-4427-9791-e39f6d723eda"  -- 👈 Sửa key đúng
        
        if isValid then
            StatusMsg.Text = "✅ Xác thực thành công! Đang tải CloverHub..."
            StatusMsg.TextColor3 = Color3.fromRGB(0, 255, 163)
            CheckBtn.Text = "✔ THÀNH CÔNG"
            CheckBtn.BackgroundColor3 = Color3.fromRGB(16, 185, 129)
            InputStroke.Color = Color3.fromRGB(0, 255, 163)
            
            LaunchCloverHub()
            
            task.delay(1.5, function()
                ScreenGui:Destroy()
            end)
        else
            isChecking = false
            StatusMsg.Text = "❌ Key không chính xác! Vui lòng thử lại."
            StatusMsg.TextColor3 = Color3.fromRGB(255, 110, 110)
            CheckBtn.Text = "✔ KÍCH HOẠT KEY"
            InputStroke.Color = Color3.fromRGB(255, 80, 80)
            task.delay(1.5, function()
                InputStroke.Color = Color3.fromRGB(25, 60, 48)
            end)
        end
    else
        isChecking = false
        StatusMsg.Text = "⚠️ Vui lòng nhập key!"
        StatusMsg.TextColor3 = Color3.fromRGB(255, 200, 50)
        CheckBtn.Text = "✔ KÍCH HOẠT KEY"
    end
end)

-- Nút KIỂM TRA QUA API
ApiCheckBtn.MouseButton1Click:Connect(function()
    local enteredKey = string.gsub(InputBox.Text, "%s+", "")
    if enteredKey == "" then
        StatusMsg.Text = "⚠️ Vui lòng nhập key trước!"
        StatusMsg.TextColor3 = Color3.fromRGB(255, 200, 50)
        return
    end
    
    StatusMsg.Text = "⏳ Đang gọi API JNKIE..."
    StatusMsg.TextColor3 = Color3.fromRGB(220, 255, 240)
    ApiCheckBtn.Text = "⏳ ĐANG KIỂM TRA..."
    
    -- Gọi API kiểm tra
    local apiResult = VerifyKeyViaAPI(enteredKey)
    
    if apiResult == true then
        StatusMsg.Text = "✅ Key hợp lệ qua API! Đang tải CloverHub..."
        StatusMsg.TextColor3 = Color3.fromRGB(0, 255, 163)
        ApiCheckBtn.Text = "✅ HỢP LỆ"
        InputStroke.Color = Color3.fromRGB(0, 255, 163)
        
        LaunchCloverHub()
        task.delay(1.5, function()
            ScreenGui:Destroy()
        end)
    elseif apiResult == false then
        StatusMsg.Text = "❌ API xác nhận: Key không hợp lệ!"
        StatusMsg.TextColor3 = Color3.fromRGB(255, 110, 110)
        ApiCheckBtn.Text = "🔍 KIỂM TRA QUA API"
        InputStroke.Color = Color3.fromRGB(255, 80, 80)
        task.delay(1.5, function()
            InputStroke.Color = Color3.fromRGB(25, 60, 48)
        end)
    else
        StatusMsg.Text = "⚠️ Không thể gọi API. Kiểm tra URL API JNKIE!"
        StatusMsg.TextColor3 = Color3.fromRGB(255, 200, 50)
        ApiCheckBtn.Text = "🔍 KIỂM TRA QUA API"
    end
end)
