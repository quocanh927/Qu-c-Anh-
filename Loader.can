local ColorButton = Instance.new("TextButton")
ColorButton.Size = UDim2.new(1, -30, 0, 36)
ColorButton.Position = UDim2.fromOffset(15, 174)
ColorButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
ColorButton.BorderSizePixel = 0
ColorButton.Text = "🎨  Chọn màu"
ColorButton.TextColor3 = Color3.new(1, 1, 1)
ColorButton.TextSize = 13
ColorButton.Font = Enum.Font.GothamBold
ColorButton.AutoButtonColor = false
ColorButton.Parent = Main

local ColorCorner = Instance.new("UICorner")
ColorCorner.CornerRadius = UDim.new(0, 8)
ColorCorner.Parent = ColorButton

local ColorPanel = Instance.new("Frame")
ColorPanel.Size = UDim2.new(1, -30, 0, 48)
ColorPanel.Position = UDim2.fromOffset(15, 215)
ColorPanel.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
ColorPanel.BorderSizePixel = 0
ColorPanel.Visible = false
ColorPanel.Parent = Main

local PanelCorner = Instance.new("UICorner")
PanelCorner.CornerRadius = UDim.new(0, 8)
PanelCorner.Parent = ColorPanel

local ColorData = {
    {"Đỏ", Color3.fromRGB(255, 70, 70)},
    {"Xanh", Color3.fromRGB(70, 140, 255)},
    {"Lá", Color3.fromRGB(70, 255, 120)},
    {"Vàng", Color3.fromRGB(255, 210, 45)},
    {"🌈", nil}
}

for i, data in ipairs(ColorData) do

    local Button = Instance.new("TextButton")

    Button.Size = UDim2.fromOffset(45, 30)

    Button.Position =
        UDim2.fromOffset(
            7 + (i - 1) * 51,
            9
        )

    Button.BackgroundColor3 =
        data[2]
        or Color3.fromRGB(255, 100, 220)

    Button.BorderSizePixel = 0

    Button.Text = data[1]
    Button.TextColor3 = Color3.new(1, 1, 1)
    Button.TextSize = 9
    Button.Font = Enum.Font.GothamBold

    Button.Parent = ColorPanel

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 6)
    Corner.Parent = Button

    Button.MouseButton1Click:Connect(function()

        if data[1] == "🌈" then

            Settings.Rainbow = true

        else

            Settings.Rainbow = false
            Settings.HitBoxColor = data[2]

            Fill.BackgroundColor3 =
                Settings.HitBoxColor
        end
    end)
end

local ColorOpen = false

ColorButton.MouseButton1Click:Connect(function()

    ColorOpen = not ColorOpen

    ColorPanel.Visible = ColorOpen

    if ColorOpen then

        Main.Size =
            UDim2.fromOffset(285, 275)

    else

        Main.Size =
            UDim2.fromOffset(285, 245)

    end
end)

local function GetColor()

    if Settings.Rainbow then

        return Color3.fromHSV(
            (os.clock() % 5) / 5,
            1,
            1
        )
    end

    return Settings.HitBoxColor
end

local function IsEnemy(player)

    if player == LocalPlayer then
        return false
    end

    -- Không có Team thì coi là người chơi khác
    if LocalPlayer.Team == nil
    or player.Team == nil then

        return true
    end

    return player.Team ~= LocalPlayer.Team
end
--========================================================
-- 👑 QUOC ANH HITBOX
-- PART 4/5
-- HITBOX + ESP + RESPAWN
--========================================================

local function ApplyHitBox(character)

    if not character then
        return
    end

    if character == LocalPlayer.Character then
        return
    end

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    local root =
        character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root then
        return
    end

    if humanoid.Health <= 0 then
        return
    end

    pcall(function()

        -- Giữ nguyên cách xử lý HitBox
        root.Size = Vector3.new(
            Settings.HeadSize,
            Settings.HeadSize,
            Settings.HeadSize
        )

        -- Mờ hơn để nhìn thấy nhân vật
        root.Transparency =
            Settings.Transparency

        root.Color =
            GetColor()

        root.Material =
            Enum.Material.Neon

        root.CanCollide = false

    end)
end

local function ApplyESP(character)

    if not character then
        return
    end

    if character == LocalPlayer.Character then
        return
    end

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    if not humanoid then
        return
    end

    if humanoid.Health <= 0 then
        return
    end

    local old =
        character:FindFirstChild("QuocAnhESP")

    if old then
        old:Destroy()
    end

    local Highlight =
        Instance.new("Highlight")

    Highlight.Name =
        "QuocAnhESP"

    Highlight.DepthMode =
        Enum.HighlightDepthMode.AlwaysOnTop

    Highlight.FillTransparency = 0.85
    Highlight.OutlineTransparency = 0

    Highlight.FillColor =
        GetColor()

    Highlight.OutlineColor =
        GetColor()

    Highlight.Parent =
        character
end

local function RemoveESP(character)

    if not character then
        return
    end

    local old =
        character:FindFirstChild("QuocAnhESP")

    if old then
        old:Destroy()
    end
end

local function UpdatePlayer(player)

    if player == LocalPlayer then
        return
    end

    -- Đồng đội không bị HitBox/ESP
    if not IsEnemy(player) then

        if player.Character then
            RemoveESP(player.Character)
        end

        return
    end

    local character =
        player.Character

    if not character then
        return
    end

    if Settings.Enabled then
        ApplyHitBox(character)
    end

    if Settings.ESPEnabled then
        ApplyESP(character)
    else
        RemoveESP(character)
    end
end

local function SetupPlayer(player)

    if player == LocalPlayer then
        return
    end

    player.CharacterAdded:Connect(function(character)

        local humanoid =
            character:WaitForChild(
                "Humanoid",
                10
            )

        local root =
            character:WaitForChild(
                "HumanoidRootPart",
                10
            )

        if not humanoid or not root then
            return
        end

        task.wait(0.1)

        -- Áp lại ngay khi spawn
        UpdatePlayer(player)

        task.wait(0.2)

        -- Kiểm tra lại để tránh game reset Part
        if player.Character == character then
            UpdatePlayer(player)
        end

    end)

    if player.Character then

        task.defer(function()

            task.wait(0.1)

            UpdatePlayer(player)

        end)

    end
end

for _, player in ipairs(
    Players:GetPlayers()
) do

    SetupPlayer(player)

end

Players.PlayerAdded:Connect(function(player)

    SetupPlayer(player)

end)

Players.PlayerRemoving:Connect(function(player)

    if player.Character then
        RemoveESP(player.Character)
    end

end)
--========================================================
-- 👑 QUOC ANH HITBOX
-- PART 5/5
-- MENU OPEN/CLOSE + UPDATE + RAINBOW
--========================================================

local MenuOpen = false

local function OpenMenu()

    MenuOpen = true
    Main.Visible = true

    Main.Size =
        UDim2.fromOffset(250, 215)

    local targetSize

    if ColorOpen then
        targetSize =
            UDim2.fromOffset(285, 275)
    else
        targetSize =
            UDim2.fromOffset(285, 245)
    end

    TweenService:Create(
        Main,
        TweenInfo.new(
            0.28,
            Enum.EasingStyle.Back,
            Enum.EasingDirection.Out
        ),
        {
            Size = targetSize
        }
    ):Play()

    TweenService:Create(
        OpenButton,
        TweenInfo.new(0.2),
        {
            Rotation = 90
        }
    ):Play()
end

local function CloseMenu()

    MenuOpen = false

    TweenService:Create(
        Main,
        TweenInfo.new(
            0.18,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.In
        ),
        {
            Size =
                UDim2.fromOffset(250, 215)
        }
    ):Play()

    TweenService:Create(
        OpenButton,
        TweenInfo.new(0.2),
        {
            Rotation = 0
        }
    ):Play()

    task.delay(0.18, function()

        if not MenuOpen then
            Main.Visible = false
        end

    end)
end

OpenButton.MouseButton1Click:Connect(function()

    if MenuOpen then
        CloseMenu()
    else
        OpenMenu()
    end

end)

CloseButton.MouseButton1Click:Connect(function()

    if MenuOpen then
        CloseMenu()
    end

end)

--========================================================
-- UPDATE PLAYER
--========================================================

local UpdateTimer = 0

RunService.Heartbeat:Connect(function(dt)

    UpdateTimer += dt

    if UpdateTimer < 0.15 then
        return
    end

    UpdateTimer = 0

    if not Settings.Enabled
    and not Settings.ESPEnabled then
        return
    end

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer then
            UpdatePlayer(player)
        end

    end

end)

--========================================================
-- RAINBOW
--========================================================

RunService.RenderStepped:Connect(function()

    if not Settings.Rainbow then
        return
    end

    local color = GetColor()

    Fill.BackgroundColor3 = color

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer
        and IsEnemy(player)
        and player.Character then

            local character =
                player.Character

            local humanoid =
                character:FindFirstChildOfClass(
                    "Humanoid"
                )

            local root =
                character:FindFirstChild(
                    "HumanoidRootPart"
                )

            if humanoid
            and humanoid.Health > 0 then

                if Settings.Enabled
                and root then

                    root.Color = color

                end

                local esp =
                    character:FindFirstChild(
                        "QuocAnhESP"
                    )

                if esp then

                    esp.FillColor = color
                    esp.OutlineColor = color

                end

            end
        end
    end

end)

--========================================================
-- INITIAL
--========================================================

Settings.Enabled = false
Settings.ESPEnabled = false

ToggleAnimation(
    HitBoxToggle,
    HitBoxKnob,
    false
)

ToggleAnimation(
    ESPToggle,
    ESPKnob,
    false
)

print("👑 Quoc Anh HitBox loaded successfully")
