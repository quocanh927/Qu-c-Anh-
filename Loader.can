SizeLabel.Size = UDim2.new(1, -30, 0, 25)
SizeLabel.Position = UDim2.fromOffset(15, 123)
SizeLabel.BackgroundTransparency = 1
SizeLabel.Text = "HitBox Size     50"
SizeLabel.TextColor3 = Color3.new(1, 1, 1)
SizeLabel.TextSize = 14
SizeLabel.Font = Enum.Font.GothamBold
SizeLabel.TextXAlignment = Enum.TextXAlignment.Left
SizeLabel.Parent = Main

local Slider = Instance.new("TextButton")
Slider.Size = UDim2.new(1, -30, 0, 8)
Slider.Position = UDim2.fromOffset(15, 151)
Slider.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
Slider.BorderSizePixel = 0
Slider.Text = ""
Slider.AutoButtonColor = false
Slider.Parent = Main

local SliderCorner = Instance.new("UICorner")
SliderCorner.CornerRadius = UDim.new(1, 0)
SliderCorner.Parent = Slider

local Fill = Instance.new("Frame")
Fill.Size = UDim2.new(1, 0, 1, 0)
Fill.BackgroundColor3 = Settings.HitBoxColor
Fill.BorderSizePixel = 0
Fill.Parent = Slider

local FillCorner = Instance.new("UICorner")
FillCorner.CornerRadius = UDim.new(1, 0)
FillCorner.Parent = Fill

local Sliding = false

local function SetSizeFromX(x)

    local width = Slider.AbsoluteSize.X

    if width <= 0 then
        return
    end

    local percent = math.clamp(
        (x - Slider.AbsolutePosition.X) / width,
        0,
        1
    )

    Settings.HeadSize =
        math.floor(1 + percent * 49 + 0.5)

    Fill.Size =
        UDim2.new(percent, 0, 1, 0)

    SizeLabel.Text =
        "HitBox Size     "
        .. tostring(Settings.HeadSize)
end

Slider.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        Sliding = true
        SetSizeFromX(input.Position.X)
    end
end)

UserInputService.InputChanged:Connect(function(input)

    if not Sliding then
        return
    end

    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then

        SetSizeFromX(input.Position.X)
    end
end)

UserInputService.InputEnded:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        Sliding = false
    end
end)

HitBoxToggle.MouseButton1Click:Connect(function()

    Settings.Enabled = not Settings.Enabled

    ToggleAnimation(
        HitBoxToggle,
        HitBoxKnob,
        Settings.Enabled
    )
end)

ESPToggle.MouseButton1Click:Connect(function()

    Settings.ESPEnabled = not Settings.ESPEnabled

    ToggleAnimation(
        ESPToggle,
        ESPKnob,
        Settings.ESPEnabled
    )
end)

ToggleAnimation(
    HitBoxToggle,
    HitBoxKnob,
    false
)

ToggleAnimation(
    ESPToggle,
    ESPKnob,
    false
)
