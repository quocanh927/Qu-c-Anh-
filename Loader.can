        BackgroundTransparency = 1,
        Position = UDim2.new(0.5, 0, 0.8, 0)
    }):Play()
    TweenService:Create(MainScale, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Scale = 0.5
    }):Play()
    task.delay(0.4, function()
        ScreenGui:Destroy()
    end)
end)

