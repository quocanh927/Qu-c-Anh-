-- Jump Boost
local originalJumpPower = 50
local jumpSliderObj, jumpLabel, jumpFill, jumpMin, jumpMax

local jumpToggle = CreateToggle("Jump Boost", "Tăng lực nhảy", function(state)
	if state then
		if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
			originalJumpPower = LocalPlayer.Character.Humanoid.JumpPower
			local val = tonumber(string.match(jumpLabel.Text, "%d+")) or 100
			LocalPlayer.Character.Humanoid.JumpPower = val
		end
		jumpSliderObj.Visible = true
	else
		if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
			LocalPlayer.Character.Humanoid.JumpPower = originalJumpPower
		end
		jumpSliderObj.Visible = false
	end
end)
jumpSliderObj, jumpLabel, jumpFill, jumpMin, jumpMax = CreateSlider("Jump Power", 50, 300, 100)
jumpSliderObj.Visible = false

-- HITBOX (giữ nguyên code bạn đưa, chỉ thay màu qua _G.HitboxColor)
_G.HeadSize = 50
_G.HitboxColor = "Really blue"
_G.HitboxEnabled = false

local hitboxRunConnection = nil
local hitboxToggle = CreateToggle("Hitbox Player", "Tăng hitbox người chơi", function(state)
	_G.HitboxEnabled = state
	if state then
		-- Chạy vòng lặp của bạn
		if hitboxRunConnection then hitboxRunConnection:Disconnect() end
		hitboxRunConnection = RunService.RenderStepped:Connect(function()
			if _G.HitboxEnabled then
				for i,v in next, Players:GetPlayers() do
					if v ~= LocalPlayer then
						pcall(function()
							local root = v.Character and v.Character:FindFirstChild("HumanoidRootPart")
							if root then
								root.Size = Vector3.new(_G.HeadSize, _G.HeadSize, _G.HeadSize)
								root.Transparency = 0.7
								root.BrickColor = BrickColor.new(_G.HitboxColor)
								root.Material = Enum.Material.Neon
								root.CanCollide = false
							end
						end)
					end
				end
			end
		end)
	else
		-- Tắt và khôi phục kích thước (tùy chọn)
		if hitboxRunConnection then hitboxRunConnection:Disconnect(); hitboxRunConnection = nil end
		-- Khôi phục kích thước gốc cho người chơi
		for i,v in next, Players:GetPlayers() do
			if v ~= LocalPlayer then
				pcall(function()
					local root = v.Character and v.Character:FindFirstChild("HumanoidRootPart")
					if root then
						root.Size = Vector3.new(2, 2, 1) -- kích thước mặc định
						root.Transparency = 0
						root.BrickColor = BrickColor.new("White")
						root.Material = Enum.Material.Plastic
						root.CanCollide = true
					end
				end)
			end
		end
	end
end)

