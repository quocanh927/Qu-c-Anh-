-- Lưu trữ các highlight cho ESP
local espHighlights = {}
local espMobHighlights = {}

-- Hàm tạo Highlight
local function createHighlight(part, color)
	local h = Instance.new("Highlight")
	h.Adornee = part
	h.FillColor = color or Color3.fromRGB(255,0,0)
	h.FillTransparency = 0.5
	h.OutlineColor = Color3.fromRGB(255,255,255)
	h.OutlineTransparency = 0.2
	h.Parent = part
	return h
end

-- ESP Player
local espPlayerToggle = CreateToggle("ESP Player", "Hiện người chơi", function(state)
	if state then
		-- Thêm highlight cho tất cả người chơi khác
		for _, plr in pairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
				if not espHighlights[plr] then
					local h = createHighlight(plr.Character.HumanoidRootPart, Color3.fromRGB(0, 255, 0))
					espHighlights[plr] = h
				end
			end
		end
		-- Xử lý người mới vào
		Players.PlayerAdded:Connect(function(plr)
			if espPlayerToggle._toggled then
				plr.CharacterAdded:Connect(function(char)
					task.wait(0.5)
					if char and char:FindFirstChild("HumanoidRootPart") and espPlayerToggle._toggled then
						if not espHighlights[plr] then
							local h = createHighlight(char.HumanoidRootPart, Color3.fromRGB(0,255,0))
							espHighlights[plr] = h
						end
					end
				end)
			end
		end)
	else
		-- Xóa highlight
		for plr, h in pairs(espHighlights) do
			h:Destroy()
		end
		espHighlights = {}
	end
end)
espPlayerToggle._toggled = false
-- lưu trạng thái để dùng trong connection
local espPlayerState = false
espPlayerToggle._toggled = false

-- ESP Mob
local espMobToggle = CreateToggle("ESP Mob", "Hiện quái vật", function(state)
	if state then
		-- Quét tất cả model có Humanoid và không phải người chơi
		local function scanMobs()
			for _, obj in pairs(workspace:GetDescendants()) do
				if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and not Players:GetPlayerFromCharacter(obj) then
					if obj:FindFirstChild("HumanoidRootPart") and not espMobHighlights[obj] then
						local h = createHighlight(obj.HumanoidRootPart, Color3.fromRGB(255, 0, 0))
						espMobHighlights[obj] = h
					end
				end
			end
		end
		scanMobs()
		-- Quét định kỳ
		local conn
		conn = RunService.Heartbeat:Connect(function()
			if espMobToggle._toggled then
				scanMobs()
			else
				conn:Disconnect()
			end
		end)
	else
		for obj, h in pairs(espMobHighlights) do
			h:Destroy()
		end
		espMobHighlights = {}
	end
end)
espMobToggle._toggled = false

-- Fullbright
local fullbrightToggle = CreateToggle("Fullbright", "Sáng toàn bản đồ", function(state)
	if state then
		Lighting.Brightness = 5
		Lighting.Ambient = Color3.fromRGB(255,255,255)
		Lighting.OutdoorAmbient = Color3.fromRGB(255,255,255)
	else
		Lighting.Brightness = 2
		Lighting.Ambient = Color3.fromRGB(127,127,127)
		Lighting.OutdoorAmbient = Color3.fromRGB(127,127,127)
	end
end)
-- ===== PHẦN 5/7 =====
local originalWalkSpeed = 16
local speedSliderObj, speedLabel, speedFill, speedMin, speedMax

local speedToggle = CreateToggle("Speed", "Tăng tốc độ di chuyển", function(state)
	if state then
		-- Lưu speed gốc nếu chưa lưu
		if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
			originalWalkSpeed = LocalPlayer.Character.Humanoid.WalkSpeed
		end
		-- Áp dụng giá trị từ slider
		local val = speedSliderObj and tonumber(string.match(speedLabel.Text, "%d+")) or 100
		if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
			LocalPlayer.Character.Humanoid.WalkSpeed = val
		end
		speedSliderObj.Visible = true
	else
		-- Khôi phục speed gốc
		if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
			LocalPlayer.Character.Humanoid.WalkSpeed = originalWalkSpeed
		end
		speedSliderObj.Visible = false
	end
end)
speedSliderObj, speedLabel, speedFill, speedMin, speedMax = CreateSlider("Speed Value", 16, 300, 100)
speedSliderObj.Visible = false

-- Cập nhật speed khi kéo slider
-- Ta sẽ thêm sự kiện cho slider bằng cách tạo một hàm riêng
local function updateSpeed(value)
	if speedToggle._toggled then
		if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
			LocalPlayer.Character.Humanoid.WalkSpeed = value
		end
	end
end
