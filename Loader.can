--========================================================
-- 👑 QUOC ANH MENU
-- PART 1/5
-- GUI + DRAG + OPEN/CLOSE
--========================================================

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer

local Gui = Instance.new("ScreenGui")
Gui.Name = "QuocAnhHitBox"
Gui.ResetOnSpawn = false
Gui.IgnoreGuiInset = true
Gui.Parent = Player:WaitForChild("PlayerGui")

local OpenButton = Instance.new("TextButton")
OpenButton.Size = UDim2.fromOffset(54,54)
OpenButton.Position = UDim2.new(0,18,0.5,-27)
OpenButton.BackgroundColor3 = Color3.fromRGB(25,25,25)
OpenButton.BorderSizePixel = 0
OpenButton.Text = "👑"
OpenButton.TextSize = 23
OpenButton.AutoButtonColor = false
OpenButton.Parent = Gui

Instance.new("UICorner",OpenButton).CornerRadius = UDim.new(1,0)

local OpenStroke = Instance.new("UIStroke",OpenButton)
OpenStroke.Color = Color3.fromRGB(255,210,45)
OpenStroke.Thickness = 2

local Menu = Instance.new("Frame")
Menu.Size = UDim2.fromOffset(285,330)
Menu.Position = UDim2.new(0.5,-142,0.5,-165)
Menu.BackgroundColor3 = Color3.fromRGB(20,20,20)
Menu.BorderSizePixel = 0
Menu.Visible = false
Menu.Parent = Gui

Instance.new("UICorner",Menu).CornerRadius = UDim.new(0,13)

local MenuStroke = Instance.new("UIStroke",Menu)
MenuStroke.Color = Color3.fromRGB(255,210,45)
MenuStroke.Thickness = 2

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1,-55,0,45)
Title.Position = UDim2.fromOffset(10,2)
Title.BackgroundTransparency = 1
Title.Text = "👑 Quoc Anh HitBox"
Title.TextColor3 = Color3.fromRGB(255,210,45)
Title.TextSize = 18
Title.Font = Enum.Font.GothamBold
Title.Parent = Menu

local Close = Instance.new("TextButton")
Close.Size = UDim2.fromOffset(32,32)
Close.Position = UDim2.new(1,-40,0,7)
Close.BackgroundColor3 = Color3.fromRGB(45,45,45)
Close.BorderSizePixel = 0
Close.Text = "×"
Close.TextColor3 = Color3.new(1,1,1)
Close.TextSize = 22
Close.Parent = Menu

Instance.new("UICorner",Close).CornerRadius = UDim.new(1,0)

local dragging = false
local dragStart
local startPos

Title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = Menu.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not dragging then return end

    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then

        local delta = input.Position - dragStart

        Menu.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

local opened = false

local function ShowMenu()
    opened = true
    Menu.Visible = true
    Menu.Size = UDim2.fromOffset(245,285)

    TweenService:Create(
        Menu,
        TweenInfo.new(.25,Enum.EasingStyle.Back),
        {Size = UDim2.fromOffset(285,330)}
    ):Play()
end

local function HideMenu()
    opened = false

    TweenService:Create(
        Menu,
        TweenInfo.new(.18),
        {Size = UDim2.fromOffset(245,285)}
    ):Play()

    task.delay(.18,function()
        if not opened then
            Menu.Visible = false
        end
    end)
end

OpenButton.Activated:Connect(function()
    if opened then
        HideMenu()
    else
        ShowMenu()
    end
end)

Close.Activated:Connect(HideMenu)
--========================================================
-- PART 2/5
-- TOGGLE HITBOX + ESP
--========================================================

local Settings = {
    HitBox = false,
    ESP = false,
    Size = 10,
    Color = Color3.fromRGB(255,210,45),
    Rainbow = false
}

local function MakeToggle(y,text)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1,-85,0,40)
    label.Position = UDim2.fromOffset(15,y)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.new(1,1,1)
    label.TextSize = 14
    label.Font = Enum.Font.GothamBold
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = Menu

    local button = Instance.new("TextButton")
    button.Size = UDim2.fromOffset(52,28)
    button.Position = UDim2.new(1,-68,0,y+6)
    button.BackgroundColor3 = Color3.fromRGB(60,60,60)
    button.BorderSizePixel = 0
    button.Text = ""
    button.Parent = Menu

    Instance.new("UICorner",button).CornerRadius = UDim.new(1,0)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(22,22)
    knob.Position = UDim2.fromOffset(3,3)
    knob.BackgroundColor3 = Color3.fromRGB(245,245,245)
    knob.BorderSizePixel = 0
    knob.Parent = button

    Instance.new("UICorner",knob).CornerRadius = UDim.new(1,0)

    return button,knob
end

local HitToggle,HitKnob =
    MakeToggle(55,"HitBox")

local ESPToggle,ESPKnob =
    MakeToggle(100,"ESP")

local function AnimateToggle(button,knob,state)

    TweenService:Create(
        button,
        TweenInfo.new(.2),
        {
            BackgroundColor3 =
                state
                and Color3.fromRGB(255,195,35)
                or Color3.fromRGB(60,60,60)
        }
    ):Play()

    TweenService:Create(
        knob,
        TweenInfo.new(.25,Enum.EasingStyle.Back),
        {
            Position =
                state
                and UDim2.new(1,-25,0,3)
                or UDim2.fromOffset(3,3)
        }
    ):Play()
end

HitToggle.Activated:Connect(function()
    Settings.HitBox = not Settings.HitBox
    AnimateToggle(HitToggle, HitKnob, Settings.HitBox)
    
    if not Settings.HitBox then
        for _, v in ipairs(Players:GetPlayers()) do
            if v ~= Player then
                pcall(function()
                    local root = v.Character and v.Character:FindFirstChild("HumanoidRootPart")
                    if root then
                        root.Size = Vector3.new(2, 2, 1)
                        root.Transparency = 0
                        root.BrickColor = BrickColor.new("Medium stone grey")
                        root.Material = "Plastic"
                        root.CanCollide = true
                    end
                end)
            end
        end
    end
end)

ESPToggle.Activated:Connect(function()
    Settings.ESP = not Settings.ESP
    AnimateToggle(ESPToggle, ESPKnob, Settings.ESP)
    
    if not Settings.ESP then
        for _, obj in pairs(espObjects) do
            pcall(function() obj:Destroy() end)
        end
        espObjects = {}
    end
end)
--========================================================
-- PART 3/5
-- SIZE 1-50
--========================================================

local SizeLabel = Instance.new("TextLabel")
SizeLabel.Size = UDim2.new(1,-30,0,30)
SizeLabel.Position = UDim2.fromOffset(15,145)
SizeLabel.BackgroundTransparency = 1
SizeLabel.Text = "📏 Size: 10"
SizeLabel.TextColor3 = Color3.new(1,1,1)
SizeLabel.TextSize = 14
SizeLabel.Font = Enum.Font.GothamBold
SizeLabel.TextXAlignment = Enum.TextXAlignment.Left
SizeLabel.Parent = Menu

local Slider = Instance.new("TextButton")
Slider.Size = UDim2.new(1,-30,0,8)
Slider.Position = UDim2.fromOffset(15,177)
Slider.BackgroundColor3 = Color3.fromRGB(55,55,55)
Slider.BorderSizePixel = 0
Slider.Text = ""
Slider.Parent = Menu

Instance.new("UICorner",Slider).CornerRadius = UDim.new(1,0)

local Fill = Instance.new("Frame")
Fill.Size = UDim2.new((Settings.Size-1)/49,0,1,0)
Fill.BackgroundColor3 = Settings.Color
Fill.BorderSizePixel = 0
Fill.Parent = Slider

Instance.new("UICorner",Fill).CornerRadius = UDim.new(1,0)

local sliding = false

local function SetSize(x)

    local width = Slider.AbsoluteSize.X

    if width <= 0 then return end

    local percent = math.clamp(
        (x-Slider.AbsolutePosition.X)/width,
        0,
        1
    )

    Settings.Size =
        math.floor(1+percent*49+0.5)

    Fill.Size =
        UDim2.new(percent,0,1,0)

    SizeLabel.Text =
        "📏 Size: "..Settings.Size
end

Slider.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        sliding = true
        SetSize(input.Position.X)

    end
end)

UserInputService.InputChanged:Connect(function(input)

    if not sliding then return end

    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then

        SetSize(input.Position.X)

    end
end)

UserInputService.InputEnded:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        sliding = false

    end
end)
