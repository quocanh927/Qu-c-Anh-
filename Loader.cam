	if not States.InfJump then
		return
	end

	local character = LocalPlayer.Character
	if not character then
		return
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	if humanoid then
		humanoid:ChangeState(
			Enum.HumanoidStateType.Jumping
		)
	end
end)

local speedSlider

CreateToggle(
