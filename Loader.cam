-- Rainbow chạy liên tục cho các đối tượng đang chọn
RunService.RenderStepped:Connect(function()
	if HitboxRainbow then
		local c = Color3.fromHSV(
			(os.clock() * .5) % 1,
			.9,
			1
		)

		for _,part in ipairs(HitboxParts) do
			if part and part.Parent then
				part.Color = c
			end
		end
	end

	if ESPPlayerRainbow or ESPMobRainbow then
		local c = Color3.fromHSV(
			(os.clock() * .5) % 1,
			.9,
			1
		)

		for _,obj in ipairs(ESPObjects) do
			if obj and obj.Parent then
				obj.FillColor = c
				obj.OutlineColor = c
			end
		end
	end
end)

-- Tự cập nhật khi người chơi respawn
Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function()
		task.wait(.5)

		if ESPPlayerEnabled then
			RefreshPlayerESP()
		end

		if HitboxEnabled then
			RefreshHitboxes()
		end
	end)
end)

LocalPlayer.CharacterAdded:Connect(function()
	task.wait(.5)

	if ESPPlayerEnabled then
		RefreshPlayerESP()
	end

	if HitboxEnabled then
		RefreshHitboxes()
	end
end)

print("QUOC ANH HUB loaded successfully.")
