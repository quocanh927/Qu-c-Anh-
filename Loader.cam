SpeedSlider.Visible = false

local JumpGroup = CreateGroup()
local JumpEnabled = false
local JumpValue = 100

CreateToggle(
	JumpGroup,
	"Jump Boost",
	"Tăng lực nhảy",
	function(state)
		JumpEnabled = state
	end
)

local JumpSlider = CreateSlider(
	JumpGroup,
	"Jump Power",
	50,
	300,
	100,
	function(value)
		JumpValue = value
	end
)

JumpSlider.Visible = false

RunService.RenderStepped:Connect(function()
	local character = LocalPlayer.Character
	if not character then
		return
	end

	local hum = character:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end

	if SpeedEnabled then
		hum.WalkSpeed = SpeedValue
	end

	if JumpEnabled then
		hum.JumpPower = JumpValue
	end
end)
--// PHẦN 7: HITBOX TEST PLAYER + NPC + RESPawn + RAINBOW UPDATE

local HitboxGroup = CreateGroup()

local HitboxEnabled = false
local HitboxSize = 20
local HitboxColor = Color3.fromRGB(0,120,255)
local HitboxRainbow = false

local HitboxParts = {}

local function ClearHitboxes()
	for _,part in ipairs(HitboxParts) do
		if part and part.Parent then
			part.Size = Vector3.new(2,2,1)
			part.Transparency = 1
			part.Material = Enum.Material.Plastic
		end
	end

	table.clear(HitboxParts)
end

local function ApplyHitbox(model)
	if not HitboxEnabled then
		return
	end

	local root = model:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end

	if model == LocalPlayer.Character then
		return
	end

	root.Size = Vector3.new(
		HitboxSize,
		HitboxSize,
		HitboxSize
	)

	root.Transparency = .7
	root.Material = Enum.Material.Neon
	root.CanCollide = false

	root.Color = HitboxColor

	table.insert(HitboxParts,root)
end

local function RefreshHitboxes()
	ClearHitboxes()

	if not HitboxEnabled then
		return
	end

	for _,player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			ApplyHitbox(player.Character)
		end
	end

	for _,model in ipairs(Workspace:GetDescendants()) do
		if model:IsA("Model")
		and model:FindFirstChildOfClass("Humanoid")
		and not Players:GetPlayerFromCharacter(model) then
			ApplyHitbox(model)
		end
	end
end

CreateToggle(
	HitboxGroup,
	"Hitbox Player + NPC",
	"Điều chỉnh vùng test",
	function(state)
		HitboxEnabled = state

		if state then
			RefreshHitboxes()
		else
			ClearHitboxes()
		end
	end
)

local HitboxSlider = CreateSlider(
	HitboxGroup,
	"Size Hitbox",
	1,
	100,
	20,
	function(value)
		HitboxSize = value

		if HitboxEnabled then
			RefreshHitboxes()
		end
	end
)

HitboxSlider.Visible = false

local HitboxPicker = CreateColorPicker(
	HitboxGroup,
	"Màu Hitbox",
	function(color)
		if color == "RAINBOW" then
			HitboxRainbow = true
		else
			HitboxRainbow = false
			HitboxColor = color
		end

		if HitboxEnabled then
			RefreshHitboxes()
		end
	end
)

HitboxPicker.Visible = false

-- Hiện tùy chỉnh NGAY BÊN DƯỚI Hitbox
local HitboxRow = HitboxGroup:GetChildren()[1]

if HitboxRow then
	local Switch = HitboxRow:FindFirstChildWhichIsA(
		"TextButton",
		true
	)

	if Switch then
		Switch.MouseButton1Click:Connect(function()
			task.wait()

			HitboxSlider.Visible = HitboxEnabled
			HitboxPicker.Visible = HitboxEnabled
		end)
	end
end

