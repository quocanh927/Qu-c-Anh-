local function SetPickerVisibility()

	-- ESP Player picker
	if espPlayerColor then
		espPlayerColor.Visible =
			States.ESPPlayer
	end

	-- ESP Mob picker
	if espMobColor then
		espMobColor.Visible =
			States.ESPMob
	end

end

task.spawn(function()

	while ScreenGui.Parent do

		SetPickerVisibility()

		task.wait(0.1)

	end

end)

