)

HitboxColorPicker.Visible = false
--========================================================
-- PART 6/7 - FULLBRIGHT + FIX LAG
--========================================================

local FullbrightEnabled = false
local SavedLighting = {}

local function SetFullbright(state)
	FullbrightEnabled = state

	if state then
		SavedLighting.Brightness = Lighting.Brightness
		SavedLighting.ClockTime = Lighting.ClockTime
		SavedLighting.FogEnd = Lighting.FogEnd
		SavedLighting.GlobalShadows = Lighting.GlobalShadows

		Lighting.Brightness = 3
		Lighting.ClockTime = 14
		Lighting.FogEnd = 100000
		Lighting.GlobalShadows = false
	else
		if SavedLighting.Brightness then
			Lighting.Brightness = SavedLighting.Brightness
		end

		if SavedLighting.ClockTime then
			Lighting.ClockTime = SavedLighting.ClockTime
		end

		if SavedLighting.FogEnd then
			Lighting.FogEnd = SavedLighting.FogEnd
		end

		if SavedLighting.GlobalShadows ~= nil then
			Lighting.GlobalShadows =
				SavedLighting.GlobalShadows
		end
	end
end

CreateToggle(
	"Fullbright",
	"Sáng toàn bản đồ",
	SetFullbright
)

local FixLagEnabled = false
local SavedEffects = {}

local function FixEffect(obj)
	if not (
		obj:IsA("ParticleEmitter")
		or obj:IsA("Trail")
		or obj:IsA("Beam")
		or obj:IsA("Smoke")
		or obj:IsA("Fire")
		or obj:IsA("Sparkles")
	) then
		return
	end

	if SavedEffects[obj] == nil then
		if obj:IsA("ParticleEmitter") then
			SavedEffects[obj] = {
				Enabled = obj.Enabled,
				Rate = obj.Rate
			}
		else
			SavedEffects[obj] = {
				Enabled = obj.Enabled
			}
		end
	end

	obj.Enabled = false

	if obj:IsA("ParticleEmitter") then
		obj.Rate = 0
	end
end

local function RestoreEffects()
	for obj,data in pairs(SavedEffects) do
		if obj and obj.Parent then
			obj.Enabled = data.Enabled

			if obj:IsA("ParticleEmitter")
			and data.Rate then
				obj.Rate = data.Rate
			end
		end
	end

	table.clear(SavedEffects)
end

local function SetFixLag(state)
	FixLagEnabled = state

	if state then
		for _,obj in ipairs(Workspace:GetDescendants()) do
			FixEffect(obj)
		end

		for _,obj in ipairs(Lighting:GetDescendants()) do
			FixEffect(obj)
		end

		pcall(function()
			Workspace.Terrain.Decoration = false
		end)

		pcall(function()
			Workspace.StreamingEnabled = true
		end)
	else
		RestoreEffects()

		pcall(function()
			Workspace.Terrain.Decoration = true
		end)
	end
end

CreateToggle(
	"Fix Lag",
	"Giảm hiệu ứng / chi tiết",
	SetFixLag
)

Workspace.DescendantAdded:Connect(function(obj)
	if FixLagEnabled then
		task.defer(function()
			FixEffect(obj)
		end)
	end
end)
--========================================================
-- PART 7/7 - UPDATE + RAINBOW FEATURES + CLEANUP
--========================================================

local lastRefresh = 0

RunService.Heartbeat:Connect(function()
	if os.clock() - lastRefresh < .35 then
		return
	end

	lastRefresh = os.clock()

	if ESPEnabled or ESPMobEnabled then
		RefreshESP()
	end

	if HitboxEnabled then
		RefreshHitbox()
	end
end)

RunService.RenderStepped:Connect(function()
	if ESPRainbow then
		local c = Color3.fromHSV(
			(os.clock() * .35) % 1,
			.9,
			1
		)

		for _,obj in pairs(ESPObjects) do
			if obj and obj.Parent then
				obj.FillColor = c
				obj.OutlineColor = c
			end
		end
	end

	if HitboxRainbow then
		local c = Color3.fromHSV(
			(os.clock() * .5) % 1,
			.9,
			1
		)

		for _,part in pairs(HitboxObjects) do
			if part and part.Parent then
				part.Color = c
			end
		end
	end
end)

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function()
		task.wait(.5)

		if ESPEnabled then
			RefreshESP()
		end

		if HitboxEnabled then
			RefreshHitbox()
		end
	end)
end)

Players.PlayerRemoving:Connect(function(player)
	if player.Character then
		RemoveESP(player.Character)
		RemoveHitbox(player.Character)
	end
end)

LocalPlayer.CharacterAdded:Connect(function()
	task.wait(1)

	ApplyMovement()

	if ESPEnabled or ESPMobEnabled then
		RefreshESP()
	end

	if HitboxEnabled then
		RefreshHitbox()
	end
end)

-- Cập nhật giao diện lần đầu
task.wait(.2)
RefreshESP()
RefreshHitbox()
ApplyMovement()

print("========================================")
print("       QUOC ANH HUB - LOADED")
