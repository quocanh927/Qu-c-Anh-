Scroll.BorderSizePixel = 0
Scroll.ScrollBarThickness = 3
Scroll.CanvasSize = UDim2.new()
Scroll.Parent = Main

local Layout = Instance.new("UIListLayout")
Layout.Padding = UDim.new(0,6)
Layout.SortOrder = Enum.SortOrder.LayoutOrder
Layout.Parent = Scroll

Layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
	Scroll.CanvasSize = UDim2.fromOffset(0,Layout.AbsoluteContentSize.Y + 10)
end)

local Order = 0

local function NextOrder()
	Order += 1
	return Order
end

local function MakeCorner(obj,r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0,r or 7)
	c.Parent = obj
	return c
end

local function MakeToggle(name,desc,callback)
	local Frame = Instance.new("Frame")
	Frame.Size = UDim2.new(1,-4,0,45)
	Frame.BackgroundColor3 = Color3.fromRGB(22,22,32)
	Frame.LayoutOrder = NextOrder()
	Frame.Parent = Scroll
	MakeCorner(Frame,8)

	local Name = Instance.new("TextLabel")
	Name.Size = UDim2.new(1,-65,0,20)
	Name.Position = UDim2.fromOffset(9,3)
	Name.BackgroundTransparency = 1
	Name.Text = name
	Name.TextSize = 11
	Name.Font = Enum.Font.GothamBold
	Name.TextColor3 = Color3.new(1,1,1)
	Name.TextXAlignment = Enum.TextXAlignment.Left
	Name.Parent = Frame

	local Desc = Instance.new("TextLabel")
	Desc.Size = UDim2.new(1,-65,0,16)
	Desc.Position = UDim2.fromOffset(9,22)
	Desc.BackgroundTransparency = 1
	Desc.Text = desc
	Desc.TextSize = 9
	Desc.Font = Enum.Font.Gotham
	Desc.TextColor3 = Color3.fromRGB(145,145,160)
	Desc.TextXAlignment = Enum.TextXAlignment.Left
	Desc.Parent = Frame

	local Button = Instance.new("TextButton")
	Button.Size = UDim2.fromOffset(42,21)
	Button.Position = UDim2.new(1,-51,0.5,-10)
	Button.Text = ""
	Button.AutoButtonColor = false
	Button.BackgroundColor3 = Color3.fromRGB(45,45,58)
	Button.Parent = Frame
	MakeCorner(Button,20)

	local Knob = Instance.new("Frame")
	Knob.Size = UDim2.fromOffset(15,15)
	Knob.Position = UDim2.fromOffset(3,3)
	Knob.BackgroundColor3 = Color3.fromRGB(220,220,225)
	Knob.Parent = Button
	MakeCorner(Knob,20)

	local State = false

	Button.MouseButton1Click:Connect(function()
		State = not State

		TweenService:Create(
			Knob,
			TweenInfo.new(0.18),
			{
				Position = State
					and UDim2.new(1,-18,0,3)
					or UDim2.fromOffset(3,3)
			}
		):Play()

		TweenService:Create(
			Button,
			TweenInfo.new(0.18),
			{
				BackgroundColor3 = State
					and Color3.fromRGB(170,0,255)
					or Color3.fromRGB(45,45,58)
			}
		):Play()

		if callback then
			callback(State)
		end
	end)

	return Frame
end
--// QA HUB - PART 2/7
--// ESP SYSTEM

local ESPPlayerEnabled = false
local ESPPlayerColor = Color3.fromRGB(255,0,0)
local ESPPlayerRainbow = false

local ESPMobEnabled = false
local ESPMobColor = Color3.fromRGB(0,180,255)
local ESPMobRainbow = false

local ESPObjects = {}

local RainbowColors = {
	Color3.fromRGB(255,0,0),
	Color3.fromRGB(255,255,0),
	Color3.fromRGB(0,255,0),
	Color3.fromRGB(0,255,255),
	Color3.fromRGB(0,100,255),
	Color3.fromRGB(170,0,255),
	Color3.fromRGB(255,0,200)
}

local function RainbowColor(speed)
	return Color3.fromHSV((os.clock() * speed) % 1,0.9,1)
end

local function RemoveESP(obj)
	local data = ESPObjects[obj]
	if data then
		if data.Highlight then
			data.Highlight:Destroy()
		end
		ESPObjects[obj] = nil
	end
end

local function AddESP(character,isPlayer)
	if not character or not character:IsA("Model") then
		return
	end

	if ESPObjects[character] then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end

	local highlight = Instance.new("Highlight")
	highlight.Name = "QA_ESP"
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.FillTransparency = 0.72
	highlight.OutlineTransparency = 0
	highlight.Parent = character

	ESPObjects[character] = {
		Highlight = highlight,
		IsPlayer = isPlayer
	}
end

local function RefreshESP()
	for character in pairs(ESPObjects) do
		if not character.Parent then
			RemoveESP(character)
		end
	end

	if ESPPlayerEnabled then
		for _,player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and player.Character then
				AddESP(player.Character,true)
			end
		end
	end

	if ESPMobEnabled then
		for _,obj in ipairs(workspace:GetDescendants()) do
			if obj:IsA("Model")
				and obj ~= LocalPlayer.Character
				and not Players:GetPlayerFromCharacter(obj)
				and obj:FindFirstChildOfClass("Humanoid") then

				AddESP(obj,false)
			end
		end
	end
end

local function UpdateESPColors()
	for character,data in pairs(ESPObjects) do
		if data.Highlight then
			local color

			if data.IsPlayer then
				color = ESPPlayerRainbow
					and RainbowColor(0.35)
					or ESPPlayerColor
			else
				color = ESPMobRainbow
					and RainbowColor(0.35)
					or ESPMobColor
			end

			data.Highlight.FillColor = color
			data.Highlight.OutlineColor = color
		end
	end
end

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function()
		task.wait(0.4)
		if ESPPlayerEnabled then
			AddESP(player.Character,true)
		end
	end)
end)

for _,player in ipairs(Players:GetPlayers()) do
	if player ~= LocalPlayer then
		player.CharacterAdded:Connect(function(character)
			task.wait(0.4)
			if ESPPlayerEnabled then
				AddESP(character,true)
			end
		end)
	end
end

workspace.DescendantAdded:Connect(function(obj)
	if not ESPMobEnabled then
		return
	end

	if obj:IsA("Model") then
		task.delay(0.2,function()
			if obj.Parent
				and obj:FindFirstChildOfClass("Humanoid")
				and not Players:GetPlayerFromCharacter(obj) then

				AddESP(obj,false)
			end
		end)
	end
end)

RunService.RenderStepped:Connect(function()
	UpdateESPColors()
end)
--// QA HUB - PART 3/7
--// COLOR PICKERS

local function MakeColorPicker(title,getColor,setColor,getRainbow,setRainbow)
	local Frame = Instance.new("Frame")
	Frame.Size = UDim2.new(1,-4,0,78)
	Frame.BackgroundColor3 = Color3.fromRGB(18,18,27)
	Frame.LayoutOrder = NextOrder()
	Frame.Visible = false
	Frame.Parent = Scroll
	MakeCorner(Frame,8)

	local Label = Instance.new("TextLabel")
	Label.Size = UDim2.new(1,-15,0,18)
	Label.Position = UDim2.fromOffset(8,4)
	Label.BackgroundTransparency = 1
	Label.Text = title
	Label.TextSize = 10
	Label.Font = Enum.Font.GothamBold
	Label.TextColor3 = Color3.fromRGB(205,205,220)
	Label.TextXAlignment = Enum.TextXAlignment.Left
	Label.Parent = Frame

	local Holder = Instance.new("Frame")
	Holder.Size = UDim2.new(1,-16,0,43)
	Holder.Position = UDim2.fromOffset(8,27)
	Holder.BackgroundTransparency = 1
	Holder.Parent = Frame

	local Grid = Instance.new("UIGridLayout")
	Grid.CellSize = UDim2.fromOffset(25,18)
	Grid.CellPadding = UDim2.fromOffset(5,5)
	Grid.Parent = Holder

	local Colors = {
		{"Đỏ",Color3.fromRGB(255,0,0)},
		{"Xanh lá",Color3.fromRGB(0,255,0)},
		{"Xanh dương",Color3.fromRGB(0,120,255)},
		{"Vàng",Color3.fromRGB(255,230,0)},
		{"Tím",Color3.fromRGB(170,0,255)},
		{"Hồng",Color3.fromRGB(255,80,190)},
		{"Trắng",Color3.fromRGB(255,255,255)},
		{"Cam",Color3.fromRGB(255,120,0)}
	}

	for _,info in ipairs(Colors) do
		local Button = Instance.new("TextButton")
		Button.Text = ""
		Button.BackgroundColor3 = info[2]
		Button.Parent = Holder
		MakeCorner(Button,5)

		Button.MouseButton1Click:Connect(function()
			setRainbow(false)
			setColor(info[2])
		end)
	end

	local RainbowButton = Instance.new("TextButton")
	RainbowButton.Text = "🌈"
	RainbowButton.TextSize = 12
	RainbowButton.Font = Enum.Font.GothamBold
	RainbowButton.TextColor3 = Color3.new(1,1,1)
	RainbowButton.BackgroundColor3 = Color3.fromRGB(255,255,255)
	RainbowButton.Parent = Holder
	MakeCorner(RainbowButton,5)

	local RainbowGradient = Instance.new("UIGradient")
	RainbowGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0,Color3.fromRGB(255,0,0)),
		ColorSequenceKeypoint.new(0.25,Color3.fromRGB(255,255,0)),
		ColorSequenceKeypoint.new(0.5,Color3.fromRGB(0,255,0)),
		ColorSequenceKeypoint.new(0.75,Color3.fromRGB(0,150,255)),
		ColorSequenceKeypoint.new(1,Color3.fromRGB(255,0,200))
	})
	RainbowGradient.Parent = RainbowButton

	RainbowButton.MouseButton1Click:Connect(function()
		setRainbow(true)
	end)

	return Frame
end

local PlayerColorPicker = MakeColorPicker(
	"Màu ESP Player",
	function() return ESPPlayerColor end,
	function(c) ESPPlayerColor = c end,
	function() return ESPPlayerRainbow end,
	function(v) ESPPlayerRainbow = v end
)

local MobColorPicker = MakeColorPicker(
	"Màu ESP Mob",
	function() return ESPMobColor end,
	function(c) ESPMobColor = c end,
	function() return ESPMobRainbow end,
	function(v) ESPMobRainbow = v end
)

MakeToggle("ESP Player","Hiện người chơi",function(state)
	ESPPlayerEnabled = state
	PlayerColorPicker.Visible = state

	if state then
		RefreshESP()
	else
		for character,data in pairs(ESPObjects) do
			if data.IsPlayer then
				RemoveESP(character)
			end
		end
	end
end)

MakeToggle("ESP Mob","Hiện NPC/quái",function(state)
	ESPMobEnabled = state
	MobColorPicker.Visible = state

	if state then
		RefreshESP()
	else
		for character,data in pairs(ESPObjects) do
			if not data.IsPlayer then
				RemoveESP(character)
			end
		end
	end
end)
--// QA HUB - PART 4/7
--// SPEED + JUMP BOOST

local SpeedEnabled = false
local SpeedValue = 100

local JumpEnabled = false
local JumpValue = 100

local function GetHumanoid()
	local character = LocalPlayer.Character
	if not character then return nil end
	return character:FindFirstChildOfClass("Humanoid")
end

local function ApplyMovement()
	local humanoid = GetHumanoid()
	if not humanoid then return end

	if SpeedEnabled then
		humanoid.WalkSpeed = SpeedValue
	else
		humanoid.WalkSpeed = 16
	end

	if JumpEnabled then
		humanoid.UseJumpPower = true
		humanoid.JumpPower = JumpValue
	else
		humanoid.UseJumpPower = true
		humanoid.JumpPower = 50
	end
end

local function MakeSlider(title,min,max,default,callback)
	local Frame = Instance.new("Frame")
	Frame.Size = UDim2.new(1,-4,0,48)
	Frame.BackgroundColor3 = Color3.fromRGB(18,18,27)
	Frame.LayoutOrder = NextOrder()
	Frame.Visible = false
	Frame.Parent = Scroll
	MakeCorner(Frame,7)

	local Label = Instance.new("TextLabel")
	Label.Size = UDim2.new(1,-15,0,18)
	Label.Position = UDim2.fromOffset(8,3)
	Label.BackgroundTransparency = 1
	Label.Text = title..": "..default
	Label.TextSize = 10
	Label.Font = Enum.Font.GothamBold
	Label.TextColor3 = Color3.fromRGB(205,205,220)
	Label.TextXAlignment = Enum.TextXAlignment.Left
	Label.Parent = Frame

	local Track = Instance.new("TextButton")
	Track.Size = UDim2.new(1,-16,0,8)
	Track.Position = UDim2.fromOffset(8,29)
	Track.Text = ""
	Track.AutoButtonColor = false
	Track.BackgroundColor3 = Color3.fromRGB(48,48,62)
	Track.Parent = Frame
	MakeCorner(Track,8)

	local Fill = Instance.new("Frame")
	Fill.Size = UDim2.new((default-min)/(max-min),0,1,0)
	Fill.BackgroundColor3 = Color3.fromRGB(170,0,255)
	Fill.Parent = Track
	MakeCorner(Fill,8)

	local dragging = false

	local function Update(input)
		local x = math.clamp(
			(input.Position.X - Track.AbsolutePosition.X)
			/ Track.AbsoluteSize.X,
			0,1
		)

		local value = math.floor(min + (max-min)*x)
		Fill.Size = UDim2.new(x,0,1,0)
		Label.Text = title..": "..value

		callback(value)
	end

	Track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = true
			Update(input)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (
			input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		) then
			Update(input)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = false
		end
	end)

	return Frame
end

local SpeedSlider = MakeSlider(
	"Speed",
	16,
	300,
	100,
	function(value)
		SpeedValue = value
		ApplyMovement()
	end
)

local JumpSlider = MakeSlider(
	"Jump Power",
	50,
	300,
	100,
	function(value)
		JumpValue = value
		ApplyMovement()
	end
)

MakeToggle("Speed","Tăng tốc độ di chuyển",function(state)
	SpeedEnabled = state
	SpeedSlider.Visible = state
	ApplyMovement()
end)

MakeToggle("Jump Boost","Tăng lực nhảy",function(state)
	JumpEnabled = state
	JumpSlider.Visible = state
	ApplyMovement()
end)

LocalPlayer.CharacterAdded:Connect(function()
	task.wait(0.5)
	ApplyMovement()
end)
--// QA HUB - PART 5/7
--// NOCLIP + INFJUMP + FULLBRIGHT

local NoclipEnabled = false
local InfJumpEnabled = false
local FullbrightEnabled = false

local OriginalLighting = {
	Brightness = Lighting.Brightness,
	ClockTime = Lighting.ClockTime,
	FogEnd = Lighting.FogEnd,
	GlobalShadows = Lighting.GlobalShadows,
	Ambient = Lighting.Ambient,
	OutdoorAmbient = Lighting.OutdoorAmbient
}

MakeToggle("Noclip","Đi xuyên vật thể trong map",function(state)
	NoclipEnabled = state
end)

RunService.Stepped:Connect(function()
	if not NoclipEnabled then
		return
	end

	local character = LocalPlayer.Character
	if not character then return end

	for _,obj in ipairs(character:GetDescendants()) do
		if obj:IsA("BasePart") then
			obj.CanCollide = false
		end
	end
end)

MakeToggle("InfJump","Nhảy liên tục",function(state)
	InfJumpEnabled = state
end)

UserInputService.JumpRequest:Connect(function()
	if not InfJumpEnabled then
		return
	end

	local humanoid = GetHumanoid()
	if humanoid then
		humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	end
end)

MakeToggle("Fullbright","Làm sáng toàn bản đồ",function(state)
	FullbrightEnabled = state

	if state then
		Lighting.Brightness = 3
		Lighting.ClockTime = 14
		Lighting.FogEnd = 100000
		Lighting.GlobalShadows = false
		Lighting.Ambient = Color3.fromRGB(255,255,255)
		Lighting.OutdoorAmbient = Color3.fromRGB(255,255,255)
	else
		Lighting.Brightness = OriginalLighting.Brightness
		Lighting.ClockTime = OriginalLighting.ClockTime
		Lighting.FogEnd = OriginalLighting.FogEnd
		Lighting.GlobalShadows = OriginalLighting.GlobalShadows
		Lighting.Ambient = OriginalLighting.Ambient
		Lighting.OutdoorAmbient = OriginalLighting.OutdoorAmbient
	end
end)
--// QA HUB - PART 6/7
--// FIX LAG - CHỈ 1 NÚT

local FixLagEnabled = false
local SavedEffects = {}

local function SetEffectState(obj,state)
	if obj:IsA("ParticleEmitter")
		or obj:IsA("Trail")
		or obj:IsA("Beam")
		or obj:IsA("Smoke")
		or obj:IsA("Fire")
		or obj:IsA("Sparkles") then

		if SavedEffects[obj] == nil then
			SavedEffects[obj] = obj.Enabled
		end

		obj.Enabled = state
	end

	if obj:IsA("PostEffect") then
		if SavedEffects[obj] == nil then
			SavedEffects[obj] = obj.Enabled
		end

		obj.Enabled = state
	end
end

local function ApplyFixLag(state)
	FixLagEnabled = state

	if state then
		for _,obj in ipairs(workspace:GetDescendants()) do
			SetEffectState(obj,false)
		end

		for _,obj in ipairs(Lighting:GetChildren()) do
			SetEffectState(obj,false)
		end
	else
		for obj,oldState in pairs(SavedEffects) do
			if obj and obj.Parent then
				pcall(function()
					obj.Enabled = oldState
				end)
			end
		end

		table.clear(SavedEffects)
	end
end

MakeToggle(
	"Fix Lag",
	"Giảm hiệu ứng nặng, không có Nhẹ/Mạnh",
	function(state)
		ApplyFixLag(state)
	end
)

workspace.DescendantAdded:Connect(function(obj)
	if FixLagEnabled then
		task.defer(function()
			SetEffectState(obj,false)
		end)
	end
end)

Lighting.ChildAdded:Connect(function(obj)
	if FixLagEnabled then
		task.defer(function()
			SetEffectState(obj,false)
		end)
	end
end)
--// QA HUB - PART 7/7
--// HITBOX PLAYER + NPC + RAINBOW

local HitboxEnabled = false
local HitboxSize = 20
local HitboxColor = Color3.fromRGB(0,120,255)
local HitboxRainbow = false

local HitboxObjects = {}

local function IsNPC(model)
	if not model:IsA("Model") then
		return false
	end

	if Players:GetPlayerFromCharacter(model) then
		return false
	end

	return model:FindFirstChildOfClass("Humanoid") ~= nil
end

local function GetHitboxPart(model)
	if not model then return nil end

	return model:FindFirstChild("HumanoidRootPart")
		or model:FindFirstChild("UpperTorso")
		or model:FindFirstChild("Torso")
end

local function ApplyHitbox(model)
	if not HitboxEnabled then
		return
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = GetHitboxPart(model)

	if not humanoid or not root or not root:IsA("BasePart") then
		return
	end

	if Players:GetPlayerFromCharacter(model) == LocalPlayer then
		return
	end

	if not HitboxObjects[model] then
		HitboxObjects[model] = {
			Part = root,
			OriginalSize = root.Size,
			OriginalTransparency = root.Transparency,
			OriginalMaterial = root.Material
		}
	end

	root.Size = Vector3.new(
		HitboxSize,
		HitboxSize,
		HitboxSize
	)

	root.Transparency = 0.7
	root.Material = Enum.Material.Neon
	root.CanCollide = false

	local color = HitboxRainbow
		and RainbowColor(0.35)
		or HitboxColor

	root.Color = color
end

local function RestoreHitbox(model)
	local data = HitboxObjects[model]

	if not data then
		return
	end

	local part = data.Part

	if part and part.Parent then
		part.Size = data.OriginalSize
		part.Transparency = data.OriginalTransparency
		part.Material = data.OriginalMaterial
	end

	HitboxObjects[model] = nil
end

local function RefreshHitboxes()
	if not HitboxEnabled then
		return
	end

	for _,player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			ApplyHitbox(player.Character)
		end
	end

	for _,obj in ipairs(workspace:GetDescendants()) do
		if IsNPC(obj) then
			ApplyHitbox(obj)
		end
	end
end

local function MakeHitboxSizeSlider()
	local Frame = Instance.new("Frame")
	Frame.Size = UDim2.new(1,-4,0,48)
	Frame.BackgroundColor3 = Color3.fromRGB(18,18,27)
	Frame.LayoutOrder = NextOrder()
	Frame.Visible = false
	Frame.Parent = Scroll
	MakeCorner(Frame,7)

	local Label = Instance.new("TextLabel")
	Label.Size = UDim2.new(1,-15,0,18)
	Label.Position = UDim2.fromOffset(8,3)
	Label.BackgroundTransparency = 1
	Label.Text = "Hitbox Size: 20"
	Label.TextSize = 10
	Label.Font = Enum.Font.GothamBold
	Label.TextColor3 = Color3.fromRGB(205,205,220)
	Label.TextXAlignment = Enum.TextXAlignment.Left
	Label.Parent = Frame

	local Track = Instance.new("TextButton")
	Track.Size = UDim2.new(1,-16,0,8)
	Track.Position = UDim2.fromOffset(8,29)
	Track.Text = ""
	Track.AutoButtonColor = false
	Track.BackgroundColor3 = Color3.fromRGB(48,48,62)
	Track.Parent = Frame
	MakeCorner(Track,8)

	local Fill = Instance.new("Frame")
	Fill.Size = UDim2.new((20-1)/(100-1),0,1,0)
	Fill.BackgroundColor3 = Color3.fromRGB(170,0,255)
	Fill.Parent = Track
	MakeCorner(Fill,8)

	local dragging = false

	local function Update(input)
		local scale = math.clamp(
			(input.Position.X - Track.AbsolutePosition.X)
			/ Track.AbsoluteSize.X,
			0,1
		)

		HitboxSize = math.floor(1 + 99 * scale)

		Fill.Size = UDim2.new(scale,0,1,0)
		Label.Text = "Hitbox Size: "..HitboxSize

		RefreshHitboxes()
	end

	Track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = true
			Update(input)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (
			input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		) then
			Update(input)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = false
		end
	end)

	return Frame
end

local HitboxSlider = MakeHitboxSizeSlider()

local HitboxPicker = MakeColorPicker(
	"Màu Hitbox Player + NPC",
	function()
		return HitboxColor
	end,
	function(c)
		HitboxColor = c
	end,
	function()
		return HitboxRainbow
	end,
	function(v)
		HitboxRainbow = v
	end
)

local oldPickerParent = HitboxPicker.Parent
HitboxPicker.Parent = oldPickerParent
HitboxPicker.Visible = false

MakeToggle(
	"Hitbox Player + NPC",
	"Hitbox 1-100, cập nhật cả NPC và người chơi",
	function(state)

		HitboxEnabled = state

		HitboxSlider.Visible = state
		HitboxPicker.Visible = state

		if state then
			RefreshHitboxes()
		else
			for model in pairs(HitboxObjects) do
				RestoreHitbox(model)
			end
		end
	end
)

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function(character)
		task.wait(0.4)

		if HitboxEnabled and player ~= LocalPlayer then
			ApplyHitbox(character)
		end
	end)
end)

workspace.DescendantAdded:Connect(function(obj)
	if not HitboxEnabled then
		return
	end

	if obj:IsA("Model") then
		task.delay(0.3,function()
			if obj.Parent and IsNPC(obj) then
				ApplyHitbox(obj)
			end
		end)
	end
end)

RunService.RenderStepped:Connect(function()
	if HitboxEnabled then
		for model in pairs(HitboxObjects) do
			if model.Parent then
				ApplyHitbox(model)
			end
		end
	end
end)

RunService.RenderStepped:Connect(function()
	local c = RainbowColor(0.25)

	Stroke.Color = c
	OpenStroke.Color = c

	if HitboxEnabled and HitboxRainbow then
		for model in pairs(HitboxObjects) do
			local part = GetHitboxPart(model)
			if part then
				part.Color = c
			end
		end
	end
end)

-- Khởi tạo lần cuối
task.defer(function()
	RefreshESP()
	RefreshHitboxes()
	ApplyMovement()
end)
