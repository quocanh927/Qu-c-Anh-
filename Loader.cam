local jumpSlider

CreateToggle(
	"Jump Boost",
	"Tăng lực nhảy",
	function(state)
		States.JumpBoost = state
	end
)

jumpSlider = CreateSlider(
	"Jump Power",
	50,
	300,
	100,
	function(value)
		Values.JumpPower = value
	end
)

RunService.RenderStepped:Connect(function()
	local character = LocalPlayer.Character
	if not character then
		return
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return
	end

	if States.Speed then
		humanoid.WalkSpeed = Values.Speed
	else
		humanoid.WalkSpeed = 16
	end

	if States.JumpBoost then
		humanoid.UseJumpPower = true
		humanoid.JumpPower = Values.JumpPower
	else
		humanoid.JumpPower = 50
	end
end)
--==================================================
-- HITBOX PLAYER + NPC
-- SIZE 1 -> 100
-- MÀU + RAINBOW CHẠY LIÊN TỤC
--==================================================

local HitboxModels = {}
local HitboxOriginal = {}

local function HitboxColor()
	if Rainbow.Hitbox then
		return Color3.fromHSV(
			rainbowOffset,
			.85,
			1
		)
	end

	return Colors.Hitbox
end

local function ValidHitboxModel(model)
	if not model then
		return false
	end

	local humanoid =
		model:FindFirstChildOfClass("Humanoid")

	local root =
		model:FindFirstChild("HumanoidRootPart")

	if not humanoid or not root then
		return false
	end

	if humanoid.Health <= 0 then
		return false
	end

	if model == LocalPlayer.Character then
		return false
	end

	return true
end

local function ApplyHitbox(model)
	if not ValidHitboxModel(model) then
		return
	end

	local root =
		model:FindFirstChild("HumanoidRootPart")

	if not HitboxOriginal[model] then
		HitboxOriginal[model] = {
			Size = root.Size,
			Transparency = root.Transparency,
			Material = root.Material,
			Color = root.Color
		}
	end

	local size = math.clamp(
		Values.HitboxSize,
		1,
		100
	)

	root.Size = Vector3.new(
		size,
		size,
		size
	)

	root.Transparency = .7
	root.Material = Enum.Material.Neon
	root.Color = HitboxColor()
	root.CanCollide = false

	HitboxModels[model] = root
end

local function RestoreHitbox(model)
	local root =
		model and model:FindFirstChild(
			"HumanoidRootPart"
		)

	local old = HitboxOriginal[model]

	if root and old then
		root.Size = old.Size
		root.Transparency = old.Transparency
		root.Material = old.Material
		root.Color = old.Color
	end

	HitboxOriginal[model] = nil
	HitboxModels[model] = nil
end

local function ClearHitboxes()
	for model in pairs(HitboxOriginal) do
		pcall(function()
			RestoreHitbox(model)
		end)
	end

	HitboxOriginal = {}
	HitboxModels = {}
end

local function UpdateHitboxes()
	if not States.Hitbox then
		return
	end

	for _,player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer
			and player.Character then

			ApplyHitbox(player.Character)
		end
	end

	for _,obj in ipairs(workspace:GetDescendants()) do
		if IsMob(obj) then
			ApplyHitbox(obj)
		end
	end
end

local hitboxToggle = CreateToggle(
	"Hitbox Player + NPC",
	"Tăng vùng hitbox",
	function(state)
		States.Hitbox = state

		if not state then
			ClearHitboxes()
		else
			UpdateHitboxes()
		end
	end
)

local hitboxSlider = CreateSlider(
	"Size Hitbox",
	1,
	100,
	20,
	function(value)
		Values.HitboxSize = math.clamp(
			value,
			1,
			100
		)

		UpdateHitboxes()
	end
)

local rainbowHitbox = CreateToggle(
	"Rainbow Hitbox",
	"Đổi màu liên tục",
	function(state)
		Rainbow.Hitbox = state
	end
)

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function()
		task.wait(.5)

		if States.Hitbox then
			ApplyHitbox(player.Character)
		end
	end)
end)

workspace.DescendantAdded:Connect(function(obj)
	if States.Hitbox and obj:IsA("Model") then
		task.wait(.1)

		if IsMob(obj) then
			ApplyHitbox(obj)
		end
	end
end)

RunService.RenderStepped:Connect(function()
	if States.Hitbox then
		for model,root in pairs(HitboxModels) do
			if root and root.Parent then
				root.Color = HitboxColor()
				root.Size = Vector3.new(
					Values.HitboxSize,
					Values.HitboxSize,
					Values.HitboxSize
				)
			end
		end
	end

	UpdatePlayerESP()
	UpdateMobESP()
end)

--==================================================
-- KHỞI TẠO
--==================================================

speedSlider.Visible = false
jumpSlider.Visible = false

print("QA Hub loaded successfully")
