-- Cập nhật ESP màu liên tục khi chọn Cầu Vồng
RunService.RenderStepped:Connect(function()
	if States.ESPPlayer then
		for _, obj in ipairs(ESPFolder:GetChildren()) do
			if obj:IsA("Highlight")
				and obj.Name:sub(1, 4) == "ESP_" then

				obj.FillColor = GetColor("ESPPlayer")
				obj.OutlineColor = GetColor("ESPPlayer")
			end
		end
	end
end)
