local SpeedEnabled = false
local SpeedValue = 100

local JumpEnabled = false
local JumpValue = 100

local Noclip = false
local InfJump = false

local speedSlider = CreateSlider(
	"Speed Value",
	16,
	300,
	100,
	function(value)
		SpeedValue = value
	end
)

speedSlider.Visible = false

CreateToggle(
	"Speed",
	"Tăng tốc độ di chuyển",
	function(state)
		SpeedEnabled = state
		speedSlider.Visible = state
	end
)

local jumpSlider = CreateSlider(
	"Jump Power",
	50,
	300,
	100,
	function(value)
		JumpValue = value
	end
)

jumpSlider.Visible = false

CreateToggle(
	"Jump Boost",
	"Tăng lực nhảy",
	function(state)
		JumpEnabled = state
		jumpSlider.Visible = state
	end
)

CreateToggle(
	"Noclip",
	"Đi xuyên tường",
	function(state)
		Noclip = state
	end
)

CreateToggle(
	"InfJump",
	"Nhảy vô tận",
	function(state)
		InfJump = state
	end
)

RunService.Stepped:Connect(function()

	local character = LocalPlayer.Character

	if not character then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")

	if humanoid then

		if SpeedEnabled then
			humanoid.WalkSpeed = SpeedValue
		else
			humanoid.WalkSpeed = 16
		end

		if JumpEnabled then
			humanoid.JumpPower = JumpValue
		else
			humanoid.JumpPower = 50
		end

	end

	if Noclip then

		for _,obj in ipairs(character:GetDescendants()) do
			if obj:IsA("BasePart") then
				obj.CanCollide = false
			end
		end

	end
end)

UserInputService.JumpRequest:Connect(function()

	if InfJump then

		local character = LocalPlayer.Character
		local humanoid =
			character
			and character:FindFirstChildOfClass("Humanoid")

		if humanoid then
			humanoid:ChangeState(
				Enum.HumanoidStateType.Jumping
			)
		end

	end
end)

Players.PlayerAdded:Connect(function(player)

	player.CharacterAdded:Connect(function()

		task.wait(1)

		if HitboxEnabled then
			Remote:FireServer(
				"Hitbox",
				{
					enabled = true,
					size = HitboxSize
				}
			)
		end
	end)
end)

LocalPlayer.CharacterAdded:Connect(function()
	task.wait(.5)

	if SpeedEnabled then
		local h = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
		if h then
			h.WalkSpeed = SpeedValue
		end
	end
end)

-- Cập nhật ESP khi Player respawn
Players.PlayerAdded:Connect(function(player)

	player.CharacterAdded:Connect(function(character)

		task.wait(.3)

		if ESPPlayer then
			addESP(character,PlayerESPColor)
		end
	end)
end)
