--// PHẦN 3: HÀM GROUP + TOGGLE + SLIDER

local function CreateGroup()
	local Group = Instance.new("Frame")
	Group.Size = UDim2.new(1,0,0,42)
	Group.BackgroundTransparency = 1
	Group.AutomaticSize = Enum.AutomaticSize.Y
	Group.Parent = Scroll

	local Layout = Instance.new("UIListLayout")
	Layout.Padding = UDim.new(0,4)
	Layout.SortOrder = Enum.SortOrder.LayoutOrder
	Layout.Parent = Group

	return Group
end

local function CreateToggle(Group,name,description,callback)
	local Row = Instance.new("Frame")
	Row.Size = UDim2.new(1,-4,0,42)
	Row.BackgroundColor3 = Color3.fromRGB(22,22,32)
	Row.LayoutOrder = 1
	Row.Parent = Group

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0,8)
	Corner.Parent = Row

	local Label = Instance.new("TextLabel")
	Label.Size = UDim2.new(1,-65,0,18)
	Label.Position = UDim2.fromOffset(8,3)
	Label.BackgroundTransparency = 1
	Label.Text = name
	Label.TextSize = 11
	Label.Font = Enum.Font.GothamBold
	Label.TextColor3 = Color3.new(1,1,1)
	Label.TextXAlignment = Enum.TextXAlignment.Left
	Label.Parent = Row

	local Sub = Instance.new("TextLabel")
	Sub.Size = UDim2.new(1,-65,0,14)
	Sub.Position = UDim2.fromOffset(8,22)
	Sub.BackgroundTransparency = 1
	Sub.Text = description
	Sub.TextSize = 9
	Sub.Font = Enum.Font.Gotham
	Sub.TextColor3 = Color3.fromRGB(140,140,160)
	Sub.TextXAlignment = Enum.TextXAlignment.Left
	Sub.Parent = Row

	local Button = Instance.new("TextButton")
	Button.Size = UDim2.fromOffset(42,21)
	Button.Position = UDim2.new(1,-50,.5,-10)
	Button.BackgroundColor3 = Color3.fromRGB(45,45,60)
	Button.Text = ""
	Button.AutoButtonColor = false
	Button.Parent = Row

	local BC = Instance.new("UICorner")
	BC.CornerRadius = UDim.new(1,0)
	BC.Parent = Button

	local Knob = Instance.new("Frame")
	Knob.Size = UDim2.fromOffset(15,15)
	Knob.Position = UDim2.fromOffset(3,3)
	Knob.BackgroundColor3 = Color3.fromRGB(220,220,220)
	Knob.Parent = Button

	local KC = Instance.new("UICorner")
	KC.CornerRadius = UDim.new(1,0)
	KC.Parent = Knob

	local Enabled = false

	Button.MouseButton1Click:Connect(function()
		Enabled = not Enabled

		TweenService:Create(
			Knob,
			TweenInfo.new(.2),
			{
				Position = Enabled
					and UDim2.new(1,-18,.5,-7)
					or UDim2.fromOffset(3,3)
			}
		):Play()

		TweenService:Create(
			Button,
			TweenInfo.new(.2),
			{
				BackgroundColor3 = Enabled
					and Color3.fromRGB(170,0,255)
					or Color3.fromRGB(45,45,60)
			}
		):Play()

		if callback then
			callback(Enabled)
		end
	end)

	return Row
end

local function CreateSlider(Group,name,min,max,default,callback)
	local Frame = Instance.new("Frame")
	Frame.Size = UDim2.new(1,-4,0,44)
	Frame.BackgroundColor3 = Color3.fromRGB(18,18,26)
	Frame.LayoutOrder = 2
	Frame.Parent = Group

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0,7)
	Corner.Parent = Frame

	local Label = Instance.new("TextLabel")
	Label.Size = UDim2.new(1,-16,0,18)
	Label.Position = UDim2.fromOffset(8,2)
	Label.BackgroundTransparency = 1
	Label.Text = name..": "..default
	Label.TextSize = 10
	Label.Font = Enum.Font.GothamBold
	Label.TextColor3 = Color3.fromRGB(210,210,225)
	Label.TextXAlignment = Enum.TextXAlignment.Left
	Label.Parent = Frame

	local Track = Instance.new("TextButton")
	Track.Size = UDim2.new(1,-16,0,8)
	Track.Position = UDim2.fromOffset(8,27)
	Track.BackgroundColor3 = Color3.fromRGB(45,45,60)
	Track.Text = ""
	Track.AutoButtonColor = false
	Track.Parent = Frame

	local TC = Instance.new("UICorner")
	TC.CornerRadius = UDim.new(1,0)
	TC.Parent = Track

	local Fill = Instance.new("Frame")
	Fill.Size = UDim2.new((default-min)/(max-min),0,1,0)
	Fill.BackgroundColor3 = Color3.fromRGB(170,0,255)
	Fill.Parent = Track

	local FC = Instance.new("UICorner")
	FC.CornerRadius = UDim.new(1,0)
	FC.Parent = Fill

	local dragging = false

	local function Update(input)
		local x = math.clamp(
			(input.Position.X-Track.AbsolutePosition.X) /
			Track.AbsoluteSize.X,
			0,1
		)

		local value = math.floor(min+(max-min)*x)

		Fill.Size = UDim2.new(x,0,1,0)
		Label.Text = name..": "..value

		if callback then
			callback(value)
		end
	end

	Track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			Update(input)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (
			input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		) then
			Update(input)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	return Frame
end
--// PHẦN 4: COLOR PICKER + RAINBOW

local ColorOptions = {
	{"Đỏ",Color3.fromRGB(255,0,0)},
	{"Xanh Lá",Color3.fromRGB(0,255,0)},
	{"Xanh Nước",Color3.fromRGB(0,180,255)},
	{"Vàng",Color3.fromRGB(255,230,0)},
	{"Tím",Color3.fromRGB(170,0,255)},
	{"Hồng",Color3.fromRGB(255,80,180)},
	{"Trắng",Color3.fromRGB(255,255,255)},
	{"Đen",Color3.fromRGB(30,30,30)}
}

local function CreateColorPicker(Group,name,callback)
	local Frame = Instance.new("Frame")
	Frame.Size = UDim2.new(1,-4,0,70)
	Frame.BackgroundColor3 = Color3.fromRGB(18,18,26)
	Frame.LayoutOrder = 3
	Frame.Parent = Group

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0,7)
	Corner.Parent = Frame

	local Label = Instance.new("TextLabel")
	Label.Size = UDim2.new(1,-16,0,18)
	Label.Position = UDim2.fromOffset(8,3)
	Label.BackgroundTransparency = 1
	Label.Text = name
	Label.TextSize = 10
	Label.Font = Enum.Font.GothamBold
	Label.TextColor3 = Color3.fromRGB(210,210,225)
	Label.TextXAlignment = Enum.TextXAlignment.Left
	Label.Parent = Frame

	local Holder = Instance.new("Frame")
	Holder.Size = UDim2.new(1,-16,0,40)
	Holder.Position = UDim2.fromOffset(8,25)
	Holder.BackgroundTransparency = 1
	Holder.Parent = Frame

	local Grid = Instance.new("UIGridLayout")
	Grid.CellSize = UDim2.fromOffset(24,18)
	Grid.CellPadding = UDim2.fromOffset(4,4)
	Grid.Parent = Holder

	for _,info in ipairs(ColorOptions) do
		local Button = Instance.new("TextButton")
		Button.Text = ""
		Button.BackgroundColor3 = info[2]
		Button.Parent = Holder

		local C = Instance.new("UICorner")
		C.CornerRadius = UDim.new(0,4)
		C.Parent = Button

		Button.MouseButton1Click:Connect(function()
			if callback then
				callback(info[2])
			end
		end)
	end

	local RainbowButton = Instance.new("TextButton")
	RainbowButton.Text = ""
	RainbowButton.BackgroundColor3 = Color3.new(1,1,1)
	RainbowButton.Parent = Holder

	local RC = Instance.new("UICorner")
	RC.CornerRadius = UDim.new(0,4)
	RC.Parent = RainbowButton

	local Gradient = Instance.new("UIGradient")
	Gradient.Color = RainbowSequence
	Gradient.Parent = RainbowButton

	RainbowButton.MouseButton1Click:Connect(function()
		if callback then
			callback("RAINBOW")
		end
	end)

	return Frame
end

local function MakeRainbowObject(obj)
	local gradient = obj:FindFirstChildOfClass("UIGradient")

	if not gradient then
		gradient = Instance.new("UIGradient")
		gradient.Color = RainbowSequence
		gradient.Parent = obj
	end

	return gradient
end
--// PHẦN 5: ESP PLAYER + ESP NPC
--// Các mục màu nằm ngay bên dưới toggle của chính nó.

local ESPPlayerColor = Color3.fromRGB(255,0,0)
local ESPPlayerRainbow = false
local ESPPlayerEnabled = false

local ESPMobColor = Color3.fromRGB(0,180,255)
local ESPMobRainbow = false
local ESPMobEnabled = false

local ESPObjects = {}

local function ClearESP()
	for _,obj in pairs(ESPObjects) do
		if obj and obj.Parent then
			obj:Destroy()
		end
	end
	table.clear(ESPObjects)
end

local function AddESP(model,color,rainbow)
	if not model or not model:IsA("Model") then
		return
	end

	if model == LocalPlayer.Character then
		return
	end

	local root = model:FindFirstChild("HumanoidRootPart")
		or model:FindFirstChildWhichIsA("BasePart")

	if not root then
		return
	end

	local highlight = Instance.new("Highlight")
	highlight.Name = "QA_ESP"
	highlight.Adornee = model
	highlight.FillTransparency = .65
	highlight.OutlineTransparency = 0
	highlight.FillColor = color
	highlight.OutlineColor = color
	highlight.Parent = model

	if rainbow then
		MakeRainbowObject(highlight)
	end

	table.insert(ESPObjects,highlight)
end

local function RefreshPlayerESP()
	for _,obj in ipairs(ESPObjects) do
		if obj and obj.Parent then
			obj:Destroy()
		end
	end
	table.clear(ESPObjects)

	if not ESPPlayerEnabled then
		return
	end

	for _,player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			AddESP(
				player.Character,
				ESPPlayerColor,
				ESPPlayerRainbow
			)
		end
	end
end

local function RefreshMobESP()
	if not ESPMobEnabled then
		return
	end

	for _,model in ipairs(Workspace:GetDescendants()) do
		if model:IsA("Model")
		and model:FindFirstChildOfClass("Humanoid")
		and not Players:GetPlayerFromCharacter(model) then

			AddESP(
				model,
				ESPMobColor,
				ESPMobRainbow
			)
		end
	end
end

local PlayerGroup = CreateGroup()

CreateToggle(
	PlayerGroup,
	"ESP Player",
	"Hiện người chơi",
	function(state)
		ESPPlayerEnabled = state
		RefreshPlayerESP()
	end
)

local PlayerPicker = CreateColorPicker(
	PlayerGroup,
	"Màu ESP Player",
	function(color)
		if color == "RAINBOW" then
			ESPPlayerRainbow = true
		else
			ESPPlayerRainbow = false
			ESPPlayerColor = color
		end

		RefreshPlayerESP()
	end
)

PlayerPicker.Visible = false

local PlayerToggleButton = PlayerGroup:FindFirstChildWhichIsA("Frame")

local PlayerState = false

PlayerGroup.ChildAdded:Connect(function(child)
	if child:IsA("Frame") and child ~= PlayerPicker then
		local button = child:FindFirstChildWhichIsA("TextButton",true)

		if button then
			button.MouseButton1Click:Connect(function()
				PlayerState = not PlayerState
				PlayerPicker.Visible = PlayerState
			end)
		end
	end
end)

local MobGroup = CreateGroup()

CreateToggle(
	MobGroup,
	"ESP Mob",
	"Hiện NPC / quái",
	function(state)
		ESPMobEnabled = state

		if not state then
			ClearESP()
		else
			RefreshMobESP()
		end
	end
)

local MobPicker = CreateColorPicker(
	MobGroup,
	"Màu ESP Mob",
	function(color)
		if color == "RAINBOW" then
			ESPMobRainbow = true
		else
			ESPMobRainbow = false
			ESPMobColor = color
		end

		ClearESP()
		RefreshMobESP()
	end
)

MobPicker.Visible = false
--// PHẦN 6: FULLBRIGHT + FIX LAG + NOCLIP + INFJUMP + SPEED + JUMP

local FullbrightGroup = CreateGroup()

CreateToggle(
	FullbrightGroup,
	"Fullbright",
	"Sáng toàn bản đồ",
	function(state)
		if state then
			Lighting.Brightness = 2
			Lighting.ClockTime = 14
			Lighting.FogEnd = 100000
			Lighting.GlobalShadows = false
		else
			Lighting.GlobalShadows = true
		end
	end
)

local FixLagGroup = CreateGroup()

local function OptimizeObject(obj)
	if obj:IsA("ParticleEmitter")
	or obj:IsA("Trail")
	or obj:IsA("Beam")
	or obj:IsA("Smoke")
	or obj:IsA("Fire")
	or obj:IsA("Sparkles") then
		obj.Enabled = false
	end

	if obj:IsA("BasePart") then
		obj.Material = Enum.Material.SmoothPlastic
	end
end

local function RestoreObject(obj)
	if obj:IsA("ParticleEmitter")
	or obj:IsA("Trail")
	or obj:IsA("Beam")
	or obj:IsA("Smoke")
	or obj:IsA("Fire")
	or obj:IsA("Sparkles") then
		obj.Enabled = true
	end
end

CreateToggle(
	FixLagGroup,
	"Fix Lag",
	"Giảm hiệu ứng và chi tiết",
	function(state)
		if state then
			for _,obj in ipairs(Workspace:GetDescendants()) do
				pcall(function()
					OptimizeObject(obj)
				end)
			end
		else
			for _,obj in ipairs(Workspace:GetDescendants()) do
				pcall(function()
					RestoreObject(obj)
				end)
			end
		end
	end
)

local NoclipGroup = CreateGroup()
local Noclip = false

CreateToggle(
	NoclipGroup,
	"Noclip",
	"Đi xuyên tường",
	function(state)
		Noclip = state
	end
)

RunService.Stepped:Connect(function()
	if not Noclip then
		return
	end

	local character = LocalPlayer.Character
	if not character then
		return
	end

	for _,part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = false
		end
	end
end)

local InfJumpGroup = CreateGroup()
local InfJump = false

CreateToggle(
	InfJumpGroup,
	"InfJump",
	"Nhảy liên tục",
	function(state)
		InfJump = state
	end
)

UserInputService.JumpRequest:Connect(function()
	if InfJump then
		local hum = LocalPlayer.Character
			and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")

		if hum then
			hum:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end
end)

local SpeedGroup = CreateGroup()
local SpeedEnabled = false
local SpeedValue = 100

CreateToggle(
	SpeedGroup,
	"Speed",
