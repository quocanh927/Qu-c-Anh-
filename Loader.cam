local order = 0

local function NextOrder()
	order += 1
	return order
end

local function CreateToggle(name,desc,callback)

	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1,-6,0,42)
	frame.BackgroundColor3 = Color3.fromRGB(22,22,32)
	frame.LayoutOrder = NextOrder()
	frame.Parent = scroll

	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0,8)
	c.Parent = frame

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(.65,0,.5,0)
	label.Position = UDim2.new(0,8,0,3)
	label.BackgroundTransparency = 1
	label.Text = name
	label.TextColor3 = Color3.new(1,1,1)
	label.TextSize = 11
	label.Font = Enum.Font.GothamBold
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = frame

	local sub = Instance.new("TextLabel")
	sub.Size = UDim2.new(.65,0,.4,0)
	sub.Position = UDim2.new(0,8,.5,-2)
	sub.BackgroundTransparency = 1
	sub.Text = desc
	sub.TextColor3 = Color3.fromRGB(140,140,160)
	sub.TextSize = 9
	sub.TextXAlignment = Enum.TextXAlignment.Left
	sub.Parent = frame

	local button = Instance.new("TextButton")
	button.Size = UDim2.new(0,40,0,20)
	button.Position = UDim2.new(1,-48,.5,-10)
	button.Text = ""
	button.AutoButtonColor = false
	button.BackgroundColor3 = Color3.fromRGB(45,45,60)
	button.Parent = frame

	local bc = Instance.new("UICorner")
	bc.CornerRadius = UDim.new(1,0)
	bc.Parent = button

	local knob = Instance.new("Frame")
	knob.Size = UDim2.new(0,14,0,14)
	knob.Position = UDim2.new(0,3,.5,-7)
	knob.BackgroundColor3 = Color3.fromRGB(220,220,220)
	knob.Parent = button

	local kc = Instance.new("UICorner")
	kc.CornerRadius = UDim.new(1,0)
	kc.Parent = knob

	local state = false

	button.MouseButton1Click:Connect(function()

		state = not state

		local pos = state
			and UDim2.new(1,-17,.5,-7)
			or UDim2.new(0,3,.5,-7)

		TweenService:Create(
			knob,
			TweenInfo.new(.2),
			{Position=pos}
		):Play()

		TweenService:Create(
			button,
			TweenInfo.new(.2),
			{
				BackgroundColor3 =
					state
					and Color3.fromRGB(170,0,255)
					or Color3.fromRGB(45,45,60)
			}
		):Play()

		if callback then
			callback(state)
		end
	end)

	return frame
end
-- PHẦN 4/7

local HitboxEnabled = false
local HitboxSize = 50

local function CreateSlider(name,min,max,default,callback)

	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1,-6,0,44)
	frame.BackgroundColor3 = Color3.fromRGB(18,18,26)
	frame.LayoutOrder = NextOrder()
	frame.Parent = scroll

	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0,6)
	c.Parent = frame

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1,-16,0,18)
	label.Position = UDim2.new(0,8,0,3)
	label.BackgroundTransparency = 1
	label.Text = name..": "..default
	label.TextColor3 = Color3.fromRGB(200,200,220)
	label.TextSize = 10
	label.Font = Enum.Font.GothamBold
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = frame

	local track = Instance.new("TextButton")
	track.Size = UDim2.new(1,-16,0,8)
	track.Position = UDim2.new(0,8,0,26)
	track.Text = ""
	track.AutoButtonColor = false
	track.BackgroundColor3 = Color3.fromRGB(45,45,60)
	track.Parent = frame

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(
		(default-min)/(max-min),
		0,1,0
	)
	fill.BackgroundColor3 = Color3.fromRGB(170,0,255)
	fill.Parent = track

	local dragging = false

	local function update(input)

		local x = math.clamp(
			(input.Position.X-track.AbsolutePosition.X)
			/track.AbsoluteSize.X,
			0,1
		)

		local value = math.floor(
			min+(max-min)*x
		)

		fill.Size = UDim2.new(x,0,1,0)
		label.Text = name..": "..value

		if callback then
			callback(value)
		end
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			update(input)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging then
			if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
				update(input)
			end
		end
	end)

	return frame
end

local hitboxSlider = CreateSlider(
	"Size Hitbox",
	1,
	100,
	50,
	function(value)

		HitboxSize = value

		if HitboxEnabled then
			Remote:FireServer(
				"Hitbox",
				{
					enabled = true,
					size = HitboxSize
				}
			)
		end
	end
)

hitboxSlider.Visible = false

local hitboxToggle = CreateToggle(
	"Hitbox Player",
	"Tăng hitbox người chơi",
	function(state)

		HitboxEnabled = state
		hitboxSlider.Visible = state

		Remote:FireServer(
			"Hitbox",
			{
				enabled = state,
				size = HitboxSize
			}
		)
	end
)
-- PHẦN 5/7

local ESPPlayer = false
local ESPMob = false

local PlayerESPColor = Color3.fromRGB(0,170,255)
local MobESPColor = Color3.fromRGB(255,80,80)

local ESPRainbowPlayer = false
local ESPRainbowMob = false

local highlights = {}

local function removeESP(model)

	local old = highlights[model]

	if old then
		old:Destroy()
		highlights[model] = nil
	end
end

local function addESP(model,color)

	if not model then
		return
	end

	removeESP(model)

	local h = Instance.new("Highlight")
	h.Name = "QAHubESP"
	h.Adornee = model
	h.FillColor = color
	h.OutlineColor = color
	h.FillTransparency = .65
	h.OutlineTransparency = 0
	h.Parent = model

	highlights[model] = h
end

local function updatePlayerESP()

	for _,player in ipairs(Players:GetPlayers()) do

		if player ~= LocalPlayer then

			if ESPPlayer and player.Character then
				addESP(
					player.Character,
					PlayerESPColor
				)
			else
				removeESP(player.Character)
			end

		end
	end
end

local function updateMobESP()

	for _,obj in ipairs(workspace:GetDescendants()) do

		if obj:IsA("Model")
		and obj:FindFirstChildOfClass("Humanoid")
		and not Players:GetPlayerFromCharacter(obj) then

			if ESPMob then
				addESP(obj,MobESPColor)
			else
				removeESP(obj)
			end

		end
	end
end

CreateToggle(
	"ESP Player",
	"Hiện người chơi",
	function(state)
		ESPPlayer = state
		updatePlayerESP()
	end
)

CreateToggle(
	"ESP Mob",
	"Hiện NPC / quái",
	function(state)
		ESPMob = state
		updateMobESP()
	end
)

RunService.RenderStepped:Connect(function()

	local c = Color3.fromHSV(hue,.85,1)

	-- 🌈 ESP PLAYER
	if ESPRainbowPlayer then
		PlayerESPColor = c
	end

	-- 🌈 ESP MOB
	if ESPRainbowMob then
		MobESPColor = c
	end

	for model,h in pairs(highlights) do
		if h and h.Parent then

			if Players:GetPlayerFromCharacter(model) then
				h.FillColor = PlayerESPColor
				h.OutlineColor = PlayerESPColor
			else
				h.FillColor = MobESPColor
				h.OutlineColor = MobESPColor
			end

		else
			highlights[model] = nil
		end
	end
end)
