local function ApplyMovement()
	local character = LocalPlayer.Character
	if not character then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end

	if SpeedEnabled then
		humanoid.WalkSpeed = SpeedValue
	else
		humanoid.WalkSpeed = 16
	end

	if JumpEnabled then
		humanoid.UseJumpPower = true
		humanoid.JumpPower = JumpValue
	else
		humanoid.UseJumpPower = true
		humanoid.JumpPower = 50
	end
end

RunService.Heartbeat:Connect(function()
	ApplyMovement()
end)

LocalPlayer.CharacterAdded:Connect(function()
	task.wait(.5)
	ApplyMovement()
	task.wait(.5)
	RefreshESP()
end)
--========================================================
-- PART 5/7 - HITBOX DEBUG PLAYER + NPC
--========================================================

local HitboxEnabled = false
local HitboxSize = 20
local HitboxColor = Color3.fromRGB(0,120,255)
local HitboxRainbow = false

local HitboxObjects = {}

local function RemoveHitbox(model)
	local part = HitboxObjects[model]

	if part then
		part:Destroy()
		HitboxObjects[model] = nil
	end
end

local function AddHitbox(model)
	if not model:IsA("Model") then
		return
	end

	if model == LocalPlayer.Character then
		return
	end

	local root =
		model:FindFirstChild("HumanoidRootPart")
		or model.PrimaryPart

	if not root or not root:IsA("BasePart") then
		return
	end

	local existing = HitboxObjects[model]

	if existing then
		existing.Size = Vector3.new(
			HitboxSize,
			HitboxSize,
			HitboxSize
		)
		existing.Color = HitboxColor
		return
	end

	local part = Instance.new("Part")
	part.Name = "QA_DebugHitbox"
	part.Size = Vector3.new(
		HitboxSize,
		HitboxSize,
		HitboxSize
	)

	part.CFrame = root.CFrame
	part.Anchored = false
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.Transparency = .7
	part.Material = Enum.Material.Neon
	part.Color = HitboxColor

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = part
	weld.Parent = part

	part.Parent = model

	HitboxObjects[model] = part
end

local function RefreshHitbox()
	if not HitboxEnabled then
		for model in pairs(HitboxObjects) do
			RemoveHitbox(model)
		end
		return
	end

	for _,plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then
			AddHitbox(plr.Character)
		end
	end

	for _,obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("Model")
		and obj:FindFirstChildOfClass("Humanoid")
		and not Players:GetPlayerFromCharacter(obj) then
			AddHitbox(obj)
		end
	end
end

local HitboxSlider
local HitboxColorPicker

CreateToggle(
	"Hitbox Player / NPC",
