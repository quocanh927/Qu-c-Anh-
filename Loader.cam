-- QA HUB - PHẦN 2/7
-- Hệ thống màu

local RainbowColor = Color3.fromRGB(255,0,0)

local function GetRainbowColor(speed)
	return Color3.fromHSV((os.clock() * speed) % 1,0.9,1)
end

local RainbowObjects = {}

local function RegisterRainbow(object, property)
	table.insert(RainbowObjects,{
		Object = object,
		Property = property
	})
end

RunService.RenderStepped:Connect(function()
	RainbowColor = GetRainbowColor(0.5)

	for i = #RainbowObjects,1,-1 do
		local item = RainbowObjects[i]

		if item.Object and item.Object.Parent then
			pcall(function()
				item.Object[item.Property] = RainbowColor
			end)
		else
			table.remove(RainbowObjects,i)
		end
	end

	MainStroke.Color = RainbowColor
	ToggleStroke.Color = RainbowColor
end)

local function MakeCorner(parent,radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0,radius)
	c.Parent = parent
	return c
end

local function CreateToggle(name,description,callback)
	local Frame = Instance.new("Frame")
	Frame.Size = UDim2.new(1,-6,0,44)
	Frame.BackgroundColor3 = Color3.fromRGB(22,22,32)
	Frame.LayoutOrder = NextOrder()
	Frame.Parent = Scroll

	MakeCorner(Frame,8)

	local Label = Instance.new("TextLabel")
	Label.Size = UDim2.new(0.68,0,0,20)
	Label.Position = UDim2.fromOffset(8,3)
	Label.BackgroundTransparency = 1
	Label.Text = name
	Label.TextColor3 = Color3.new(1,1,1)
	Label.TextSize = 11
	Label.Font = Enum.Font.GothamBold
	Label.TextXAlignment = Enum.TextXAlignment.Left
	Label.Parent = Frame

	local Sub = Instance.new("TextLabel")
	Sub.Size = UDim2.new(0.68,0,0,16)
	Sub.Position = UDim2.fromOffset(8,22)
	Sub.BackgroundTransparency = 1
	Sub.Text = description
	Sub.TextColor3 = Color3.fromRGB(145,145,160)
	Sub.TextSize = 9
	Sub.Font = Enum.Font.Gotham
	Sub.TextXAlignment = Enum.TextXAlignment.Left
	Sub.Parent = Frame

	local Button = Instance.new("TextButton")
	Button.Size = UDim2.fromOffset(42,22)
	Button.Position = UDim2.new(1,-50,0.5,-11)
	Button.BackgroundColor3 = Color3.fromRGB(45,45,60)
	Button.Text = ""
	Button.AutoButtonColor = false
	Button.Parent = Frame

	MakeCorner(Button,20)

	local Knob = Instance.new("Frame")
	Knob.Size = UDim2.fromOffset(15,15)
	Knob.Position = UDim2.new(0,4,0.5,-7)
	Knob.BackgroundColor3 = Color3.fromRGB(220,220,220)
	Knob.Parent = Button

	MakeCorner(Knob,20)

	local Enabled = false

	Button.MouseButton1Click:Connect(function()
		Enabled = not Enabled

		TweenService:Create(
			Knob,
			TweenInfo.new(0.18),
			{
				Position = Enabled
					and UDim2.new(1,-19,0.5,-7)
					or UDim2.new(0,4,0.5,-7)
			}
		):Play()

		TweenService:Create(
			Button,
			TweenInfo.new(0.18),
			{
				BackgroundColor3 = Enabled
					and Color3.fromRGB(170,0,255)
					or Color3.fromRGB(45,45,60)
			}
		):Play()

		if callback then
			callback(Enabled)
		end
	end)

	return Frame
end
