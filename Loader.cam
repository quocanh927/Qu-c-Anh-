end)

local currentLayoutOrder = 0

local function GetNextOrder()
	currentLayoutOrder += 1
	return currentLayoutOrder
end
-- QA HUB - PART 3/7
-- Toggle + Slider

local function CreateToggle(name, subtext, callback)
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1, -6, 0, 42)
	frame.BackgroundColor3 = Color3.fromRGB(22, 22, 32)
	frame.LayoutOrder = GetNextOrder()
	frame.Parent = scrollFrame

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = frame

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0.65, 0, 0.5, 0)
	label.Position = UDim2.new(0, 8, 0, 3)
	label.BackgroundTransparency = 1
	label.Text = name
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextSize = 11
	label.Font = Enum.Font.GothamBold
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = frame

	local sub = Instance.new("TextLabel")
	sub.Size = UDim2.new(0.65, 0, 0.4, 0)
	sub.Position = UDim2.new(0, 8, 0.5, -2)
	sub.BackgroundTransparency = 1
	sub.Text = subtext
	sub.TextColor3 = Color3.fromRGB(140, 140, 160)
	sub.TextSize = 9
	sub.Font = Enum.Font.Gotham
	sub.TextXAlignment = Enum.TextXAlignment.Left
	sub.Parent = frame

	local button = Instance.new("TextButton")
	button.Size = UDim2.new(0, 40, 0, 20)
	button.Position = UDim2.new(1, -48, 0.5, -10)
	button.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
	button.Text = ""
	button.AutoButtonColor = false
	button.Parent = frame

	local buttonCorner = Instance.new("UICorner")
	buttonCorner.CornerRadius = UDim.new(1, 0)
	buttonCorner.Parent = button

	local knob = Instance.new("Frame")
	knob.Size = UDim2.new(0, 14, 0, 14)
	knob.Position = UDim2.new(0, 3, 0.5, -7)
	knob.BackgroundColor3 = Color3.fromRGB(220, 220, 220)
	knob.Parent = button

	local knobCorner = Instance.new("UICorner")
	knobCorner.CornerRadius = UDim.new(1, 0)
	knobCorner.Parent = knob

	local enabled = false

	button.MouseButton1Click:Connect(function()
		enabled = not enabled

		TweenService:Create(
			knob,
			TweenInfo.new(0.2),
			{
				Position = enabled
					and UDim2.new(1, -17, 0.5, -7)
					or UDim2.new(0, 3, 0.5, -7)
			}
		):Play()

		TweenService:Create(
			button,
			TweenInfo.new(0.2),
			{
				BackgroundColor3 = enabled
					and Color3.fromRGB(170, 0, 255)
					or Color3.fromRGB(45, 45, 60)
			}
		):Play()

		if callback then
			callback(enabled)
		end
	end)

	return frame
end

local function CreateSlider(name, min, max, default, callback)
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1, -6, 0, 44)
	frame.BackgroundColor3 = Color3.fromRGB(18, 18, 26)
	frame.LayoutOrder = GetNextOrder()
	frame.Parent = scrollFrame

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = frame

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0.9, 0, 0, 18)
	label.Position = UDim2.new(0, 8, 0, 3)
	label.BackgroundTransparency = 1
	label.Text = name .. ": " .. default
	label.TextColor3 = Color3.fromRGB(200, 200, 220)
	label.TextSize = 10
	label.Font = Enum.Font.GothamBold
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = frame

	local track = Instance.new("TextButton")
	track.Size = UDim2.new(1, -16, 0, 8)
	track.Position = UDim2.new(0, 8, 0, 26)
	track.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
	track.Text = ""
	track.AutoButtonColor = false
	track.Parent = frame

	local trackCorner = Instance.new("UICorner")
	trackCorner.CornerRadius = UDim.new(1, 0)
	trackCorner.Parent = track

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(
		(default - min) / (max - min),
		0,
		1,
		0
	)
	fill.BackgroundColor3 = Color3.fromRGB(170, 0, 255)
	fill.Parent = track

	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(1, 0)
	fillCorner.Parent = fill

	local value = default
	local dragging = false

	local function update(input)
		local x = math.clamp(
			(input.Position.X - track.AbsolutePosition.X)
			/ track.AbsoluteSize.X,
			0,
			1
		)

		value = math.floor(
			min + (max - min) * x
		)

		fill.Size = UDim2.new(x, 0, 1, 0)
		label.Text = name .. ": " .. value

		if callback then
			callback(value)
		end
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = true
			update(input)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = false
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging then
			if input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch then

				update(input)
			end
		end
	end)

	return frame, function()
		return value
	end
end
-- QA HUB - PART 4/7
-- Color Picker riêng cho từng chức năng

local function CreateColorPicker(name, key, callback)
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1, -6, 0, 75)
	frame.BackgroundColor3 = Color3.fromRGB(18, 18, 26)
	frame.LayoutOrder = GetNextOrder()
	frame.Parent = scrollFrame

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = frame

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -16, 0, 16)
	label.Position = UDim2.new(0, 8, 0, 3)
	label.BackgroundTransparency = 1
	label.Text = name
	label.TextColor3 = Color3.fromRGB(200, 200, 220)
	label.TextSize = 10
	label.Font = Enum.Font.GothamBold
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = frame

	local container = Instance.new("Frame")
	container.Size = UDim2.new(1, -16, 0, 45)
	container.Position = UDim2.new(0, 8, 0, 22)
	container.BackgroundTransparency = 1
	container.Parent = frame

	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.new(0, 22, 0, 18)
	grid.CellPadding = UDim2.new(0, 4, 0, 4)
	grid.Parent = container

	local colors = {
		{"Đỏ", Color3.fromRGB(255, 0, 0)},
		{"Xanh Lá", Color3.fromRGB(0, 255, 0)},
		{"Xanh Nước", Color3.fromRGB(0, 180, 255)},
		{"Vàng", Color3.fromRGB(255, 230, 0)},
		{"Tím", Color3.fromRGB(160, 0, 255)},
		{"Hồng", Color3.fromRGB(255, 100, 200)},
		{"Trắng", Color3.fromRGB(255, 255, 255)},
		{"Đen", Color3.fromRGB(30, 30, 30)},
		{"Cầu Vồng", nil}
	}

	for _, info in ipairs(colors) do
		local button = Instance.new("TextButton")
		button.Text = ""
		button.AutoButtonColor = false
		button.Parent = container

		local bc = Instance.new("UICorner")
		bc.CornerRadius = UDim.new(0, 4)
		bc.Parent = button

		if info[2] then
			button.BackgroundColor3 = info[2]
		else
			button.BackgroundColor3 = Color3.new(1, 1, 1)

			local gradient = Instance.new("UIGradient")
			gradient.Color = rainbowSequence
			gradient.Parent = button

			RunService.RenderStepped:Connect(function()
				gradient.Offset = Vector2.new(
					rainbowOffset,
					0
				)
			end)
		end

		button.MouseButton1Click:Connect(function()
			if info[2] then
				ColorValues[key] = info[2]
				RainbowEnabled[key] = false
			else
				RainbowEnabled[key] = true
			end

			if callback then
				callback()
			end
		end)
	end

	return frame
end
-- QA HUB - PART 5/7
-- ESP Player + ESP Mob + Hitbox

local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "QAHubESP"
ESPFolder.Parent = screenGui

local HitboxFolder = Instance.new("Folder")
HitboxFolder.Name = "QAHubHitboxes"
HitboxFolder.Parent = screenGui

local function GetColor(key)
	if RainbowEnabled[key] then
		return Color3.fromHSV(
			rainbowOffset,
			0.85,
			1
		)
	end

	return ColorValues[key]
end

local function RemoveESP(player)
	local obj = ESPFolder:FindFirstChild(
		"ESP_" .. player.UserId
	)

	if obj then
		obj:Destroy()
	end
end

local function CreatePlayerESP(player)
	if player == LocalPlayer then
		return
	end

	if not player.Character then
		return
	end

	RemoveESP(player)

	local character = player.Character

	local highlight = Instance.new("Highlight")
	highlight.Name = "ESP_" .. player.UserId
	highlight.Adornee = character
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.FillTransparency = 0.65
	highlight.OutlineTransparency = 0
	highlight.FillColor = GetColor("ESPPlayer")
	highlight.OutlineColor = GetColor("ESPPlayer")
	highlight.Parent = ESPFolder
end

local function UpdatePlayerESP()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			if States.ESPPlayer then
				CreatePlayerESP(player)
			else
				RemoveESP(player)
			end
		end
	end
end

local function RemoveAllPlayerESP()
	for _, obj in ipairs(ESPFolder:GetChildren()) do
		obj:Destroy()
	end
end

local function CreateMobESP(model)
	if not model:IsA("Model") then
		return
	end

	if Players:GetPlayerFromCharacter(model) then
		return
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return
	end

	if model == LocalPlayer.Character then
		return
	end

	local highlight = model:FindFirstChild("QA_MobESP")

	if not highlight then
		highlight = Instance.new("Highlight")
		highlight.Name = "QA_MobESP"
		highlight.Adornee = model
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.FillTransparency = 0.65
		highlight.OutlineTransparency = 0
		highlight.Parent = ESPFolder
	end

	highlight.FillColor = GetColor("ESPMob")
	highlight.OutlineColor = GetColor("ESPMob")
end

local function UpdateMobESP()
	if not States.ESPMob then
		for _, obj in ipairs(ESPFolder:GetChildren()) do
			if obj.Name == "QA_MobESP" then
				obj:Destroy()
			end
		end
		return
	end

	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("Model") then
			CreateMobESP(obj)
		end
	end
end

local function RemoveHitbox(player)
	local old = HitboxFolder:FindFirstChild(
		"Hitbox_" .. player.UserId
	)

	if old then
		old:Destroy()
	end
end

local function RemoveAllHitboxes()
	for _, obj in ipairs(HitboxFolder:GetChildren()) do
		obj:Destroy()
	end
end

local function CreateHitbox(player)
	if player == LocalPlayer then
		return
	end

	local character = player.Character

	if not character then
		return
	end

	local root = character:FindFirstChild(
		"HumanoidRootPart"
	)

	if not root then
		return
	end

	RemoveHitbox(player)

	local scale = math.clamp(
		SliderValues.Hitbox / 10,
		1,
		5
	)

	local hitbox = Instance.new("Part")
	hitbox.Name = "Hitbox_" .. player.UserId

	hitbox.Size = Vector3.new(
		2.5 * scale,
		3.5 * scale,
		2.5 * scale
	)

	hitbox.CFrame = root.CFrame
	hitbox.Anchored = false
	hitbox.CanCollide = false
	hitbox.CanTouch = false
	hitbox.CanQuery = false
	hitbox.Massless = true

	-- Dễ nhìn hơn
	hitbox.Transparency = 0.35
	hitbox.Material = Enum.Material.ForceField
	hitbox.Color = GetColor("Hitbox")

	hitbox.Parent = HitboxFolder

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = hitbox
	weld.Part1 = root
	weld.Parent = hitbox
end

local function UpdateHitboxes()
	if not States.Hitbox then
		RemoveAllHitboxes()
		return
	end

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			CreateHitbox(player)
		end
	end
end

local function SetHitbox(state)
	States.Hitbox = state

	if not state then
		RemoveAllHitboxes()
		return
	end

	UpdateHitboxes()
end
-- QA HUB - PART 6/7
-- Các tính năng

local savedLighting = {
	Brightness = Lighting.Brightness,
	ClockTime = Lighting.ClockTime,
	FogEnd = Lighting.FogEnd,
	GlobalShadows = Lighting.GlobalShadows
}

local function SetFullbright(state)
	States.Fullbright = state

	if state then
		Lighting.Brightness = 2
		Lighting.ClockTime = 14
		Lighting.FogEnd = 100000
		Lighting.GlobalShadows = false
	else
		Lighting.Brightness = savedLighting.Brightness
		Lighting.ClockTime = savedLighting.ClockTime
		Lighting.FogEnd = savedLighting.FogEnd
		Lighting.GlobalShadows = savedLighting.GlobalShadows
	end
end

local function SetNoclip(state)
	States.Noclip = state
end

local function SetInfJump(state)
	States.InfJump = state
end

local function SetSpeed(state)
	States.Speed = state
end

local function SetJumpBoost(state)
	States.JumpBoost = state
end

local function SetFixLag(state)
	States.FixLag = state

	if state then
		-- Chỉ giảm các hiệu ứng phía client,
		-- không xóa skin hoặc map.
		for _, obj in ipairs(workspace:GetDescendants()) do
			if obj:IsA("ParticleEmitter")
				or obj:IsA("Trail")
				or obj:IsA("Beam") then

				obj.Enabled = false
			end
		end
	end
end

RunService.Stepped:Connect(function()
	if States.Noclip then
		local character = LocalPlayer.Character

		if character then
			for _, obj in ipairs(character:GetDescendants()) do
				if obj:IsA("BasePart") then
					obj.CanCollide = false
				end
			end
		end
	end
end)

UserInputService.JumpRequest:Connect(function()
	if not States.InfJump then
		return
	end

	local character = LocalPlayer.Character

	if not character then
		return
	end

	local humanoid = character:FindFirstChildOfClass(
		"Humanoid"
	)

	if humanoid then
		humanoid:ChangeState(
			Enum.HumanoidStateType.Jumping
		)
	end
end)

RunService.RenderStepped:Connect(function()
	local character = LocalPlayer.Character

	if not character then
		return
	end

	local humanoid = character:FindFirstChildOfClass(
		"Humanoid"
	)

	if not humanoid then
		return
	end

	if States.Speed then
		humanoid.WalkSpeed = SliderValues.Speed
	else
		humanoid.WalkSpeed = 16
	end

	if States.JumpBoost then
		humanoid.UseJumpPower = true
		humanoid.JumpPower = SliderValues.JumpPower
	else
		humanoid.JumpPower = 50
	end
end)

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function()
		task.wait(0.5)

		if States.ESPPlayer then
			CreatePlayerESP(player)
		end

		if States.Hitbox then
			CreateHitbox(player)
		end
	end)
end)

for _, player in ipairs(Players:GetPlayers()) do
	if player ~= LocalPlayer then
		player.CharacterAdded:Connect(function()
			task.wait(0.5)

			if States.ESPPlayer then
				CreatePlayerESP(player)
			end

			if States.Hitbox then
				CreateHitbox(player)
			end
		end)
	end
end

RunService.RenderStepped:Connect(function()
	if States.ESPPlayer then
		UpdatePlayerESP()
	end

	if States.ESPMob then
		UpdateMobESP()
	end

	if States.Hitbox then
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer then
				local h = HitboxFolder:FindFirstChild(
					"Hitbox_" .. player.UserId
				)

				if h then
					h.Color = GetColor("Hitbox")
				end
			end
		end
	end
end)
-- QA HUB - PART 7/7
-- Tạo menu chức năng
-- Fix Lag chỉ còn 1 nút, không có Nhẹ/Mạnh

local espPlayerColor

CreateToggle(
	"ESP Player",
	"Hiện người chơi",
	function(state)
		States.ESPPlayer = state

		if state then
			UpdatePlayerESP()
			espPlayerColor.Visible = true
		else
			RemoveAllPlayerESP()
			espPlayerColor.Visible = false
		end
	end
)

espPlayerColor = CreateColorPicker(
	"Màu ESP Player",
	"ESPPlayer",
	function()
		if States.ESPPlayer then
			UpdatePlayerESP()
		end
	end
)

espPlayerColor.Visible = false

local espMobColor

CreateToggle(
	"ESP Mob",
	"Hiện quái vật",
	function(state)
		States.ESPMob = state

		if state then
			UpdateMobESP()
			espMobColor.Visible = true
		else
			UpdateMobESP()
			espMobColor.Visible = false
		end
	end
)

espMobColor = CreateColorPicker(
	"Màu ESP Mob",
	"ESPMob",
	function()
		if States.ESPMob then
			UpdateMobESP()
		end
	end
)

espMobColor.Visible = false

