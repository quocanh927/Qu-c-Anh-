local function CreateColorPicker(name,callback)
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1,-6,0,75)
	frame.BackgroundColor3 = Color3.fromRGB(18,18,26)
	frame.LayoutOrder = NextOrder()
	frame.Parent = scroll

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0,6)
	corner.Parent = frame

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1,-16,0,16)
	label.Position = UDim2.fromOffset(8,3)
	label.BackgroundTransparency = 1
	label.Text = name
	label.TextColor3 = Color3.fromRGB(200,200,220)
	label.TextSize = 10
	label.Font = Enum.Font.GothamBold
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = frame

	local holder = Instance.new("Frame")
	holder.Size = UDim2.new(1,-16,0,45)
	holder.Position = UDim2.fromOffset(8,22)
	holder.BackgroundTransparency = 1
	holder.Parent = frame

	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.fromOffset(22,18)
	grid.CellPadding = UDim2.fromOffset(4,4)
	grid.Parent = holder

	local colors = {
		{"Đỏ",Color3.fromRGB(255,0,0)},
		{"Xanh lá",Color3.fromRGB(0,255,0)},
		{"Xanh dương",Color3.fromRGB(0,150,255)},
		{"Vàng",Color3.fromRGB(255,230,0)},
		{"Tím",Color3.fromRGB(160,0,255)},
		{"Hồng",Color3.fromRGB(255,80,180)},
		{"Trắng",Color3.new(1,1,1)},
		{"Cam",Color3.fromRGB(255,120,0)}
	}

	for _,data in ipairs(colors) do
		local b = Instance.new("TextButton")
		b.Text = ""
		b.BackgroundColor3 = data[2]
		b.Parent = holder

		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0,4)
		c.Parent = b

		b.MouseButton1Click:Connect(function()
			if callback then
				callback(data[2],false)
			end
		end)
	end

	local rainbow = Instance.new("TextButton")
	rainbow.Text = ""
	rainbow.BackgroundColor3 = Color3.new(1,1,1)
	rainbow.Parent = holder

	local rc = Instance.new("UICorner")
	rc.CornerRadius = UDim.new(0,4)
	rc.Parent = rainbow

	local rg = Instance.new("UIGradient")
	rg.Color = Rainbow
	rg.Parent = rainbow

	rainbow.MouseButton1Click:Connect(function()
		if callback then
			callback(nil,true)
		end
	end)

	return frame
end

local ESPEnabled = false
local ESPMobEnabled = false
local ESPColor = Color3.fromRGB(255,0,0)
local ESPRainbow = false

local ESPObjects = {}

local function RemoveESP(model)
	local h = ESPObjects[model]
	if h then
		h:Destroy()
		ESPObjects[model] = nil
	end
end

local function AddESP(model,isPlayer)
	if not model:IsA("Model") then
		return
	end

	if model == LocalPlayer.Character then
		return
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end

	if ESPObjects[model] then
		return
	end

	local h = Instance.new("Highlight")
	h.Name = "QA_ESP"
	h.DepthMode = Enum.HighlightDepthMode.Occluded
	h.FillTransparency = .65
	h.OutlineTransparency = 0
	h.FillColor = ESPColor
	h.OutlineColor = ESPColor
	h.Adornee = model
	h.Parent = model

	ESPObjects[model] = h
end

local function RefreshESP()
	for model,obj in pairs(ESPObjects) do
		if not model.Parent then
			ESPObjects[model] = nil
		else
			obj.FillColor = ESPColor
			obj.OutlineColor = ESPColor
		end
	end

	if not ESPEnabled and not ESPMobEnabled then
		for model in pairs(ESPObjects) do
			RemoveESP(model)
		end
		return
	end

	for _,plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then
			if ESPEnabled then
				AddESP(plr.Character,true)
			end
		end
	end

	if ESPMobEnabled then
		for _,obj in ipairs(Workspace:GetDescendants()) do
			if obj:IsA("Model")
			and obj:FindFirstChildOfClass("Humanoid")
			and not Players:GetPlayerFromCharacter(obj) then
				AddESP(obj,false)
			end
		end
	end
end
