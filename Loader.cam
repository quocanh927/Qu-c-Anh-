)

HitboxSlider.Visible = false
HitboxPicker.Visible = false

-- cập nhật visibility theo toggle
local hitboxVisibleConnection
hitboxVisibleConnection = RunService.RenderStepped:Connect(function()
	local visible = HitboxEnabled

	HitboxSlider.Visible = visible
	HitboxPicker.Visible = visible
end)

-- Player respawn
Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function(character)
		task.wait(0.3)

		if HitboxEnabled then
			ApplyHitbox(character)
		end
	end)
end)

for _,player in ipairs(Players:GetPlayers()) do
	if player ~= LocalPlayer then
		player.CharacterAdded:Connect(function(character)
			task.wait(0.3)

			if HitboxEnabled then
				ApplyHitbox(character)
			end
		end)
	end
end

-- cập nhật hitbox liên tục
RunService.RenderStepped:Connect(function()
	if HitboxEnabled then
		ApplyAllHitboxes()
	end
end)
-- QA HUB - PHẦN 7/7
-- Fullbright + Fix Lag 1 nút + hoàn thiện

local FullbrightEnabled = false
local OldBrightness = Lighting.Brightness
local OldClockTime = Lighting.ClockTime
local OldFogEnd = Lighting.FogEnd
local OldGlobalShadows = Lighting.GlobalShadows

CreateToggle(
	"Fullbright",
	"Sáng toàn bản đồ",
	function(state)
		FullbrightEnabled = state

		if state then
			OldBrightness = Lighting.Brightness
			OldClockTime = Lighting.ClockTime
			OldFogEnd = Lighting.FogEnd
			OldGlobalShadows = Lighting.GlobalShadows

			Lighting.Brightness = 2
			Lighting.ClockTime = 14
			Lighting.FogEnd = 100000
			Lighting.GlobalShadows = false
		else
			Lighting.Brightness = OldBrightness
			Lighting.ClockTime = OldClockTime
			Lighting.FogEnd = OldFogEnd
			Lighting.GlobalShadows = OldGlobalShadows
		end
	end
)

local FixLagEnabled = false

CreateToggle(
	"Fix Lag",
	"Tối ưu hiệu ứng hình ảnh",
	function(state)
		FixLagEnabled = state

		if state then
			for _,obj in ipairs(workspace:GetDescendants()) do
				if obj:IsA("ParticleEmitter")
				or obj:IsA("Trail")
				or obj:IsA("Beam") then
					obj.Enabled = false
				end
			end

			Lighting.GlobalShadows = false

		else
			for _,obj in ipairs(workspace:GetDescendants()) do
				if obj:IsA("ParticleEmitter")
				or obj:IsA("Trail")
				or obj:IsA("Beam") then
					obj.Enabled = true
				end
			end

			if not FullbrightEnabled then
				Lighting.GlobalShadows = OldGlobalShadows
			end
		end
	end
)

-- Noclip
local NoclipEnabled = false

CreateToggle(
	"Noclip",
	"Đi xuyên tường",
	function(state)
		NoclipEnabled = state
	end
)

RunService.Stepped:Connect(function()
	if NoclipEnabled and LocalPlayer.Character then
		for _,obj in ipairs(LocalPlayer.Character:GetDescendants()) do
			if obj:IsA("BasePart") then
				obj.CanCollide = false
			end
		end
	end
end)

-- InfJump
local InfJumpEnabled = false

CreateToggle(
	"InfJump",
	"Nhảy vô tận",
	function(state)
		InfJumpEnabled = state
	end
)

UserInputService.JumpRequest:Connect(function()
	if InfJumpEnabled then
		local Character = LocalPlayer.Character
		local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

		if Humanoid then
			Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end
end)

-- Rainbow title
local TitleGradient = Instance.new("UIGradient")
TitleGradient.Color = ColorSequence.new({
	ColorSequenceKeypoint.new(0,Color3.fromRGB(255,0,0)),
	ColorSequenceKeypoint.new(0.2,Color3.fromRGB(255,255,0)),
	ColorSequenceKeypoint.new(0.4,Color3.fromRGB(0,255,0)),
	ColorSequenceKeypoint.new(0.6,Color3.fromRGB(0,255,255)),
	ColorSequenceKeypoint.new(0.8,Color3.fromRGB(170,0,255)),
	ColorSequenceKeypoint.new(1,Color3.fromRGB(255,0,200))
})
TitleGradient.Parent = Title

RunService.RenderStepped:Connect(function()
	TitleGradient.Offset = Vector2.new(
		(os.clock()*0.4)%1,
		0
	)

	-- tự quét NPC mới sinh
	if NPCESPEnabled then
		for _,obj in ipairs(workspace:GetDescendants()) do
			if IsNPC(obj) and not NPCObjects[obj] then
				AddNPCESP(obj)
			end
		end
	end
end)

