local scroll = Instance.new("ScrollingFrame")
scroll.Size = UDim2.new(1,-16,1,-100)
scroll.Position = UDim2.new(0,8,0,95)
scroll.BackgroundTransparency = 1
scroll.BorderSizePixel = 0
scroll.ScrollBarThickness = 3
scroll.Parent = mainFrame

local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0,6)
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Parent = scroll

layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
	scroll.CanvasSize = UDim2.new(
		0,0,0,
		layout.AbsoluteContentSize.Y + 12
	)
end)

local order = 0

local function GetOrder()
	order += 1
	return order
end

local function CreateToggle(name,desc,callback)
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1,-6,0,42)
	frame.BackgroundColor3 = Color3.fromRGB(22,22,32)
	frame.LayoutOrder = GetOrder()
	frame.Parent = scroll

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0,8)
	corner.Parent = frame

	local text = Instance.new("TextLabel")
	text.Size = UDim2.new(.65,0,.5,0)
	text.Position = UDim2.new(0,8,0,3)
	text.BackgroundTransparency = 1
	text.Text = name
	text.TextColor3 = Color3.new(1,1,1)
	text.TextSize = 11
	text.Font = Enum.Font.GothamBold
	text.TextXAlignment = Enum.TextXAlignment.Left
	text.Parent = frame

	local descText = Instance.new("TextLabel")
	descText.Size = UDim2.new(.65,0,.4,0)
	descText.Position = UDim2.new(0,8,.5,-2)
	descText.BackgroundTransparency = 1
	descText.Text = desc
	descText.TextColor3 = Color3.fromRGB(140,140,160)
	descText.TextSize = 9
	descText.Font = Enum.Font.Gotham
	descText.TextXAlignment = Enum.TextXAlignment.Left
	descText.Parent = frame

	local button = Instance.new("TextButton")
	button.Size = UDim2.new(0,40,0,20)
	button.Position = UDim2.new(1,-48,.5,-10)
	button.BackgroundColor3 = Color3.fromRGB(45,45,60)
	button.Text = ""
	button.AutoButtonColor = false
	button.Parent = frame

	local trackCorner = Instance.new("UICorner")
	trackCorner.CornerRadius = UDim.new(1,0)
	trackCorner.Parent = button

	local knob = Instance.new("Frame")
	knob.Size = UDim2.new(0,14,0,14)
	knob.Position = UDim2.new(0,3,.5,-7)
	knob.BackgroundColor3 = Color3.fromRGB(220,220,220)
	knob.Parent = button

	local knobCorner = Instance.new("UICorner")
	knobCorner.CornerRadius = UDim.new(1,0)
	knobCorner.Parent = knob

	local state = false

	button.MouseButton1Click:Connect(function()
		state = not state

		local pos = state
			and UDim2.new(1,-17,.5,-7)
			or UDim2.new(0,3,.5,-7)

		TweenService:Create(
			knob,
			TweenInfo.new(.2),
			{Position = pos}
		):Play()

		TweenService:Create(
			button,
			TweenInfo.new(.2),
			{
				BackgroundColor3 =
					state
					and Color3.fromRGB(170,0,255)
					or Color3.fromRGB(45,45,60)
			}
		):Play()

		if callback then
			callback(state)
		end
	end)

	return frame
end

local function CreateSlider(name,min,max,default,callback)
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1,-6,0,44)
	frame.BackgroundColor3 = Color3.fromRGB(18,18,26)
	frame.LayoutOrder = GetOrder()
	frame.Parent = scroll

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0,6)
	corner.Parent = frame

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1,-16,0,18)
	label.Position = UDim2.new(0,8,0,3)
	label.BackgroundTransparency = 1
	label.Text = name .. ": " .. default
	label.TextColor3 = Color3.fromRGB(200,200,220)
	label.TextSize = 10
	label.Font = Enum.Font.GothamBold
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = frame

	local track = Instance.new("TextButton")
	track.Size = UDim2.new(1,-16,0,8)
	track.Position = UDim2.new(0,8,0,26)
	track.BackgroundColor3 = Color3.fromRGB(45,45,60)
	track.Text = ""
	track.AutoButtonColor = false
	track.Parent = frame

	local tc = Instance.new("UICorner")
	tc.CornerRadius = UDim.new(1,0)
	tc.Parent = track

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(
		(default-min)/(max-min),
		0,1,0
	)
	fill.BackgroundColor3 = Color3.fromRGB(170,0,255)
	fill.Parent = track

	local fc = Instance.new("UICorner")
	fc.CornerRadius = UDim.new(1,0)
	fc.Parent = fill

	local dragging = false

	local function Update(input)
		local x = math.clamp(
			(input.Position.X-track.AbsolutePosition.X)
			/track.AbsoluteSize.X,
			0,1
		)

		local value = math.floor(
			min + (max-min)*x
		)

		fill.Size = UDim2.new(x,0,1,0)
		label.Text = name .. ": " .. value

		if callback then
			callback(value)
		end
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = true
			Update(input)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (
			input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		) then
			Update(input)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	return frame
end
--==================================================
-- ESP PLAYER
--==================================================

local PlayerESP = {}

local function PlayerColor()
	if Rainbow.ESPPlayer then
		return Color3.fromHSV(
			rainbowOffset,
			.85,
			1
		)
	end

	return Colors.ESPPlayer
end

local function RemovePlayerESP(player)
	local old = PlayerESP[player]

	if old then
		old:Destroy()
		PlayerESP[player] = nil
	end
end

local function AddPlayerESP(player)
	if player == LocalPlayer then
		return
	end

	RemovePlayerESP(player)

	if not player.Character then
		return
	end

	local highlight = Instance.new("Highlight")
	highlight.Name = "QA_PlayerESP"
	highlight.Adornee = player.Character
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.FillTransparency = .65
	highlight.OutlineTransparency = 0
	highlight.FillColor = PlayerColor()
	highlight.OutlineColor = PlayerColor()
	highlight.Parent = player.Character

	PlayerESP[player] = highlight
end

local function UpdatePlayerESP()
	for player,highlight in pairs(PlayerESP) do
		if highlight and highlight.Parent then
			local c = PlayerColor()
			highlight.FillColor = c
			highlight.OutlineColor = c
		end
	end
end

local espPlayerColorPicker =
	CreateSlider(
		"ESP Player màu",
		1,
		100,
		50,
		function()
		end
	)

espPlayerColorPicker.Visible = false

local espPlayerToggle = CreateToggle(
	"ESP Player",
	"Hiện người chơi",
	function(state)
		States.ESPPlayer = state

		if not state then
			for player in pairs(PlayerESP) do
				RemovePlayerESP(player)
			end
		else
			for _,player in ipairs(Players:GetPlayers()) do
				AddPlayerESP(player)
			end
		end
	end
)

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function()
		task.wait(.5)

		if States.ESPPlayer then
			AddPlayerESP(player)
		end
	end)
end)

for _,player in ipairs(Players:GetPlayers()) do
	if player ~= LocalPlayer then
		player.CharacterAdded:Connect(function()
			task.wait(.5)

			if States.ESPPlayer then
				AddPlayerESP(player)
			end
		end)
	end
end
--==================================================
-- ESP MOB + FULLBRIGHT + FIX LAG
--==================================================

local MobESP = {}

local function MobColor()
	if Rainbow.ESPMob then
		return Color3.fromHSV(
			(rainbowOffset + .25) % 1,
			.85,
			1
		)
	end

	return Colors.ESPMob
end

local function IsMob(model)
	if not model:IsA("Model") then
		return false
	end

	if not model:FindFirstChildOfClass("Humanoid") then
		return false
	end

	if not model:FindFirstChild("HumanoidRootPart") then
		return false
	end

	if Players:GetPlayerFromCharacter(model) then
		return false
	end

	return true
end

local function UpdateMobESP()
	if not States.ESPMob then
		for model,highlight in pairs(MobESP) do
			if highlight then
				highlight:Destroy()
			end
		end

		MobESP = {}
		return
	end

	for _,model in ipairs(workspace:GetChildren()) do
		if IsMob(model) and not MobESP[model] then

			local highlight = Instance.new("Highlight")
			highlight.Name = "QA_MobESP"
			highlight.Adornee = model
			highlight.DepthMode =
				Enum.HighlightDepthMode.AlwaysOnTop
			highlight.FillTransparency = .65
			highlight.OutlineTransparency = 0
			highlight.Parent = model

			MobESP[model] = highlight
		end
	end

	for model,highlight in pairs(MobESP) do
		if highlight and highlight.Parent then
			local c = MobColor()
			highlight.FillColor = c
			highlight.OutlineColor = c
		else
			MobESP[model] = nil
		end
	end
end

CreateToggle(
	"ESP Mob",
	"Hiện quái vật",
	function(state)
		States.ESPMob = state
		UpdateMobESP()
	end
)

CreateToggle(
	"Fullbright",
	"Sáng toàn bản đồ",
	function(state)
		States.Fullbright = state

		if state then
			Lighting.Brightness = 2
			Lighting.ClockTime = 14
			Lighting.FogEnd = 100000
			Lighting.GlobalShadows = false
			Lighting.Ambient = Color3.new(1,1,1)
			Lighting.OutdoorAmbient = Color3.new(1,1,1)
		else
			Lighting.GlobalShadows = true
			Lighting.FogEnd = 1000
		end
	end
)

CreateToggle(
	"Fix Lag",
	"Giảm hiệu ứng không cần thiết",
	function(state)
		States.FixLag = state

		for _,obj in ipairs(workspace:GetDescendants()) do
			if obj:IsA("ParticleEmitter")
				or obj:IsA("Trail")
				or obj:IsA("Beam") then

				obj.Enabled = not state
			end
		end
	end
)

workspace.DescendantAdded:Connect(function(obj)
	if States.FixLag then
		if obj:IsA("ParticleEmitter")
			or obj:IsA("Trail")
			or obj:IsA("Beam") then

			obj.Enabled = false
		end
	end
end)
