-- HITBOX
--==============================================================

local Hitbox = {}

do
    local enabled = false

    local size = 10

    local hitboxColor =
        Color3.fromRGB(
            255,
            80,
            80
        )

    local saved = {}

    local function isOtherPlayer(character)

        if not character
            or not character:IsA("Model") then
            return false
        end

        local player =
            Players:GetPlayerFromCharacter(
                character
            )

        return player ~= nil
            and player ~= LocalPlayer
    end


    local function apply(character)

        if not enabled then
            return
        end

        if not isOtherPlayer(character) then
            return
        end

        local root =
            character:FindFirstChild(
                "HumanoidRootPart"
            )

        if not root
            or not root:IsA("BasePart") then
            return
        end


        if not saved[root] then

            saved[root] = {
                Size = root.Size,
                Color = root.Color,
                Transparency = root.Transparency,
                Material = root.Material
            }
        end


        root.Size =
            Vector3.new(
                size,
                size,
                size
            )

        root.Color =
            hitboxColor

        root.Transparency =
            0.65

        root.Material =
            Enum.Material.ForceField
    end


    local function restore(character)

        if not character then
            return
        end

        local root =
            character:FindFirstChild(
                "HumanoidRootPart"
            )

        if not root then
            return
        end

        local old =
            saved[root]

        if old then

            pcall(function()

                root.Size =
                    old.Size

                root.Color =
                    old.Color

                root.Transparency =
                    old.Transparency

                root.Material =
                    old.Material

            end)

            saved[root] = nil
        end
    end


    local function refresh()

        if not enabled then
            return
        end

        for _, player in ipairs(
            Players:GetPlayers()
        ) do

            if player ~= LocalPlayer
                and player.Character then

                apply(
                    player.Character
                )
            end
        end
    end


    function Hitbox.SetEnabled(value)

        enabled = value

        if enabled then

            refresh()

        else

            for _, player in ipairs(
                Players:GetPlayers()
            ) do

                if player ~= LocalPlayer
                    and player.Character then

                    restore(
                        player.Character
                    )
                end
            end

            table.clear(saved)
        end
    end


    function Hitbox.SetSize(value)

        size =
            math.clamp(
                tonumber(value) or 10,
                1,
                50
            )

        refresh()
    end


    function Hitbox.SetColor(color)

        if typeof(color)
            ~= "Color3" then
            return
        end

        hitboxColor = color

        refresh()
    end
end


