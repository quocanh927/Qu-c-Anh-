	Button.Activated:Connect(function()

		local Original =
			Button.Size

		Button:TweenSize(
			Original - UDim2.fromOffset(4,2),
			Enum.EasingDirection.Out,
			Enum.EasingStyle.Quad,
			.06,
			true
		)

		task.delay(.06,function()

