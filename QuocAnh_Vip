local RainbowColors = ColorSequence.new({
	ColorSequenceKeypoint.new(0,Color3.fromRGB(255,0,90)),
	ColorSequenceKeypoint.new(.16,Color3.fromRGB(255,80,0)),
	ColorSequenceKeypoint.new(.32,Color3.fromRGB(255,230,0)),
	ColorSequenceKeypoint.new(.48,Color3.fromRGB(0,255,80)),
	ColorSequenceKeypoint.new(.64,Color3.fromRGB(0,220,255)),
	ColorSequenceKeypoint.new(.80,Color3.fromRGB(90,0,255)),
	ColorSequenceKeypoint.new(1,Color3.fromRGB(255,0,220))
})

local function RainbowStroke(Object,Thickness)

	local Stroke = Instance.new("UIStroke")
	Stroke.Thickness = Thickness or 2
	Stroke.Parent = Object

	local Gradient = Instance.new("UIGradient")
	Gradient.Color = RainbowColors
	Gradient.Parent = Stroke

	return Stroke,Gradient
end

local function RainbowText(Object)

	local Gradient = Instance.new("UIGradient")
	Gradient.Color = RainbowColors
	Gradient.Parent = Object

	return Gradient
end

