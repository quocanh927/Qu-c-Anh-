--==============================================================
-- FIX LAG
--==============================================================

local FixLag = {}

do
    local enabled = false
    local saved = {}
    local connection = nil

    local function saveAndSet(
        object,
        property,
        value
    )

        local ok, old = pcall(function()
            return object[property]
        end)

        if not ok then
            return
        end

        saved[#saved + 1] = {
            object,
            property,
            old
        }

        pcall(function()
            object[property] = value
        end)
    end


    local function process(object)

        if not object
            or not object.Parent then
            return
        end

        -- Part
        if object:IsA("BasePart") then

            if object.Material
                ~= Enum.Material.SmoothPlastic then

                saveAndSet(
                    object,
                    "Material",
                    Enum.Material.SmoothPlastic
                )
            end

            if object.CastShadow then

                saveAndSet(
                    object,
                    "CastShadow",
                    false
                )
            end

            if object.Reflectance > 0 then

                saveAndSet(
                    object,
                    "Reflectance",
                    0
                )
            end
        end


        -- Particle / Effect
        if object:IsA("ParticleEmitter")
            or object:IsA("Trail")
            or object:IsA("Smoke")
            or object:IsA("Fire")
            or object:IsA("Sparkles") then

            if object.Enabled then

                saveAndSet(
                    object,
                    "Enabled",
                    false
                )
            end
        end


        -- Decal / Texture
        if object:IsA("Decal")
            or object:IsA("Texture") then

            if object.Transparency < 1 then

                saveAndSet(
                    object,
                    "Transparency",
                    1
                )
            end
        end
    end


    function FixLag.SetEnabled(value)

        if enabled == value then
            return
        end

        enabled = value

        if enabled then

            pcall(function()
                settings()
                    .Rendering
                    .QualityLevel =
                    Enum.QualityLevel.Level01
            end)

            saveAndSet(
                Lighting,
                "GlobalShadows",
                false
            )

            saveAndSet(
                Lighting,
                "EnvironmentDiffuseScale",
                0
            )

            saveAndSet(
                Lighting,
                "EnvironmentSpecularScale",
                0
            )


            -- Tắt PostEffect
            for _, effect in ipairs(
                Lighting:GetChildren()
            ) do

                if effect:IsA("PostEffect")
                    and effect.Enabled then

                    saveAndSet(
                        effect,
                        "Enabled",
                        false
                    )
                end
            end


            -- Xử lý map
            local count = 0

            for _, object in ipairs(
                workspace:GetDescendants()
            ) do

                process(object)

                count += 1

                if count % 300 == 0 then
                    task.wait()
                end
            end


            -- Xử lý object mới
            connection =
                workspace.DescendantAdded:Connect(
                    function(object)

                        if not enabled then
                            return
                        end

                        task.defer(function()

                            if enabled then
                                process(object)
                            end

                        end)
                    end
                )

        else

            if connection then
                connection:Disconnect()
                connection = nil
            end


            -- Khôi phục
            for i = #saved, 1, -1 do

                local record = saved[i]

                pcall(function()
                    record[1][record[2]] =
                        record[3]
                end)
            end

            table.clear(saved)


            pcall(function()
                settings()
                    .Rendering
                    .QualityLevel =
                    Enum.QualityLevel.Automatic
            end)
        end
    end
end


