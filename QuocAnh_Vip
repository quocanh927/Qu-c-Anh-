local menuTweening = false

local function setMenuVisible(value)

    if menuTweening then
        return
    end

    State.MenuOpen = value

    if value then

        menuTweening = true

        root.Visible = true

        root.Position = UDim2.new(
            0.5,
            0,
            0.5,
            15
        )

        root.BackgroundTransparency = 0

        tween(
            root,
            0.22,
            {
                Position = UDim2.fromScale(
                    0.5,
                    0.5
                )
            },
            Enum.EasingStyle.Back
        )

        task.delay(
            0.23,
            function()
                menuTweening = false
            end
        )

    else

        menuTweening = true

        local animation = tween(
            root,
            0.18,
            {
                Position = UDim2.new(
                    0.5,
                    0,
                    0.5,
                    15
                )
            }
        )

        animation.Completed:Connect(function()

            if not State.MenuOpen then
                root.Visible = false
            end

            menuTweening = false
        end)
    end
end

