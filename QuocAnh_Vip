        Size = UDim2.fromScale(
            1,
            1
        ),

        Font =
            Enum.Font.GothamBold,

        Text =
            opts.icon or "•",

        TextSize = 15,

        TextColor3 =
            THEME.Text,
    })

    -- Title
    new("TextLabel", {

        Parent = head,

        BackgroundTransparency = 1,

        Position = UDim2.new(
            0,
            51,
            0,
            10
        ),

        Size = UDim2.new(
            1,
            -120,
            0,
            16
        ),

        Font =
            Enum.Font.GothamBold,

        Text =
            opts.title or "Feature",

        TextSize = 13,

        TextColor3 =
            THEME.Text,

        TextXAlignment =
            Enum.TextXAlignment.Left,
    })

    -- Description
    new("TextLabel", {

        Parent = head,

        BackgroundTransparency = 1,

        Position = UDim2.new(
            0,
            51,
            0,
            27
        ),

        Size = UDim2.new(
            1,
            -120,
            0,
            13
        ),

