local function CreateToggle(Parent,Text,Y)

	local Label = Instance.new("TextLabel")
	Label.Size = UDim2.new(1,-60,0,25)
	Label.Position = UDim2.fromOffset(12,Y)
	Label.BackgroundTransparency = 1
	Label.Text = Text
