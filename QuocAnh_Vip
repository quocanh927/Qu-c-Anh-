--==============================================================
-- MENU OPEN / CLOSE ANIMATION
--==============================================================

local menuAnimating = false

local function showMenu()

    if menuAnimating then
        return
    end

    menuAnimating = true

    State.MenuOpen = true

    root.Visible = true

    uiScale.Scale =
        baseScale * 0.82

    main.BackgroundTransparency =
        1

    tween(
        uiScale,
        0.22,
        {
            Scale = baseScale
        },
        Enum.EasingStyle.Back
    )

    tween(
        main,
        0.18,
        {
            BackgroundTransparency = 0
        }
    )

    task.delay(
        0.23,
        function()
            menuAnimating = false
        end
    )
end


local function hideMenu()

    if menuAnimating then
        return
    end

    menuAnimating = true

    State.MenuOpen = false

    tween(
        uiScale,
        0.18,
        {
            Scale = baseScale * 0.82
        },
        Enum.EasingStyle.Quad
    )

    tween(
        main,
        0.15,
        {
            BackgroundTransparency = 1
        }
    )

    task.delay(
        0.17,
        function()

            root.Visible = false

            main.BackgroundTransparency =
                0

            uiScale.Scale =
                baseScale

            menuAnimating = false
        end
    )
end


