local frames = 0
local fpsTime = os.clock()

RunService.RenderStepped:Connect(
    function()

        frames += 1

        local now =
            os.clock()

        if now - fpsTime >= 1 then

            local fps =
                math.floor(
                    frames /
                    (now - fpsTime)
                )

            fpsLabel.Text =
                tostring(fps)
                .. " FPS"

            frames = 0
            fpsTime = now
        end
    end
)


