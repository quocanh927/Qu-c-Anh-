            Enum.Font.Gotham,

        Text =
            opts.desc or "",

        TextSize = 10.5,

        TextColor3 =
            THEME.Dim,

        TextXAlignment =
            Enum.TextXAlignment.Left,

        TextTruncate =
            Enum.TextTruncate.AtEnd,
    })

    -- Các control nằm dưới feature
    local extras = {}

    local function setActive(enabled)

        tween(
            activeBar,
            0.18,
            {
                BackgroundTransparency =
                    enabled and 0 or 1
            }
        )

        tween(
            cardStroke,
            0.18,
            {
                Color =
                    enabled
                    and (
                        opts.color
                        or THEME.Accent
                    )
                    or THEME.Stroke
            }
        )

        tween(
            iconBox,
            0.18,
            {
                BackgroundTransparency =
                    enabled
                    and 0.72
                    or 0.87
            }
        )

        for _, extra in ipairs(extras) do
            extra.Visible = enabled
        end
    end

    -- Switch
    local switch = makeSwitch(
        head,
        function(enabled)

            setActive(enabled)

            if opts.onToggle then
                opts.onToggle(enabled)
            end
        end
    )

    switches[
        opts.id or opts.title or tostring(rowOrder)
    ] = switch

    -- Slider
    if opts.slider then

        opts.slider.order = 2

        opts.slider.visible = false

        local slider =
            makeSlider(
                card,
                opts.slider
            )

        extras[#extras + 1] =
            slider.Holder
    end

    -- Các thành phần phụ khác
    if opts.build then
        opts.build(card)
    end

    local api = {
        Card = card,
        Switch = switch,
    }

    function api.Set(value, silent)

        switch.Set(
            value,
            silent
        )

        if silent then
            setActive(
                value
            )
        end
    end

    function api.Get()
        return switch.Get()
    end

    return api
end

