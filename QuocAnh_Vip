local function makeSwitch(parent, onChange)

    local button = new("TextButton", {
        Parent = parent,

        AutoButtonColor = false,

        AnchorPoint = Vector2.new(1, 0.5),

        Position = UDim2.new(
            1, -12,
            0.5, 0
        ),

        Size = UDim2.fromOffset(
            44,
            23
        ),

        BackgroundColor3 = THEME.Off,

        BorderSizePixel = 0,

        Text = "",
    })

    corner(button, 20)

    local glowStroke = new("UIStroke", {
        Parent = button,

        Color = THEME.Accent,

        Thickness = 1.5,

        Transparency = 1,
    })

    local knob = new("Frame", {
        Parent = button,

        Size = UDim2.fromOffset(
            17,
            17
        ),

        Position = UDim2.new(
            0,
            3,
            0.5,
            -8.5
        ),

        BackgroundColor3 = Color3.fromRGB(
            246,
            248,
            252
        ),

        BorderSizePixel = 0,
    })

    corner(knob, 20)

    local enabled = false

    local function render(animate)

        local duration = animate and 0.16 or 0

        tween(
            button,
            duration,
            {
                BackgroundColor3 =
                    enabled
                    and THEME.Accent
                    or THEME.Off
            }
        )

        tween(
            glowStroke,
            duration,
            {
                Transparency =
                    enabled
                    and 0.55
                    or 1
            }
        )

        tween(
            knob,
            duration,
            {
                Position =
                    enabled
                    and UDim2.new(
                        1,
                        -20,
                        0.5,
                        -8.5
                    )
                    or UDim2.new(
                        0,
                        3,
                        0.5,
                        -8.5
                    )
            },
            Enum.EasingStyle.Back
        )
    end

    local api = {}

    function api.Set(value, silent)

        value = value == true

        if enabled == value then
            return
        end

        enabled = value

        render(true)

        if not silent and onChange then
            onChange(enabled)
        end
    end

    function api.Get()
        return enabled
    end

    button.MouseButton1Click:Connect(function()

        api.Set(
            not enabled
        )
    end)

    render(false)

    return api
end

