        entries[model] =
            entry


        -- Cập nhật máu
        local healthConnection =
            humanoid.HealthChanged:Connect(
                function(health)

                    if entry.info
                        and entry.info.Parent then

                        entry.info.Text =
                            string.format(
                                "HP: %d / %d",
                                math.max(
                                    0,
                                    math.floor(
                                        health
                                    )
                                ),
                                math.floor(
                                    humanoid.MaxHealth
                                )
                            )
                    end

                    if health <= 0 then
                        task.defer(function()

                            if entries[model] then

                                if entry.highlight then
                                    entry.highlight:Destroy()
                                end

                                if entry.billboard then
                                    entry.billboard:Destroy()
                                end

                                entries[model] =
                                    nil
                            end
                        end)
                    end
                end
            )

        table.insert(
            connections[kind],
            healthConnection
        )
    end


    function ESP.EnablePlayers()

        clearKind("player")

        for _, player in ipairs(
            Players:GetPlayers()
        ) do

            if player ~= LocalPlayer
                and player.Character then

                add(
                    player.Character,
                    "player"
                )
            end

            local connection =
                player.CharacterAdded:Connect(
                    function(character)

                        task.wait(0.25)

                        if State.EspPlayer then
                            add(
                                character,
                                "player"
                            )
                        end
                    end
                )

            table.insert(
                connections.player,
                connection
            )
        end
    end


    function ESP.EnableMobs()

        clearKind("mob")

        for _, mob in ipairs(
            MobUtil.list()
        ) do

            if mob.model
                and mob.hum
                and mob.hum.Health > 0 then

                add(
                    mob.model,
                    "mob"
                )
            end
        end
    end


    function ESP.DisablePlayers()
        clearKind("player")
    end


    function ESP.DisableMobs()
        clearKind("mob")
    end


    function ESP.Refresh()

        if State.EspPlayer then
            ESP.EnablePlayers()
        end

        if State.EspMob then
            ESP.EnableMobs()
        end
    end
end


