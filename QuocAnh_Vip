--==============================================================

local function applyCharacterSettings(character)

    local humanoid =
        character:WaitForChild(
            "Humanoid",
            5
        )

    if not humanoid then
        return
    end

    -- Lưu thông số gốc mới
    baseStats.WalkSpeed =
        humanoid.WalkSpeed

    baseStats.JumpPower =
        humanoid.JumpPower

    baseStats.JumpHeight =
        humanoid.JumpHeight


    -- Speed
    if State.Speed then

        humanoid.WalkSpeed =
            State.SpeedValue
    end


    -- Jump Boost
    if State.JumpBoost then

        humanoid.UseJumpPower =
            true

        humanoid.JumpPower =
            State.JumpValue
    end


    -- ESP Player
    if State.EspPlayer then

        task.delay(
            0.3,
            function()

                if ESP
                    and ESP.EnablePlayers then

                    ESP.EnablePlayers()
                end

            end
        )
    end


    -- Hitbox không áp dụng cho chính mình
    -- nên không thay đổi character của LocalPlayer.
end


